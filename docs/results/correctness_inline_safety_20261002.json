  "fixes": [
    "Mandatory AArch32 callee inlining safety even with --force-inline, including CFI and function-owned metadata",
    "Recognize implicit-LR ARM BX_RET and explicit-LR Thumb tBX as side-effect-free unconditional returns"
  ],
