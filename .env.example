# Copy to .env and export before running scripts:
#   set -a; . ./.env; set +a
# Every value below is read from the environment; nothing sources .env for you.

# RunPod (optional — for remote toolchain builds)
RUNPOD_API_KEY=
POD_NAME=llvm-bolt-builder
CPU_FLAVOR=cpu5m
VCPU_COUNT=8
# CPU pods cap the container disk at 20 GB; the build tree goes on the network volume.
CONTAINER_DISK_GB=20
IMAGE=runpod/base:1.0.2-ubuntu2404
DATA_CENTER=EU-RO-1
# Existing volume with all builds (see docs/RESUME.md)
NETWORK_VOLUME_ID=j1d9e6wq5l
VOLUME_MOUNT_PATH=/workspace
# Current pod: ddib0g7kwvdk33 (2 vCPU, volume attached). Recreate: ./scripts/create-pod.sh

# SSH public key contents for RunPod pod access
SSH_PUBLIC_KEY=

# This repo builds the ARM32 BOLT backend against TWO LLVM forks side by
# side (see scripts/resolve-base.sh): BASE=upstream (llvm/llvm-project,
# the actual upstreaming target) and BASE=atfe (arm/arm-toolchain's
# arm-software branch — Arm's own actively-synced integration branch).
# Each gets its own checkout (third_party/llvm-project-$BASE/), build dir
# (build-$BASE/), and patch set (overlay/llvm/patches/$BASE/). Scripts
# default to BASE=upstream when unset; pass BASE=atfe to target the other.
#
# The two pins below are independent — bumping one does not require
# bumping the other. Neither tracks a moving branch. Bump deliberately,
# re-verify after (both docs/RESUME.md and docs/KNOWN_LIMITATIONS.md
# record what each pin was last verified against).
BASE=upstream

# BASE=upstream
LLVM_COMMIT_UPSTREAM=069ef0e7cb36ee1fcf3bfdad31533fd79ab85b58

# BASE=atfe — arm-software has *diverged* from the upstream commit above
# (not an ancestor of it); the two patch sets are maintained independently
# for exactly that reason. Verified: full P0-P10 ARM32 BOLT backend ladder
# builds and passes verify-bolt-arm32-milestones.sh / verify-bolt-arm32-veneer.sh
# / verify-bolt-workloads.sh (ARCH=arm32) against it.
LLVM_REMOTE_ATFE=https://github.com/arm/arm-toolchain.git
LLVM_COMMIT_ATFE=bcc08884995ff3cbee70749524621803b9bd258a

# LK is unaffected by which LLVM base is selected — one checkout, one pin,
# shared by both.
LK_COMMIT=79d2f56096fa32365846ceaba8b4a9d1c6b75cf0

# LK project target — arm32 is this repo's verified ARM backend scope;
# arm64 exercises LK's existing AArch64 BOLT path instead.
LK_PROJECT=qemu-virt-arm32-test

# QEMU — cortex-a15 for arm32 (LK_PROJECT above); use cortex-a53 with
# qemu-virt-arm64-test for the AArch64 path.
QEMU_MACHINE=virt
QEMU_CPU=cortex-a15
