# Copy to .env and export before running scripts:
#   set -a; . ./.env; set +a
# Every value below is read from the environment; nothing sources .env for you.

# RunPod (optional — for remote toolchain builds)
RUNPOD_API_KEY=
POD_NAME=llvm-bolt-builder
CPU_FLAVOR=cpu5m
VCPU_COUNT=8
# CPU pods cap the container disk at 20 GB; the build tree goes on the network volume.
CONTAINER_DISK_GB=20
IMAGE=runpod/base:1.0.2-ubuntu2404
DATA_CENTER=EU-RO-1
NETWORK_VOLUME_ID=
VOLUME_MOUNT_PATH=/workspace

# SSH public key contents for RunPod pod access
SSH_PUBLIC_KEY=

# Upstream branches checked out into third_party/
LLVM_BRANCH=release/23.x
LK_BRANCH=master

# LK project target
LK_PROJECT=qemu-virt-arm64-test

# QEMU
QEMU_MACHINE=virt
QEMU_CPU=cortex-a53
