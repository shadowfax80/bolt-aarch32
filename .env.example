# RunPod (optional — for remote toolchain builds)
RUNPOD_API_KEY=
POD_NAME=llvm-bolt-builder
VCPU_COUNT=16
CONTAINER_DISK_GB=150

# SSH public key contents for RunPod pod access
SSH_PUBLIC_KEY=

# LLVM branch/tag to pin in third_party/llvm-project submodule
LLVM_BRANCH=release/19.x

# LK project target
LK_PROJECT=qemu-virt-arm64-test

# QEMU
QEMU_MACHINE=virt
QEMU_CPU=cortex-a53
