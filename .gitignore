# Build outputs (build/ kept for any pre-merge checkout; build-upstream/
# and build-atfe/ are what scripts/resolve-base.sh actually names now)
build/
build-*/
out/
*.o
*.elf
*.bin
*.fdata
*.tar.gz

# Upstream checkouts (populated by scripts/fetch-sources.sh). Same
# before/after-merge note as above: third_party/llvm-project/ predates the
# BASE=upstream|atfe split; third_party/llvm-project-*/ is current.
third_party/llvm-project/
third_party/llvm-project-*/
third_party/lk/

# Local secrets
.env
.runpod-pod-id

# Python
__pycache__/
*.py[cod]

# Local scratch (pod export helpers; not overlay source)
tmp-arm-backend/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
