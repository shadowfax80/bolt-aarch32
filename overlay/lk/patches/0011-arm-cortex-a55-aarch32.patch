diff --git a/arch/arm/include/arch/arm/cores.h b/arch/arm/include/arch/arm/cores.h
--- a/arch/arm/include/arch/arm/cores.h
+++ b/arch/arm/include/arch/arm/cores.h
@@ -34,7 +34,12 @@
 #if defined(__ARM_ARCH_8R__)
 #define ARM_ARCH_8R 1
 #endif
-#if defined(__ARM_ARCH_8A__) || defined(ARM_ARCH_8R)
+/* bolt-aarch32: clang names ARMv8.x-A (e.g. Cortex-A55, v8.2-A) as
+ * __ARM_ARCH_8_xA__ rather than __ARM_ARCH_8A__; treat every A-profile v8.x
+ * as ARMv8-A. */
+#if defined(__ARM_ARCH_8A__) || defined(ARM_ARCH_8R) || \
+    (defined(__ARM_ARCH) && __ARM_ARCH >= 8 && defined(__ARM_ARCH_PROFILE) && \
+     __ARM_ARCH_PROFILE == 'A')
 #define ARM_ARCH_8A 1
 #endif
 #if defined(__ARM_ARCH_8__) || defined(ARM_ARCH_8A) || defined(ARM_ARCH_8M)
diff --git a/platform/bcm28xx/rules.mk b/platform/bcm28xx/rules.mk
--- a/platform/bcm28xx/rules.mk
+++ b/platform/bcm28xx/rules.mk
@@ -68,7 +68,11 @@
 
 else ifeq ($(TARGET),rpi4)
 ARCH := arm
-ARM_CPU := cortex-a15
+# bolt-aarch32: RPI4_ARM_CPU=cortex-a55 builds the image as the PoC target's
+# core (AArch32, ARMv8.2-A); the A72 executes the v8.0 subset of that code.
+# Default stays cortex-a15 so existing fixtures rebuild unchanged.
+RPI4_ARM_CPU ?= cortex-a15
+ARM_CPU := $(RPI4_ARM_CPU)
 
