diff --git a/arch/arm/rules.mk b/arch/arm/rules.mk
--- a/arch/arm/rules.mk
+++ b/arch/arm/rules.mk
@@ -170,6 +170,25 @@
 else
 GLOBAL_DEFINES += WITH_NO_FP=1
 endif
+HANDLED_CORE := true
+endif
+# bolt-aarch32: Cortex-A55 (ARMv8.2-A) in AArch32 state, the PoC target. LK's
+# ARMv7-A code paths (CP15 caches/TLB/MMU, Thumb-2) are architecturally valid
+# in AArch32 on ARMv8-A, so the v7-A defines apply. Firmware may enter in Hyp
+# (the Pi does), so keep the HYP->SVC drop. The target has no FPU/NEON.
+ifeq ($(ARM_CPU),cortex-a55)
+GLOBAL_DEFINES += \
+	ARM_WITH_CP15=1 \
+	ARCH_HAS_MMU=1 \
+	ARM_ISA_ARMv7=1 \
+	ARM_ISA_ARMv7A=1 \
+	ARM_ISA_ARMv8=1 \
+	ARM_WITH_THUMB=1 \
+	ARM_WITH_THUMB2=1 \
+	ARM_WITH_CACHE=1 \
+	ARM_WITH_L2=1 \
+	ARM_WITH_HYP=1 \
+	WITH_NO_FP=1
 HANDLED_CORE := true
 endif
 ifeq ($(ARM_CPU),cortex-a8)
diff --git a/arch/arm/toolchain.mk b/arch/arm/toolchain.mk
--- a/arch/arm/toolchain.mk
+++ b/arch/arm/toolchain.mk
@@ -114,6 +114,11 @@
 ARCH_arm_COMPILEFLAGS += -mcpu=$(ARM_CPU)
 ARCH_arm_COMPILEFLAGS_FLOAT += -mfpu=neon -mfloat-abi=softfp
 endif
+# bolt-aarch32: no FPU/NEON on the target, so float modules get no FP unit either.
+ifeq ($(ARM_CPU),cortex-a55)
+ARCH_arm_COMPILEFLAGS += -mcpu=$(ARM_CPU) -mfpu=none
+ARCH_arm_COMPILEFLAGS_FLOAT += -mfpu=none
+endif
 ifeq ($(ARM_CPU),arm1136j-s)
 ARCH_arm_COMPILEFLAGS += -mcpu=$(ARM_CPU)
 endif
