@@ -11,6 +11,8 @@
 #include "bolt/Core/BinaryData.h"
 #include "bolt/Core/BinarySection.h"
 #include "llvm/ExecutionEngine/JITLink/ELF_riscv.h"
+#include "llvm/ExecutionEngine/JITLink/aarch32.h"
+#include "bolt/Core/BinaryFunction.h"
 #include "llvm/ExecutionEngine/JITLink/JITLink.h"
 #include "llvm/ExecutionEngine/Orc/Shared/ExecutorAddress.h"
 #include "llvm/ExecutionEngine/Orc/Shared/ExecutorSymbolDef.h"
@@ -108,6 +110,50 @@ struct JITLinkLinker::Context : jitlink::JITLinkContext {
           jitlink::createRelaxationPass_ELF_riscv());
     }
 
+    // BOLT disables default target passes (DWARF conflict), but aarch32 needs
+    // StubsManager for Thumb_Jump24 <-> ARM interworking (and long-range stubs).
+    if (G.getTargetTriple().isARM() || G.getTargetTriple().isThumb()) {
+      Config.PrePrunePasses.push_back([&](jitlink::LinkGraph &LG) -> Error {
+        auto markIfThumb = [&](jitlink::Symbol *S) {
+          if (!S->hasName())
+            return;
+          const std::string Name = (*S->getName()).str();
+          for (auto &KV : Linker.BC.getBinaryFunctions()) {
+            BinaryFunction &BF = KV.second;
+            if (BF.isARMThumb() && BF.hasName(Name)) {
+              S->setTargetFlags(S->getTargetFlags() |
+                                jitlink::aarch32::ThumbSymbol);
+              return;
+            }
+          }
+        };
+        for (jitlink::Symbol *S : LG.defined_symbols())
+          markIfThumb(S);
+        for (jitlink::Symbol *S : LG.external_symbols())
+          markIfThumb(S);
+
+        // Local labels in a Thumb function body share the function's block but
+        // are not STT_FUNC; propagate ThumbSymbol so Jump24 does not spuriously
+        // demand an interworking stub.
+        for (jitlink::Symbol *S : LG.defined_symbols()) {
+          if (!(S->getTargetFlags() & jitlink::aarch32::ThumbSymbol))
+            continue;
+          jitlink::Block &B = S->getBlock();
+          for (jitlink::Symbol *O : LG.defined_symbols()) {
+            if (&O->getBlock() == &B)
+              O->setTargetFlags(O->getTargetFlags() |
+                                jitlink::aarch32::ThumbSymbol);
+          }
+        }
+        return Error::success();
+      });
+      Config.PostPrunePasses.push_back([](jitlink::LinkGraph &LG) -> Error {
+        jitlink::aarch32::StubsManager_v7 Stubs;
+        jitlink::visitExistingEdges(LG, Stubs);
+        return Error::success();
+      });
+    }
+
     return Error::success();
   }
 
