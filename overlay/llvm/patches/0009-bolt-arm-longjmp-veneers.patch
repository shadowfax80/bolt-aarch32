diff --git a/bolt/lib/Passes/VeneerElimination.cpp b/bolt/lib/Passes/VeneerElimination.cpp
index 9037390d06a4..d367944fb852 100644
--- a/bolt/lib/Passes/VeneerElimination.cpp
+++ b/bolt/lib/Passes/VeneerElimination.cpp
@@ -36,7 +36,7 @@ namespace llvm {
 namespace bolt {
 
 Error VeneerElimination::runOnFunctions(BinaryContext &BC) {
-  if (!opts::EliminateVeneers || !BC.isAArch64())
+  if (!opts::EliminateVeneers || !(BC.isAArch64() || BC.isARM()))
     return Error::success();
 
   std::unordered_map<const MCSymbol *, const MCSymbol *> VeneerDestinations;
@@ -176,7 +176,9 @@ Error VeneerElimination::runOnFunctions(BinaryContext &BC) {
         if (!BC.MIB->isCall(Instr) || BC.MIB->isIndirectCall(Instr))
           continue;
 
-        const MCSymbol *TargetSymbol = BC.MIB->getTargetSymbol(Instr, 0);
+        const MCSymbol *TargetSymbol = BC.MIB->getTargetSymbol(Instr);
+        if (!TargetSymbol)
+          continue;
         auto It = VeneerDestinations.find(TargetSymbol);
         if (It == VeneerDestinations.end())
           continue;
@@ -191,6 +193,56 @@ Error VeneerElimination::runOnFunctions(BinaryContext &BC) {
       dbgs() << "BOLT-INFO: number of linker-inserted veneers call sites: "
              << VeneerCallers << "\n");
   (void)VeneerCallers;
+
+  // P8/P9 early pass: BL↔BLX and cross-mode tail B→BX (best-effort; targets
+  // may still be veneer symbols here — BinaryEmitter repeats this late).
+  if (BC.isARM()) {
+    for (BinaryFunction &BF :
+         llvm::make_second_range(BC.getBinaryFunctions())) {
+      if (!BF.isSimple() || BF.isIgnored())
+        continue;
+      // BC.isARM() is already guaranteed by the enclosing `if` above.
+      MCPlusBuilder *MIB = BC.getMIBFor(BF.isARMThumb());
+      for (BinaryBasicBlock &BB : BF) {
+        for (auto II = BB.begin(); II != BB.end();) {
+          MCInst &Instr = *II;
+          const MCSymbol *TSym = MIB->getTargetSymbol(Instr);
+          BinaryFunction *Tgt =
+              TSym ? BC.getFunctionForSymbol(TSym) : nullptr;
+          if (!Tgt) {
+            ++II;
+            continue;
+          }
+          const bool DstThumb = Tgt->isARMThumb();
+          const bool Cross = BF.isARMThumb() != DstThumb;
+          const bool DirectBr =
+              MIB->isBranch(Instr) && !MIB->isConditionalBranch(Instr) &&
+              !MIB->isIndirectBranch(Instr);
+          const bool TailLike = MIB->isTailCall(Instr) &&
+                                !MIB->isIndirectCall(Instr) &&
+                                !MIB->isIndirectBranch(Instr);
+          if (Cross && (DirectBr || TailLike) &&
+              !(MIB->isCall(Instr) && !MIB->isTailCall(Instr))) {
+            InstructionListType Seq;
+            MIB->createShortJmp(Seq, TSym, BC.Ctx.get(),
+                                   /*IsTailCall=*/true);
+            II = BB.replaceInstruction(II, Seq);
+            II = std::next(II, static_cast<std::ptrdiff_t>(Seq.size()));
+            continue;
+          }
+          if (MIB->isCall(Instr) && !MIB->isIndirectCall(Instr) &&
+              !MIB->isTailCall(Instr)) {
+            MIB->adjustCallForTargetMode(Instr, BF.isARMThumb(), DstThumb,
+                                            BC.Ctx.get());
+            ++II;
+            continue;
+          }
+          ++II;
+        }
+      }
+    }
+  }
+
   return Error::success();
 }
 
