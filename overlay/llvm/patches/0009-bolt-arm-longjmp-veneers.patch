@@ -384,7 +384,9 @@ Error BinaryFunctionPassManager::runAllPasses(BinaryContext &BC) {
 
   if (BC.isAArch64()) {
     Manager.registerPass(std::make_unique<FixRelaxations>(PrintFixRelaxations));
