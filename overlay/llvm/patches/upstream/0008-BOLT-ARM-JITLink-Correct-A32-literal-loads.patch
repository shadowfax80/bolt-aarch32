index 000000000..2a71209f6
--- /dev/null
+++ b/llvm/test/ExecutionEngine/JITLink/AArch32/ELF_ldr_pcrel_arm_range.s
@@ -0,0 +1,17 @@
+# RUN: llvm-mc -triple=armv7-linux-gnueabi -arm-add-build-attributes -filetype=obj -o %t.o %s
+# RUN: llvm-jitlink -noexec -slab-address 0x100000 -slab-allocate 10Kb -slab-page-size 4096 -abs target=0x101007 -check %s %t.o
+# RUN: llvm-jitlink -noexec -slab-address 0x100000 -slab-allocate 10Kb -slab-page-size 4096 -abs target=0xff009 -check %s %t.o
+# RUN: llvm-jitlink -noexec -slab-address 0x100000 -slab-allocate 10Kb -slab-page-size 4096 -abs target=0x100008 -check %s %t.o
+# RUN: not llvm-jitlink -noexec -slab-address 0x100000 -slab-allocate 10Kb -slab-page-size 4096 -abs target=0x101008 %t.o 2>&1 | FileCheck %s
+# RUN: not llvm-jitlink -noexec -slab-address 0x100000 -slab-allocate 10Kb -slab-page-size 4096 -abs target=0xff008 %t.o 2>&1 | FileCheck %s
+# CHECK: out of range
+# jitlink-check: decode_operand(main, 2) = (target - main - 8)[31:0]
+        .syntax unified
+        .arm
+        .text
+        .globl main
+        .type main, %function
+main:
+        ldr r0, target
+        bx lr
+        .size main, .-main
