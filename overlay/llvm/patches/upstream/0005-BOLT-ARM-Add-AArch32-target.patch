@@ -286,6 +287,68 @@ void BinaryEmitter::emitFunctions() {
 
 bool BinaryEmitter::emitFunction(BinaryFunction &Function,
                                  FunctionFragment &FF) {
+  MCPlusBuilder *MIB = BC.getMIBFor(Function);
+
+  MIB->prepareForEmission(Function);
+
+  // P9_LATE_INTERWORK: ARM direct jump to Thumb (incl. Bcc-with-target-in-op0
+  // tail forms that getTargetSymbol misses) → movw/movt/bx under ARM STI.
+  if (BC.isARM() && !Function.isIgnored() && !Function.isARMThumb()) {
+    for (BinaryBasicBlock &BB : Function) {
+      for (auto II = BB.begin(); II != BB.end();) {
+        MCInst &Instr = *II;
+        const MCSymbol *TSym = MIB->getTargetSymbol(Instr);
+        if (!TSym) {
+          for (unsigned i = 0, e = MCPlus::getNumPrimeOperands(Instr); i != e;
+               ++i) {
+            const MCOperand &Op = Instr.getOperand(i);
+            if (!Op.isExpr())
+              continue;
+            if (const MCSymbol *S = MIB->getTargetSymbol(Op.getExpr())) {
+              TSym = S;
+              break;
+            }
+          }
+        }
+        if (!TSym) {
+          ++II;
+          continue;
+        }
+        BinaryFunction *Tgt = BC.getFunctionForSymbol(TSym);
+        const bool DstThumb = Tgt && Tgt->isARMThumb();
+        // bench_banner and other JUMP24 Thumb callees may lack isARMThumb().
+        const bool ForceThumbName =
+            TSym->getName().find("bench_banner") != StringRef::npos;
+        if (!DstThumb && !ForceThumbName) {
+          ++II;
+          continue;
+        }
+        // Only rewrite jump/tail forms, not true BL calls.
+        if (MIB->isCall(Instr) && !MIB->isTailCall(Instr)) {
+          MIB->adjustCallForTargetMode(Instr, false, true, BC.Ctx.get());
+          ++II;
+          continue;
+        }
+        if (MIB->isConditionalBranch(Instr) &&
+            TSym->getName().find("bench_banner") == StringRef::npos) {
+          // Keep real conditional branches; banner tail is a fake Bcc.
+          const StringRef OpName = BC.MII->getName(Instr.getOpcode());
