@@ -0,0 +1,20 @@
+	.syntax unified
+	.thumb
+	.text
+	.global _start
+	.type _start, %function
+_start:
+	@ POP {..., pc} is the standard epilogue for any function that spills
+	@ callee-saved registers across a call -- exercises isReturn()
+	@ correctly recognizing it (only BX lr / MOVPCLR were recognized
+	@ before this fix).
+	push {r4, r5, lr}
+	movs r4, #1
+	movs r5, #2
+	bl callee
+	adds r0, r4, r5
+	pop {r4, r5, pc}
+
+	.type callee, %function
+callee:
+	bx lr
diff --git a/bolt/test/ARM/Inputs/arm32-thumb-switch.s b/bolt/test/ARM/Inputs/arm32-thumb-switch.s
new file mode 100644
index 000000000000..bad46e4c9156
--- /dev/null
+++ b/bolt/test/ARM/Inputs/arm32-thumb-switch.s
@@ -0,0 +1,30 @@
+	.syntax unified
+	.thumb
+	.text
+	.global _start
+	.type _start, %function
+_start:
+	@ Dense 4-way switch forces a real Thumb-2 TBB (table-branch-byte)
+	@ dispatch -- exercises isIndirectBranch() correctly recognizing TBB
+	@ as an indirect branch rather than silently falling through into
+	@ its own jump table.
+	and r1, r0, #3
+	tbb [pc, r1]
+.LJTI0_0:
+	.byte (.Lcase0-.LJTI0_0)/2
+	.byte (.Lcase1-.LJTI0_0)/2
+	.byte (.Lcase2-.LJTI0_0)/2
+	.byte (.Lcase3-.LJTI0_0)/2
+	.p2align 1
+.Lcase0:
+	movs r0, #10
+	bx lr
+.Lcase1:
+	movs r0, #20
+	bx lr
+.Lcase2:
+	movs r0, #30
+	bx lr
+.Lcase3:
+	movs r0, #40
+	bx lr
