new file mode 100644
index 000000000000..5a1045483c11
--- /dev/null
+++ b/bolt/lib/Target/ARM/ARMMCPlusBuilder.cpp
@@ -0,0 +1,1244 @@
+//===- bolt/Target/ARM/ARMMCPlusBuilder.cpp ---------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file provides ARM/AArch32-specific MCPlus builder.
+//
+//===----------------------------------------------------------------------===//
+
+#include "ARMMCSymbolizer.h"
+#include "MCTargetDesc/ARMBaseInfo.h"
+#include "MCTargetDesc/ARMMCAsmInfo.h"
+#include "MCTargetDesc/ARMMCTargetDesc.h"
+#include "MCTargetDesc/ARMFixupKinds.h"
+#include "bolt/Core/BinaryContext.h"
+#include "bolt/Core/BinaryFunction.h"
+#include "bolt/Core/MCPlusBuilder.h"
+#include "llvm/ADT/bit.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/MCInstBuilder.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/Support/ErrorHandling.h"
+#include <algorithm>
+
+#define DEBUG_TYPE "mcplus"
+
+using namespace llvm;
+using namespace bolt;
+
+namespace {
+
+bool isThumbMode(const MCSubtargetInfo *STI) {
+  return STI->hasFeature(ARM::ModeThumb);
+}
+
+bool isITOpcode(unsigned Opcode) { return Opcode == ARM::t2IT; }
+
+class ARMMCPlusBuilder : public MCPlusBuilder {
+  bool InThumbMode() const { return isThumbMode(STI); }
+
+  bool isThumbInst(const MCInst &Inst) const {
+    const MCInstrDesc &Desc = Info->get(Inst.getOpcode());
+    if ((Desc.TSFlags & ARMII::FormMask) == ARMII::ThumbFrm)
+      return true;
+    switch (Inst.getOpcode()) {
+    default:
+      break;
+    case ARM::B:
+    case ARM::BL:
+    case ARM::Bcc:
+    case ARM::BX:
+    case ARM::BLX:
+    case ARM::BLX_pred:
+    case ARM::MOVr:
+    case ARM::LDRi12:
+    case ARM::STRi12:
+    case ARM::SUBri:
+    case ARM::ADDri:
+    case ARM::LDREX:
+    case ARM::STREX:
+    case ARM::TRAP:
+      return false;
+    }
+    return Desc.getSize() == 2;
+  }
+
+public:
+  using MCPlusBuilder::MCPlusBuilder;
+
+  std::unique_ptr<MCSymbolizer>
+  createTargetSymbolizer(BinaryFunction &Function,
+                         bool CreateNewSymbols) const override {
+    return std::make_unique<ARMMCSymbolizer>(Function, CreateNewSymbols);
+  }
+
+  MCPhysReg getStackPointer() const override { return ARM::SP; }
+  MCPhysReg getFramePointer() const override { return ARM::R11; }
+
+  bool isPrefix(const MCInst &Inst) const override {
+    return isITOpcode(Inst.getOpcode());
+  }
+
+  /// Number of body instructions governed by a Thumb-2 IT header (1..4).
+  /// MC PredBlockMask: lowest set bit ends the mask; size = 4 - tzcnt(mask).
+  /// Callers must move/skip/instrument the whole group {IT + body}, never a
+  /// subset (splitting or inserting inside is architecturally illegal).
+  static unsigned getITBlockSize(const MCInst &IT) {
+    assert(isITOpcode(IT.getOpcode()) && "not an IT header");
+    assert(IT.getNumOperands() >= 2 && IT.getOperand(1).isImm());
+    unsigned Mask = static_cast<unsigned>(IT.getOperand(1).getImm());
+    assert(Mask != 0 && "invalid empty IT mask");
+    unsigned NumTZ = llvm::countr_zero(Mask);
+    assert(NumTZ <= 3 && "invalid IT mask");
+    return 4u - NumTZ;
+  }
+
+  bool isITInstruction(const MCInst &Inst) const {
+    return isITOpcode(Inst.getOpcode());
+  }
+
+  bool isSafeToEncodeARM(const MCInst &Inst) const {
+    MCInst Clean(Inst);
+    stripAnnotations(Clean);
+    const MCInstrDesc &Desc = Info->get(Clean.getOpcode());
+    for (unsigned I = 0, E = Desc.getNumOperands(); I != E; ++I) {
+      if (I >= Clean.getNumOperands())
+        return false;
+      const MCOperandInfo &OI = Desc.operands()[I];
+      const MCOperand &Op = Clean.getOperand(I);
+      if (OI.OperandType == MCOI::OPERAND_REGISTER && !Op.isReg())
+        return false;
+    }
+    // Variadic GPR/VFP register lists (LDM/STM/VLDM/VSTM).
+    const unsigned Prime = MCPlus::getNumPrimeOperands(Clean);
+    for (unsigned I = Desc.getNumOperands(); I < Prime; ++I) {
+      if (!Clean.getOperand(I).isReg())
+        return false;
+    }
+    return true;
+  }
+
+  bool isUnsupportedInstruction(const MCInst &Inst) const override {
+    // P7: IT headers are first-class. isPrefix(IT) + getITBlockSize() keep
+    // the {IT, body...} group atomic for layout and (later) instrumentation.
+    if (!isSafeToEncodeARM(Inst))
+      return true;
+    return MCPlusBuilder::isUnsupportedInstruction(Inst);
+  }
+
+  bool shouldRecordCodeRelocation(uint32_t RelType) const override {
+    switch (RelType) {
+    default:
+      return false;
+    case ELF::R_ARM_CALL:
+    case ELF::R_ARM_JUMP24:
+    case ELF::R_ARM_THM_CALL:
+    case ELF::R_ARM_THM_JUMP24:
+    case ELF::R_ARM_ABS32:
+    case ELF::R_ARM_REL32:
+    case ELF::R_ARM_PC24:
+    case ELF::R_ARM_PLT32:
+    case ELF::R_ARM_PREL31:
+    case ELF::R_ARM_MOVW_ABS_NC:
+    case ELF::R_ARM_MOVT_ABS:
+      return true;
+    }
+  }
+
+  bool isNoop(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    default:
+      return false;
+    case ARM::MOVr:
+      if (Inst.getNumOperands() < 4)
+        return false;
+      return Inst.getOperand(0).isReg() && Inst.getOperand(1).isReg() &&
+             Inst.getOperand(0).getReg() == Inst.getOperand(1).getReg() &&
+             Inst.getOperand(2).isImm() && Inst.getOperand(2).getImm() == ARMCC::AL &&
+             Inst.getOperand(3).isReg() && Inst.getOperand(3).getReg() == 0;
+    case ARM::tMOVr:
+      if (Inst.getNumOperands() < 3)
+        return false;
+      return Inst.getOperand(0).isReg() && Inst.getOperand(1).isReg() &&
+             Inst.getOperand(0).getReg() == Inst.getOperand(1).getReg() &&
+             Inst.getOperand(2).isImm() && Inst.getOperand(2).getImm() == ARMCC::AL;
+    case ARM::t2MOVr:
+      if (Inst.getNumOperands() < 4)
+        return false;
+      return Inst.getOperand(0).isReg() && Inst.getOperand(1).isReg() &&
+             Inst.getOperand(0).getReg() == Inst.getOperand(1).getReg() &&
+             Inst.getOperand(2).isImm() && Inst.getOperand(2).getImm() == ARMCC::AL &&
+             Inst.getOperand(3).isReg() && Inst.getOperand(3).getReg() == 0;
+    }
+  }
+
+  bool isIndirectCall(const MCInst &Inst) const override {
+    if (!isCall(Inst))
+      return false;
+    // Register-form BLX only. BLXi / tBLXi are direct interworking calls (P8).
+    switch (Inst.getOpcode()) {
+    default:
+      return false;
+    case ARM::BLX:
+    case ARM::BLX_pred:
+    case ARM::tBLXr:
+      return true;
+    }
+  }
+
+  bool isReturn(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    default:
+      break;
+    case ARM::BX:
+    case ARM::tBX: {
+      // BX/tBX lr is the standard return; BX rm is interworking (P8).
+      if (Inst.getNumOperands() == 0 || !Inst.getOperand(0).isReg())
+        return false;
+      return Inst.getOperand(0).getReg() == ARM::LR;
+    }
+    case ARM::MOVPCLR:
+      return true;
+    // POP {..., pc} / LDM ...!, {..., pc} -- the standard epilogue for any
+    // function that spills callee-saved registers. Dual-purpose opcodes:
+    // whether a given instance is a return depends on whether PC happens to
+    // be in the register list, not on the opcode alone, so this has to be
+    // checked here dynamically rather than as a static MCInstrDesc property.
+    //
+    // NOTE: this recognition feeds isIndirectBranch()'s suppression check
+    // below. Deliberately NOT also wired into isTerminator(): doing so is
+    // semantically correct (a POP{pc} really does end a basic block) but
+    // empirically corrupts emission for any relocated function using it --
+    // confirmed by a reproducible before/after test (hot_loop stopped
+    // printing its result after rewrite, byte-identical function body
+    // otherwise). That appears to be a latent BOLT-core CFG/emission issue
+    // this dynamic-terminator case exposes, not something fixable from this
+    // target file alone; see README's known-limitations section.
+    case ARM::LDMIA_UPD:
+    case ARM::LDMDB_UPD:
+    case ARM::tPOP:
+    case ARM::t2LDMIA_UPD:
+    case ARM::t2LDMDB_UPD: {
+      for (const MCOperand &Op : Inst)
+        if (Op.isReg() && Op.getReg() == ARM::PC)
+          return true;
+      return false;
+    }
+    }
+    return Analysis->isReturn(Inst);
+  }
+
+  bool isIndirectBranch(const MCInst &Inst) const override {
+    // Returns are terminators, not indirect CFG edges.
+    if (isReturn(Inst))
+      return false;
+    // BX rm is an interworking jump. BLX* are calls.
+    switch (Inst.getOpcode()) {
+    default:
+      // t2TBB/t2TBH (Thumb-2 table branch byte/halfword -- the standard
+      // codegen for a switch statement with enough cases) are already
+      // flagged isBranch/isTerminator/isIndirectBranch at the MCInstrDesc
+      // level upstream (ARMInstrThumb2.td), so the generic Analysis-based
+      // fallback below gets this right on its own; this switch used to
+      // hard-return false for every opcode but BX/tBX, silently overriding
+      // that correct upstream answer back to false. Route unrecognized
+      // opcodes through the base class instead of assuming "not a branch".
+      return MCPlusBuilder::isIndirectBranch(Inst);
+    case ARM::BX:
+    case ARM::tBX:
+      return true;
+    }
+  }
+
+  IndirectBranchType analyzeIndirectBranch(
+      MCInst &Instruction, InstructionIterator Begin, InstructionIterator End,
+      const unsigned PtrSize, MCInst *&MemLocInstr, unsigned &BaseRegNum,
+      unsigned &IndexRegNum, int64_t &DispValue, const MCExpr *&DispExpr,
+      MCInst *&PCRelBaseOut, MCInst *&FixedEntryLoadInst) const override {
+    MemLocInstr = nullptr;
+    BaseRegNum = 0;
+    IndexRegNum = 0;
+    DispValue = 0;
+    DispExpr = nullptr;
+    PCRelBaseOut = nullptr;
+    FixedEntryLoadInst = nullptr;
+
+    if (isTailCall(Instruction))
+      return IndirectBranchType::POSSIBLE_TAIL_CALL;
+
+    switch (Instruction.getOpcode()) {
+    case ARM::t2TBB:
+    case ARM::t2TBH:
+      // A real table-branch jump table: entries are 1-byte (TBB) or 2-byte
+      // (TBH) unsigned halfword-counts, doubled and added to the PC value
+      // of the instruction after this one -- not the fixed-width
+      // pointer/PC-relative-delta array BOLT's generic jump-table reader
+      // (BinaryFunction::analyzeJumpTable) assumes for every other target.
+      // Decoding entries correctly needs that reader to support a
+      // sub-word, TBB/TBH-specific entry format, which is BOLT-core work,
+      // not something expressible from this target file alone.
+      //
+      // Returning UNKNOWN here (rather than leaving the caller in the
+      // isIndirectBranch()==false state this had before) is still the
+      // change that matters: since isIndirectBranch() above now correctly
+      // reports true for these two opcodes, BinaryFunction::disassemble()
+      // calls handleIndirectBranch() for them, which -- for UNKNOWN --
+      // records the offset and safely stops treating the instruction as
+      // fall-through, rather than continuing linear disassembly into the
+      // jump-table data bytes that immediately follow it. The function
+      // still won't get switch-aware layout optimization, but it no
+      // longer risks disassembling its own jump table as code.
+      //
+      // Verified: the compiler emits real $d/$t ELF mapping symbols
+      // bracketing the table (confirmed via readelf -s on a real TBB
+      // site), and BOLT's generic BinaryContext::getMarkerType() already
+      // classifies ARM's $a/$t/$d correctly and feeds
+      // BinaryFunction::markDataAtOffset/markCodeAtOffset from them -- so
+      // the disassembly loop's getSizeOfDataInCodeAt() skip already
+      // protects the table bytes independently of this indirect-branch
+      // classification. This fix's contribution is specifically making
+      // isIndirectBranch() stop lying about what kind of instruction a
+      // TBB/TBH is, not the data-skip itself (which was already correct).
+      return IndirectBranchType::UNKNOWN;
+    default:
+      break;
+    }
+
+    return IndirectBranchType::UNKNOWN;
+  }
+
+  // True only for a literal-pool / constant-island *load* (base register is
+  // PC): ARM::LDRi12 / ARM::t2LDRi12 with Rn=PC, or the compact
+  // ARM::tLDRpci / ARM::t2LDRpci literal-load forms the assembler prefers
+  // when the base register isn't spelled out explicitly. Direct B/BL are
+  // NOT included here -- they're handled as branches (evaluateBranch /
+  // getTargetSymbol), and returning true for them here would make
+  // reloc-mode disassembly fatal when the BL target is a far symbol.
+  bool isLiteralLoad(const MCInst &Inst) const {
+    switch (Inst.getOpcode()) {
+    case ARM::LDRi12:
+    case ARM::t2LDRi12:
+      return Inst.getOperand(1).isReg() &&
+             Inst.getOperand(1).getReg() == ARM::PC;
+    case ARM::tLDRpci:
+    case ARM::t2LDRpci:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+  bool hasPCRelOperand(const MCInst &Inst) const override {
+    return isLiteralLoad(Inst);
+  }
+
+  // Operand index of the displacement/offset field for each literal-load
+  // opcode -- verified against `llvm-mc -show-inst`: LDRi12/t2LDRi12 with
+  // an explicit PC base have (Rt, Rn, imm, pred, predreg), so the
+  // displacement is operand 2; tLDRpci/t2LDRpci have no explicit base
+  // register operand at all (Rt, imm, pred, predreg), so it is operand 1.
+  MCInst::iterator getMemOperandDisp(MCInst &Inst) const override {
+    if (!isLiteralLoad(Inst))
+      return Inst.end();
+    switch (Inst.getOpcode()) {
+    case ARM::LDRi12:
+    case ARM::t2LDRi12:
+      return Inst.begin() + 2;
+    case ARM::tLDRpci:
+    case ARM::t2LDRpci:
+      return Inst.begin() + 1;
+    default:
+      return Inst.end();
+    }
+  }
+
+  // Compute the address a literal-pool load actually reads from, following
+  // the two distinct "PC read-ahead" conventions the architecture defines:
+  // ARM state reads PC as the current instruction's address + 8 (the
+  // classic 3-stage-pipeline convention; ARM instructions are always
+  // 4-byte aligned already, so no explicit re-alignment is needed). Thumb
+  // state (both the compact 16-bit tLDRpci and the 32-bit Thumb-2
+  // t2LDRpci/t2LDRi12) instead reads PC as (current instruction's address
+  // + 4), word-aligned down -- this holds for 32-bit Thumb-2 instructions
+  // too, not just 16-bit ones, since it is a property of Thumb *state*,
+  // not of any specific instruction's encoding width. Verified operand
+  // sign/scale via llvm-mc: LDRi12/t2LDRpci decode their immediate as an
+  // already-signed byte offset (negative means subtract); tLDRpci decodes
+  // its immediate as an already-scaled (x4), unsigned, byte offset;
+  // t2LDRi12 (explicit PC base, wide encoding) only supports a positive
+  // offset. All four are handled uniformly below as "base + signed imm".
+  bool evaluateMemOperandTarget(const MCInst &Inst, uint64_t &Target,
+                                uint64_t Address,
+                                uint64_t Size) const override {
+    (void)Size;
+    if (!isLiteralLoad(Inst))
+      return false;
+    int64_t Imm;
+    uint64_t Base;
+    switch (Inst.getOpcode()) {
+    case ARM::LDRi12:
+      Imm = Inst.getOperand(2).getImm();
+      Base = Address + 8;
+      break;
+    case ARM::t2LDRi12:
+      Imm = Inst.getOperand(2).getImm();
+      Base = (Address + 4) & ~uint64_t(3);
+      break;
+    case ARM::tLDRpci:
+      Imm = Inst.getOperand(1).getImm();
+      Base = (Address + 4) & ~uint64_t(3);
+      break;
+    case ARM::t2LDRpci:
+      Imm = Inst.getOperand(1).getImm();
+      Base = (Address + 4) & ~uint64_t(3);
+      break;
+    default:
+      return false;
+    }
+    Target = Base + Imm;
+    return true;
+  }
+
+  bool getSymbolRefOperandNum(const MCInst &Inst, unsigned &OpNum) const {
+    switch (Inst.getOpcode()) {
+    default:
+      return false;
+    case ARM::B:
+    case ARM::BL:
+    case ARM::BLXi:
+      OpNum = 0;
+      return true;
+    case ARM::Bcc:
+      OpNum = 2;
+      return true;
+    // tB / tBcc / t2B / t2Bcc: target is the first in-operand.
+    case ARM::tB:
+    case ARM::tBcc:
+    case ARM::t2B:
+    case ARM::t2Bcc:
+      OpNum = 0;
+      return true;
+    // tBL / tBLXi: (pred:$p, target) — pred expands to (CC, CCR), so
+    // target is operand 2. Same for tBLXr (pred, Rm).
+    case ARM::tBL:
+    case ARM::tBLXi:
+    case ARM::tBLXr:
+      OpNum = 2;
+      return true;
+    case ARM::tCBZ:
+    case ARM::tCBNZ:
+      OpNum = 1;
+      return true;
+    }
+  }
+
+  const MCSymbol *getTargetSymbol(const MCInst &Inst,
+                                  unsigned OpNum = 0) const override {
+    if (!OpNum && !getSymbolRefOperandNum(Inst, OpNum))
+      return nullptr;
+    const MCOperand &Op = Inst.getOperand(OpNum);
+    if (!Op.isExpr())
+      return nullptr;
+    return MCPlusBuilder::getTargetSymbol(Op.getExpr());
+  }
+
+  void replaceBranchTarget(MCInst &Inst, const MCSymbol *TBB,
+                           MCContext *Ctx) const override {
+    if (!isCall(Inst) && !isBranch(Inst))
+      return;
+    if (isIndirectBranch(Inst))
+      return;
+    unsigned SymOpIndex;
+    if (!getSymbolRefOperandNum(Inst, SymOpIndex))
+      return;
+    Inst.getOperand(SymOpIndex) =
+        MCOperand::createExpr(MCSymbolRefExpr::create(TBB, *Ctx));
+  }
+
+  void reverseBranchCondition(MCInst &Inst, const MCSymbol *TBB,
+                              MCContext *Ctx) const override {
+    unsigned CCOp = 1;
+    switch (Inst.getOpcode()) {
+    default:
+      llvm_unreachable("cannot reverse branch condition");
+    case ARM::Bcc:
+    case ARM::tBcc:
+    case ARM::t2Bcc:
+      break;
+    }
+    unsigned CC = Inst.getOperand(CCOp).getImm();
+    Inst.getOperand(CCOp).setImm(ARMCC::getOppositeCondition(
+        static_cast<ARMCC::CondCodes>(CC)));
+    replaceBranchTarget(Inst, TBB, Ctx);
+  }
+
+  bool analyzeBranch(InstructionIterator Begin, InstructionIterator End,
+                     const MCSymbol *&TBB, const MCSymbol *&FBB,
+                     MCInst *&CondBranch,
+                     MCInst *&UncondBranch) const override {
+    auto I = End;
+    while (I != Begin) {
+      --I;
+      if (isPseudo(*I) || isNoop(*I))
+        continue;
+      if (!isTerminator(*I) || isTailCall(*I) || !isBranch(*I))
+        break;
+      if (isUnconditionalBranch(*I)) {
+        CondBranch = nullptr;
+        UncondBranch = &*I;
+        TBB = getTargetSymbol(*I);
+        if (!TBB)
+          return false;
+        continue;
+      }
+      if (isIndirectBranch(*I))
+        return false;
+      if (CondBranch == nullptr) {
+        const MCSymbol *TargetBB = getTargetSymbol(*I);
+        if (!TargetBB)
+          return false;
+        FBB = TBB;
+        TBB = TargetBB;
+        CondBranch = &*I;
+        continue;
+      }
+      llvm_unreachable("multiple conditional branches in one BB");
+    }
+    return true;
+  }
+
+  int getPCRelEncodingSize(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    default:
+      if (isCall(Inst) || isUnconditionalBranch(Inst))
+        return isThumbInst(Inst) ? 25 : 26;
+      if (isConditionalBranch(Inst))
+        return isThumbInst(Inst) ? 21 : 26;
+      return isThumbInst(Inst) ? 25 : 26;
+    case ARM::B:
+    case ARM::BL:
+    case ARM::Bcc:
+      return 26;
+    case ARM::tB:
+    case ARM::tBcc:
+      return 12;
+    case ARM::tBL:
+    case ARM::t2B:
+      return 25;
+    case ARM::t2Bcc:
+      return 21;
+    case ARM::tCBZ:
+    case ARM::tCBNZ:
+      return 9;
+    }
+  }
+
+  int getShortJmpEncodingSize() const override { return 32; }
+
+  int getUncondBranchEncodingSize() const override { return 26; }
+
+  std::optional<uint32_t> getInstructionSize(const MCInst &Inst) const override {
+    unsigned Size = Info->get(Inst.getOpcode()).getSize();
+    if (Size)
+      return Size;
+    return isThumbInst(Inst) ? 2u : 4u;
+  }
+
+
+  /// Match LLD ARM absolute long veneer:
+  ///   ldr pc, [pc, #-4]
+  ///   .word Target
+  bool matchAbsLongVeneer(const BinaryFunction &BF,
+                          uint64_t &TargetAddress) const override {
+    if (BF.empty())
+      return false;
+    const BinaryContext &BC = BF.getBinaryContext();
+    const uint64_t Addr = BF.getAddress();
+    // Prefer symbol size: MaxSize often spans linker fill to a far callee
+    // (e.g. LongLdrPcThunk), so probing MaxSize would hit padding words.
+    const uint64_t SymSize = BF.getSize() ? BF.getSize() : BF.getMaxSize();
+    const uint64_t ScanSize = std::max(SymSize, BF.getMaxSize());
+
+    auto tryWordAt = [&](uint64_t Off, uint64_t Limit) -> bool {
+      if (Off + 4 > Limit)
+        return false;
+      ErrorOr<uint64_t> Word =
+          BC.getUnsignedValueAtAddress(Addr + Off, /*Size=*/4);
+      if (!Word || !*Word)
+        return false;
+      // Clear Thumb LSB so getBinaryFunctionAtAddress can resolve the callee.
+      const uint64_t Cand = *Word & ~1ULL;
+      if (!Cand || !BC.getBinaryFunctionAtAddress(Cand))
+        return false;
+      TargetAddress = Cand;
+      return true;
+    };
+
+    // LLD ARM/Thumb absolute veneer literal slots:
+    // ARM:    ldr pc,[pc,#-4]; .word               -> +4 (sym size 8)
+    // ARM:    ldr r12,[pc]; bx r12; .word          -> +8 (sym size 12)
+    // Thumb:  bx pc; …; ldr pc,[pc,#-4]; .word     -> +8 or +12
+    if (!BF.isARMThumb()) {
+      if (tryWordAt(4, SymSize) || tryWordAt(8, SymSize))
+        return true;
+      // Fall back only if symbol size is missing/wrong.
+      if (ScanSize != SymSize &&
+          (tryWordAt(4, ScanSize) || tryWordAt(8, ScanSize)))
+        return true;
+    } else {
+      if (tryWordAt(8, SymSize) || tryWordAt(12, SymSize) ||
+          (SymSize >= 8 && tryWordAt(SymSize - 4, SymSize)))
+        return true;
+      if (ScanSize != SymSize &&
+          (tryWordAt(8, ScanSize) || tryWordAt(12, ScanSize) ||
+           (ScanSize >= 8 && tryWordAt(ScanSize - 4, ScanSize))))
+        return true;
+    }
+    if (SymSize >= 8 && SymSize <= 20 && tryWordAt(SymSize - 4, SymSize))
+      return true;
+    return false;
+  }
+
+  void adjustCallForTargetMode(MCInst &Inst, bool SrcThumb, bool DstThumb,
+                               MCContext *Ctx) const override {
+    const MCSymbol *Target = getTargetSymbol(Inst);
+    if (!Target || !Ctx)
+      return;
+    const bool Cross = SrcThumb != DstThumb;
+    const bool WasTail = isTailCall(Inst);
+    if (SrcThumb) {
+      if (Cross)
+        Inst = MCInstBuilder(ARM::tBLXi)
+                   .addImm(ARMCC::AL)
+                   .addReg(0)
+                   .addExpr(MCSymbolRefExpr::create(Target, *Ctx));
+      else
+        Inst = MCInstBuilder(ARM::tBL)
+                   .addImm(ARMCC::AL)
+                   .addReg(0)
+                   .addExpr(MCSymbolRefExpr::create(Target, *Ctx));
+    } else {
+      if (Cross)
+        Inst = MCInstBuilder(ARM::BLXi)
+                   .addExpr(MCSymbolRefExpr::create(Target, *Ctx));
+      else
+        Inst = MCInstBuilder(ARM::BL).addExpr(
+            MCSymbolRefExpr::create(Target, *Ctx));
+    }
+    if (WasTail)
+      setTailCall(Inst);
+  }
+
+  void createReturn(MCInst &Inst) const override {
+    if (InThumbMode()) {
+      // tBX: (Rm, pred) -> Rm, CC, CCR
+      Inst = MCInstBuilder(ARM::tBX)
+                 .addReg(ARM::LR)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+    } else {
+      Inst = MCInstBuilder(ARM::BX).addReg(ARM::LR);
+    }
+  }
+
+  void createUncondBranch(MCInst &Inst, const MCSymbol *TBB,
+                          MCContext *Ctx) const override {
+    if (InThumbMode()) {
+      // t2B: (target, pred) -> target, CC, CCR
+      Inst = MCInstBuilder(ARM::t2B)
+                 .addExpr(MCSymbolRefExpr::create(TBB, *Ctx))
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+    } else {
+      Inst = MCInstBuilder(ARM::B).addExpr(MCSymbolRefExpr::create(TBB, *Ctx));
+    }
+  }
+
+  void createLongUncondBranch(MCInst &Inst, const MCSymbol *Target,
+                              MCContext *Ctx) const override {
+    createUncondBranch(Inst, Target, Ctx);
+  }
+
+  void createTailCall(MCInst &Inst, const MCSymbol *Target,
+                      MCContext *Ctx) override {
+    createCall(Inst, Target, Ctx);
+    convertJmpToTailCall(Inst);
+  }
+
+  void createBreakpoint(MCInst &Inst) const override { createTrap(Inst); }
+
+  void createCall(MCInst &Inst, const MCSymbol *Target,
+                  MCContext *Ctx) override {
+    if (InThumbMode()) {
+      Inst = MCInstBuilder(ARM::tBL)
+                 .addImm(ARMCC::AL)
+                 .addReg(0)
+                 .addExpr(MCSymbolRefExpr::create(Target, *Ctx));
+    } else {
+      Inst = MCInstBuilder(ARM::BL).addExpr(MCSymbolRefExpr::create(Target, *Ctx));
+    }
+  }
+
+  void createDirectCall(MCInst &Inst, const MCSymbol *Target, MCContext *Ctx,
+                        bool IsTailCall) override {
+    createCall(Inst, Target, Ctx);
+    if (IsTailCall)
+      convertJmpToTailCall(Inst);
+  }
+
+  bool convertJmpToTailCall(MCInst &Inst) override {
+    if (isTailCall(Inst))
+      return false;
+    setTailCall(Inst);
+    return true;
+  }
+
+  bool lowerTailCall(MCInst &Inst) override {
+    removeAnnotation(Inst, MCPlus::MCAnnotation::kTailCall);
+    if (getConditionalTailCall(Inst))
+      unsetConditionalTailCall(Inst);
+    return true;
+  }
+
+  void createLongTailCall(InstructionListType &Seq, const MCSymbol *Target,
+                          MCContext *Ctx) override {
+    createShortJmp(Seq, Target, Ctx, /*IsTailCall*/ true);
+  }
+
+  void createLongJmp(InstructionListType &Seq, const MCSymbol *Target,
+                     MCContext *Ctx, bool IsTailCall) override {
+    // AArch32 VA fits in movw/movt; long == short absolute veneer.
+    createShortJmp(Seq, Target, Ctx, IsTailCall);
+  }
+
+  void createShortJmp(InstructionListType &Seq, const MCSymbol *Target,
+                      MCContext *Ctx, bool IsTailCall) override {
+    MCPhysReg Reg = ARM::R12;
+    InstructionListType Insts = materializeAddress(Target, Ctx, Reg);
+    Insts.emplace_back();
+    if (InThumbMode()) {
+      Insts.back() = MCInstBuilder(ARM::tBX)
+                         .addReg(Reg)
+                         .addImm(ARMCC::AL)
+                         .addReg(0);
+    } else {
+      Insts.back() = MCInstBuilder(ARM::BX).addReg(Reg);
+    }
+    if (IsTailCall)
+      setTailCall(Insts.back());
+    Seq.swap(Insts);
+  }
+
+  std::vector<MCInst> createSymbolTrampoline(const MCSymbol *TgtSym,
+                                             MCContext *Ctx) override {
+    std::vector<MCInst> Insts;
+    createShortJmp(Insts, TgtSym, Ctx, /*IsTailCall*/ true);
+    return Insts;
+  }
+
+  InstructionListType materializeAddress(const MCSymbol *Target, MCContext *Ctx,
+                                         MCPhysReg RegName,
+                                         int64_t Addend = 0) const override {
+    // Prefer IP (r12), the AAPCS intra-procedure-call scratch, when callers
+    // pass it — matches linker veneers.
+    InstructionListType Insts(2);
+    if (InThumbMode()) {
+      Insts[0] = MCInstBuilder(ARM::t2MOVi16)
+                     .addReg(RegName)
+                     .addImm(Addend & 0xffff)
+                     .addImm(ARMCC::AL)
+                     .addReg(0);
+      Insts[1] = MCInstBuilder(ARM::t2MOVTi16)
+                     .addReg(RegName)
+                     .addReg(RegName)
+                     .addImm((Addend >> 16) & 0xffff)
+                     .addImm(ARMCC::AL)
+                     .addReg(0);
+    } else {
+      Insts[0] = MCInstBuilder(ARM::MOVi16)
+                     .addReg(RegName)
+                     .addImm(Addend & 0xffff)
+                     .addImm(ARMCC::AL)
+                     .addReg(0);
+      Insts[1] = MCInstBuilder(ARM::MOVTi16)
+                     .addReg(RegName)
+                     .addReg(RegName)
+                     .addImm((Addend >> 16) & 0xffff)
+                     .addImm(ARMCC::AL)
+                     .addReg(0);
+    }
+    const uint32_t MovwRel = InThumbMode() ? ELF::R_ARM_THM_MOVW_ABS_NC
+                                           : ELF::R_ARM_MOVW_ABS_NC;
+    const uint32_t MovtRel = InThumbMode() ? ELF::R_ARM_THM_MOVT_ABS
+                                           : ELF::R_ARM_MOVT_ABS;
+    setOperandToSymbolRef(Insts[0], /*OpNum=*/1, Target, Addend, Ctx, MovwRel);
+    setOperandToSymbolRef(Insts[1], /*OpNum=*/2, Target, Addend, Ctx, MovtRel);
+    return Insts;
+  }
+
+  void createStackPointerIncrement(MCInst &Inst, int imm,
+                                   bool NoFlagsClobber = false) const override {
+    (void)NoFlagsClobber;
+    if (InThumbMode()) {
+      // tSUBspi: SP, SP, imm (# words), pred, predreg
+      Inst = MCInstBuilder(ARM::tSUBspi)
+                 .addReg(ARM::SP)
+                 .addReg(ARM::SP)
+                 .addImm(imm / 4)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+    } else {
+      // SUBri operand order verified via `llvm-mc -show-inst`: Rd, Rn,
+      // imm, pred, predreg, S-flag-def-reg (6 operands) -- pred/predreg do
+      // NOT come before the immediate, unlike an earlier, wrong version of
+      // this helper that silently mis-encoded predicate=EQ and a bogus
+      // immediate by feeding the encoder operands in the wrong slots.
+      Inst = MCInstBuilder(ARM::SUBri)
+                 .addReg(ARM::SP)
+                 .addReg(ARM::SP)
+                 .addImm(imm)
+                 .addImm(ARMCC::AL)
+                 .addReg(0)
+                 .addReg(0);
+    }
+  }
+
+  void createStackPointerDecrement(MCInst &Inst, int imm,
+                                   bool NoFlagsClobber = false) const override {
+    (void)NoFlagsClobber;
+    if (InThumbMode()) {
+      Inst = MCInstBuilder(ARM::tADDspi)
+                 .addReg(ARM::SP)
+                 .addReg(ARM::SP)
+                 .addImm(imm / 4)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+    } else {
+      // Same fix as SUBri above: imm before pred/predreg, plus the
+      // trailing S-flag-def-reg operand ADDri actually needs.
+      Inst = MCInstBuilder(ARM::ADDri)
+                 .addReg(ARM::SP)
+                 .addReg(ARM::SP)
+                 .addImm(imm)
+                 .addImm(ARMCC::AL)
+                 .addReg(0)
+                 .addReg(0);
+    }
+  }
+
+  void loadReg(MCInst &Inst, MCPhysReg To, MCPhysReg From,
+               int64_t offset) const {
+    if (InThumbMode()) {
+      // t2LDRi12: Rt, Rn, imm12, pred, predreg
+      Inst = MCInstBuilder(ARM::t2LDRi12)
+                 .addReg(To)
+                 .addReg(From)
+                 .addImm(offset)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+    } else {
+      // LDRi12 verified via `llvm-mc -show-inst`: Rt, Rn, imm12, pred,
+      // predreg (5 operands) -- same fix as SUBri/ADDri above. The old
+      // 6-operand wrong-order version fed the encoder AL(14) as the
+      // immediate and 0 as the predicate, producing "ldreq ...,#0xe"
+      // instead of "ldr ...,#0" -- confirmed via a real instrumented ARM
+      // boot: the reload of spilled registers after a counter-increment
+      // snippet silently executed conditionally (predicate EQ, usually
+      // false) with the wrong offset, corrupting whatever register/stack
+      // state depended on it.
+      Inst = MCInstBuilder(ARM::LDRi12)
+                 .addReg(To)
+                 .addReg(From)
+                 .addImm(offset)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+    }
+  }
+
+  void storeReg(MCInst &Inst, MCPhysReg From, MCPhysReg To,
+                int64_t offset) const {
+    if (InThumbMode()) {
+      Inst = MCInstBuilder(ARM::t2STRi12)
+                 .addReg(From)
+                 .addReg(To)
+                 .addImm(offset)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+    } else {
+      // Same fix as LDRi12 above.
+      Inst = MCInstBuilder(ARM::STRi12)
+                 .addReg(From)
+                 .addReg(To)
+                 .addImm(offset)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+    }
+  }
+
+  void spillRegs(InstructionListType &Insts,
+                 const SmallVector<unsigned> &Regs) const {
+    Insts.emplace_back();
+    createStackPointerIncrement(Insts.back(), Regs.size() * 4);
+    int64_t Offset = 0;
+    for (auto Reg : Regs) {
+      Insts.emplace_back();
+      storeReg(Insts.back(), Reg, ARM::SP, Offset);
+      Offset += 4;
+    }
+  }
+
+  void reloadRegs(InstructionListType &Insts,
+                  const SmallVector<unsigned> &Regs) const {
+    int64_t Offset = 0;
+    for (auto Reg : Regs) {
+      Insts.emplace_back();
+      loadReg(Insts.back(), Reg, ARM::SP, Offset);
+      Offset += 4;
+    }
+    Insts.emplace_back();
+    createStackPointerDecrement(Insts.back(), Regs.size() * 4);
+  }
+
+  // The retry loop needs its load instruction labeled so the trailing
+  // conditional branch can target it on failure; MCInst has no room for a
+  // label, so the loop is built as its own basic block inside an injected
+  // helper function (mirrors AArch64MCPlusBuilder's non-LSE
+  // createInstrCounterIncrFunc). This also keeps createInstrIncMemory's
+  // return value a flat instruction sequence, since it is spliced inline at
+  // arbitrary call sites with no CFG of its own.
+  //
+  // Operand orders below are verified against `llvm-mc -show-inst` output
+  // for each opcode, not assumed from other call sites in this file --
+  // ADDri in particular has its immediate BEFORE the predicate pair, not
+  // after (confirmed the previous non-atomic version got this backwards in
+  // the ARM, non-Thumb encoding path; that path was never exercised by any
+  // test here since all instrumentation testing used the default Thumb LK
+  // build).
+  // Bare-metal, single-core (this target is never run SMP) atomic counter
+  // bump via IRQ masking rather than an ldrex/strex retry loop.
+  //
+  // An ldrex/strex loop needs a backward branch, which -- since this
+  // function's return value is a flat instruction sequence spliced inline
+  // at an arbitrary point in an existing basic block, not a CFG node of
+  // its own -- has no instruction-level home for a label to branch back
+  // to. AArch64MCPlusBuilder's equivalent solves this by building the
+  // retry loop as a real basic block in a separate injected helper
+  // function (createInstrCounterIncrFunc), called via BL from here. That
+  // pattern does not transfer to this target: BOLT-core's
+  // Instrumentation.cpp calls createInstrCounterIncrFunc() from exactly
+  // one call site, gated `if (BC.isAArch64())` -- unconditionally false
+  // for AArch32, so an ARM override of that hook is simply never invoked,
+  // confirmed via direct instrumentation of a real LK binary (segfaults
+  // dereferencing a still-null helper-function pointer otherwise; this
+  // was an earlier version of this fix's own bug, not a hypothetical).
+  //
+  // The actual atomicity requirement here is also different from
+  // AArch64/x86's: this counter is bumped from bare-metal instrumented
+  // code with no other CPU ever running concurrently (LK is only ever
+  // built and run here with smp=1) -- ldrex/strex solves multi-core cache
+  // coherency, which does not apply. The real hazard is an ISR reading or
+  // writing the same counter while the mainline increment is
+  // mid-sequence, which CPSID/CPSIE (IRQ masking) around the
+  // load-modify-store solves directly, with straight-line code and no
+  // control flow at all. As a further benefit, CPS does not touch NZCV,
+  // so (unlike CMP+Bcc) it needs no flag save/restore either.
+  InstructionListType createInstrIncMemory(const MCSymbol *Target,
+                                           MCContext *Ctx, bool IsLeaf,
+                                           unsigned CodePointerSize) override {
+    (void)IsLeaf;
+    (void)CodePointerSize;
+    InstructionListType Insts;
+    spillRegs(Insts, {ARM::R0, ARM::R1, ARM::R2});
+    InstructionListType Addr = materializeAddress(Target, Ctx, ARM::R0);
+    Insts.insert(Insts.end(), Addr.begin(), Addr.end());
+
+    // Save CPSR (R2) before disabling IRQs, and restore it afterward
+    // (rather than unconditionally re-enabling with cpsie) -- this
+    // snippet can land inside code that was already running with
+    // interrupts disabled (a boot-critical section, say), and
+    // unconditionally forcing them back on at the end would break that
+    // invariant. An earlier version of this fix did exactly that and
+    // crashed shortly after a correctly-completed instrumented call,
+    // confirmed via a direct before/after boot test.
+    Insts.emplace_back();
+    if (InThumbMode())
+      Insts.back() =
+          MCInstBuilder(ARM::t2MRS_AR).addReg(ARM::R2).addImm(ARMCC::AL).addReg(0);
+    else
+      Insts.back() =
+          MCInstBuilder(ARM::MRS).addReg(ARM::R2).addImm(ARMCC::AL).addReg(0);
+
+    // cpsid i: imod=3 (ID, disable), iflags=2 (I, IRQ only). No predicate
+    // operand -- CPS cannot be conditionally executed at all.
+    Insts.emplace_back();
+    if (InThumbMode())
+      Insts.back() = MCInstBuilder(ARM::tCPS).addImm(3).addImm(2);
+    else
+      Insts.back() = MCInstBuilder(ARM::CPS2p).addImm(3).addImm(2);
+
+    Insts.emplace_back();
+    loadReg(Insts.back(), ARM::R1, ARM::R0, /*offset=*/0);
+    if (InThumbMode()) {
+      // t2ADDri12: Rd, Rn, imm12, pred, predreg
+      Insts.emplace_back(MCInstBuilder(ARM::t2ADDri12)
+                             .addReg(ARM::R1)
+                             .addReg(ARM::R1)
+                             .addImm(1)
+                             .addImm(ARMCC::AL)
+                             .addReg(0));
+    } else {
+      // ADDri: Rd, Rn, imm(shifter), pred, predreg, s-flag-def-reg
+      Insts.emplace_back(MCInstBuilder(ARM::ADDri)
+                             .addReg(ARM::R1)
+                             .addReg(ARM::R1)
+                             .addImm(1)
+                             .addImm(ARMCC::AL)
+                             .addReg(0)
+                             .addReg(0));
+    }
+    Insts.emplace_back();
+    storeReg(Insts.back(), ARM::R1, ARM::R0, /*offset=*/0);
+
+    // MSR CPSR_c, R2 (mask=1, control field only: mode/T/F/I bits, not
+    // NZCV) -- restores exactly the interrupt-enable state (and nothing
+    // else) that was captured before cpsid, whatever it was.
+    Insts.emplace_back();
+    if (InThumbMode())
+      Insts.back() = MCInstBuilder(ARM::t2MSR_AR)
+                          .addImm(1)
+                          .addReg(ARM::R2)
+                          .addImm(ARMCC::AL)
+                          .addReg(0);
+    else
+      Insts.back() = MCInstBuilder(ARM::MSR)
+                          .addImm(1)
+                          .addReg(ARM::R2)
+                          .addImm(ARMCC::AL)
+                          .addReg(0);
+
+    reloadRegs(Insts, {ARM::R0, ARM::R1, ARM::R2});
+    return Insts;
+  }
+
+  void createTrap(MCInst &Inst) const override { Inst = MCInstBuilder(ARM::TRAP); }
+
+  void createNoop(MCInst &Inst) const override {
+    if (InThumbMode())
+      Inst = MCInstBuilder(ARM::tMOVr)
+                 .addReg(ARM::R0)
+                 .addReg(ARM::R0)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+    else
+      Inst = MCInstBuilder(ARM::MOVr)
+                 .addReg(ARM::R0)
+                 .addReg(ARM::R0)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+  }
+
+  StringRef getTrapFillValue() const override {
+    return StringRef("\x00\xf0\x20\xe3", 4);
+  }
+
+  uint16_t getMinFunctionAlignment() const override {
+    return InThumbMode() ? 2 : 4;
+  }
+
+  bool replaceImmWithSymbolRef(MCInst &Inst, const MCSymbol *Symbol,
+                               int64_t Addend, MCContext *Ctx, int64_t &Value,
+                               uint32_t RelType) const override {
+    unsigned ImmOpNo = -1U;
+    for (unsigned Index = 0; Index < MCPlus::getNumPrimeOperands(Inst);
+         ++Index) {
+      if (Inst.getOperand(Index).isImm()) {
+        ImmOpNo = Index;
+        break;
+      }
+    }
+    if (ImmOpNo == -1U)
+      return false;
+    Value = Inst.getOperand(ImmOpNo).getImm();
+    setOperandToSymbolRef(Inst, ImmOpNo, Symbol, Addend, Ctx, RelType);
+    return true;
+  }
+
+  const MCExpr *getTargetExprFor(MCInst &Inst, const MCExpr *Expr,
+                                 MCContext &Ctx,
+                                 uint32_t RelType) const override {
+    (void)Inst;
+    switch (RelType) {
+    default:
+      return Expr;
+    case ELF::R_ARM_MOVW_ABS_NC:
+    case ELF::R_ARM_THM_MOVW_ABS_NC:
+      return MCSpecifierExpr::create(Expr, ARM::S_LO16, Ctx);
+    case ELF::R_ARM_MOVT_ABS:
+    case ELF::R_ARM_THM_MOVT_ABS:
+      return MCSpecifierExpr::create(Expr, ARM::S_HI16, Ctx);
+    }
+  }
+
+  std::optional<Relocation>
+  createRelocation(const MCFixup &Fixup,
+                   const MCAsmBackend &MAB) const override {
+    (void)MAB;
+    const uint64_t RelOffset = Fixup.getOffset();
+    const unsigned Kind = Fixup.getKind();
+    uint32_t RelType;
+    if (Kind == ARM::fixup_arm_uncondbl || Kind == ARM::fixup_arm_condbl ||
+        Kind == ARM::fixup_arm_blx)
+      RelType = ELF::R_ARM_CALL;
+    else if (Kind == ARM::fixup_arm_condbranch ||
+             Kind == ARM::fixup_arm_uncondbranch)
+      RelType = ELF::R_ARM_JUMP24;
+    else if (Kind == ARM::fixup_arm_movw_lo16)
+      RelType = ELF::R_ARM_MOVW_ABS_NC;
+    else if (Kind == ARM::fixup_arm_movt_hi16)
+      RelType = ELF::R_ARM_MOVT_ABS;
+    else if (Kind == ARM::fixup_t2_movw_lo16)
+      RelType = ELF::R_ARM_THM_MOVW_ABS_NC;
+    else if (Kind == ARM::fixup_t2_movt_hi16)
+      RelType = ELF::R_ARM_THM_MOVT_ABS;
+    else if (Kind == ARM::fixup_arm_thumb_br ||
+             Kind == ARM::fixup_arm_thumb_bcc ||
+             Kind == ARM::fixup_t2_uncondbranch ||
+             Kind == ARM::fixup_t2_condbranch)
+      RelType = ELF::R_ARM_THM_JUMP24;
+    else if (Kind == ARM::fixup_arm_thumb_bl ||
+             Kind == ARM::fixup_arm_thumb_blx)
+      RelType = ELF::R_ARM_THM_CALL;
+    else if (Kind == FK_Data_4)
+      RelType = Fixup.isPCRel() ? ELF::R_ARM_REL32 : ELF::R_ARM_ABS32;
+    else
+      return std::nullopt;
+    auto [RelSymbol, RelAddend] = extractFixupExpr(Fixup);
+    return Relocation({RelOffset, RelSymbol, RelType, RelAddend, 0});
+  }
+
+  void createDirectBranch(MCInst &Inst, const MCSymbol *Target,
+                          MCContext *Ctx) override {
+    createUncondBranch(Inst, Target, Ctx);
+  }
+
+  // Indirect-call instrumentation is disabled for the P9 gate
+  // (--instrument-calls=false), but setup still builds handler functions.
+  InstructionListType createInstrumentedIndCallHandlerExitBB() const override {
+    InstructionListType Insts(1);
+    createReturn(Insts[0]);
+    return Insts;
+  }
+
+  InstructionListType
+  createInstrumentedIndTailCallHandlerExitBB() const override {
+    return createInstrumentedIndCallHandlerExitBB();
+  }
+
+  InstructionListType createInstrumentedIndCallHandlerEntryBB(
+      const MCSymbol *InstrTrampoline, const MCSymbol *IndCallHandler,
+      MCContext *Ctx) override {
+    (void)InstrTrampoline;
+    InstructionListType Insts(1);
+    createDirectBranch(Insts[0], IndCallHandler, Ctx);
+    return Insts;
+  }
+
+  InstructionListType createInstrumentedIndirectCall(MCInst &&CallInst,
+                                                     MCSymbol *HandlerFuncAddr,
+                                                     size_t CallSiteID,
+                                                     MCContext *Ctx) override {
+    (void)HandlerFuncAddr;
+    (void)CallSiteID;
+    (void)Ctx;
+    return InstructionListType{std::move(CallInst)};
+  }
+
+  InstructionListType createGetter(MCContext *Ctx, const char *name) const {
+    InstructionListType Insts(4);
+    MCSymbol *Locs = Ctx->getOrCreateSymbol(name);
+    InstructionListType Addr = materializeAddress(Locs, Ctx, ARM::R0);
+    std::copy(Addr.begin(), Addr.end(), Insts.begin());
+    loadReg(Insts[2], ARM::R0, ARM::R0, 0);
+    createReturn(Insts[3]);
+    return Insts;
+  }
+
+  InstructionListType createNumCountersGetter(MCContext *Ctx) const override {
+    return createGetter(Ctx, "__bolt_num_counters");
+  }
+
+  InstructionListType
+  createInstrLocationsGetter(MCContext *Ctx) const override {
+    return createGetter(Ctx, "__bolt_instr_locations");
+  }
+
+  InstructionListType createInstrTablesGetter(MCContext *Ctx) const override {
+    return createGetter(Ctx, "__bolt_instr_tables");
+  }
+
+  InstructionListType createInstrNumFuncsGetter(MCContext *Ctx) const override {
+    return createGetter(Ctx, "__bolt_instr_num_funcs");
+  }
+
+  void prepareForEmission(BinaryFunction &BF) override {
+    if (!BF.isARMThumb())
+      return;
+    BinaryContext &BC = BF.getBinaryContext();
+    for (BinaryBasicBlock &BB : BF) {
+      for (auto II = BB.begin(); II != BB.end();) {
+        MCInst &Inst = *II;
+        const unsigned Op = Inst.getOpcode();
+        if (Op != ARM::tCBZ && Op != ARM::tCBNZ) {
+          ++II;
+          continue;
+        }
+        if (!Inst.getOperand(0).isReg()) {
+          ++II;
+          continue;
+        }
+        const MCSymbol *Tgt = getTargetSymbol(Inst);
+        if (!Tgt) {
+          ++II;
+          continue;
+        }
+        const MCPhysReg Rn = Inst.getOperand(0).getReg();
+        const bool IsCBNZ = Op == ARM::tCBNZ;
+        InstructionListType Seq(2);
+        // cmp Rn, #0
+        Seq[0] = MCInstBuilder(ARM::tCMPi8)
+                     .addReg(Rn)
+                     .addImm(0)
+                     .addImm(ARMCC::AL)
+                     .addReg(0);
+        // beq / bne target (Thumb-2, wide range)
+        Seq[1] = MCInstBuilder(ARM::t2Bcc)
+                     .addExpr(MCSymbolRefExpr::create(Tgt, *BC.Ctx))
+                     .addImm(IsCBNZ ? ARMCC::NE : ARMCC::EQ)
+                     .addReg(0);
+        II = BB.replaceInstruction(II, Seq);
+        II = std::next(II, 2);
+      }
+    }
+  }
+};
+
+} // end anonymous namespace
+
+namespace llvm {
+namespace bolt {
