diff --git a/bolt/test/ARM/arm32-thumb-pop-return.test b/bolt/test/ARM/arm32-thumb-pop-return.test
new file mode 100644
index 000000000000..915ef4087a5e
--- /dev/null
+++ b/bolt/test/ARM/arm32-thumb-pop-return.test
@@ -0,0 +1,29 @@
+## POP {..., pc} is the standard epilogue for any Thumb function that
+## spills callee-saved registers across a call. isReturn() must recognize
+## it as a return (only BX lr / MOVPCLR were recognized before this fix) so
+## BOLT treats the function as IsSimple and is willing to overwrite it,
+## rather than conservatively bailing out on unrecognized control flow.
+
+# RUN: llvm-mc -filetype=obj -triple=thumbv7-unknown-linux-gnueabi %p/Inputs/arm32-thumb-pop-return.s -o %t.o
+# RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+# RUN: llvm-objdump -d --triple=thumbv7a-none-eabi %t.exe | FileCheck %s --check-prefix=CHECK-IN
+# RUN: llvm-bolt %t.exe -o %t.bolt --print-cfg 2>&1 | FileCheck %s --check-prefix=CHECK-LOG
+# RUN: llvm-objdump -s --section=.text %t.bolt | FileCheck %s --check-prefix=CHECK-OUT
+
+# Input contains the push/bl/pop{pc} pattern (disasm of linked input has $t).
+# CHECK-IN: push{{.*}}{r4, r5, lr}
+# CHECK-IN: bl{{.*}}<callee>
+# CHECK-IN: pop{{.*}}{r4, r5, pc}
+
+# pop{pc} must be recognized as a return: function stays IsSimple (single
+# well-formed CFG, no UNKNOWN CONTROL FLOW) and gets overwritten.
+# CHECK-LOG: Binary Function "_start
+# CHECK-LOG: IsSimple{{.*}}: 1
+# CHECK-LOG: pop{{.*}}{r4, r5, pc}
+# CHECK-LOG-NOT: UNKNOWN CONTROL FLOW
+# CHECK-LOG-NOT: BOLT-ERROR
+# CHECK-LOG-NOT: unable to disassemble
+# CHECK-LOG: BOLT: 2 out of 2 functions were overwritten
+
+# Identity rewrite must reproduce the input bytes exactly.
+# CHECK-OUT: 30b50124 022500f0 02f86019 30bd7047
diff --git a/bolt/test/ARM/arm32-thumb-switch.test b/bolt/test/ARM/arm32-thumb-switch.test
new file mode 100644
index 000000000000..3c373dbb1ed9
--- /dev/null
+++ b/bolt/test/ARM/arm32-thumb-switch.test
@@ -0,0 +1,31 @@
+## A dense 4-way switch lowers to a Thumb-2 TBB (table-branch-byte) dispatch.
+## isIndirectBranch() must recognize TBB as an indirect branch (not silently
+## fall through into its own jump table, and not misclassify it as a
+## return or an ordinary direct branch). Full jump-table decoding is not
+## implemented, so BOLT correctly marks
+## this function's control flow as UNKNOWN and, being conservative, leaves
+## it un-overwritten rather than risk corrupting it.
+
+# RUN: llvm-mc -filetype=obj -triple=thumbv7-unknown-linux-gnueabi %p/Inputs/arm32-thumb-switch.s -o %t.o
+# RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+# RUN: llvm-objdump -d --triple=thumbv7a-none-eabi %t.exe | FileCheck %s --check-prefix=CHECK-IN
+# RUN: llvm-bolt %t.exe -o %t.bolt --print-cfg 2>&1 | FileCheck %s --check-prefix=CHECK-LOG
+# RUN: llvm-objdump -s --section=.text %t.bolt | FileCheck %s --check-prefix=CHECK-OUT
+
+# Input contains the tbb dispatch (disasm of linked input has $t).
+# CHECK-IN: and{{.*}}r1, r0, #0x3
+# CHECK-IN-NEXT: tbb [pc, r1]
+
+# TBB must be recognized as indirect-branch control flow, not silently
+# treated as fallthrough/return/direct-branch. Table decode not
+# implemented, so this is the correct, conservative outcome.
+# CHECK-LOG: Binary Function "_start
+# CHECK-LOG: tbb{{.*}}# UNKNOWN CONTROL FLOW
+# CHECK-LOG-NOT: BOLT-ERROR
+# CHECK-LOG-NOT: unable to disassemble
+# CHECK-LOG: BOLT: 0 out of 1 functions were overwritten
+
+# Conservative: function left byte-identical rather than risk corrupting
+# a jump table BOLT can't fully decode.
+# CHECK-OUT: 00f00301 dfe801f0 02040608 0a207047
+# CHECK-OUT: 14207047 1e207047 28207047
