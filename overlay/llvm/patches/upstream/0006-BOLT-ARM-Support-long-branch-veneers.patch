   const BinaryContext &BC = Func.getBinaryContext();
 
-  assert(BC.isAArch64() && "Unsupported arch");
-  constexpr int InsnSize = 4; // AArch64
+  assert((BC.isAArch64() || BC.isARM()) && "Unsupported arch");
