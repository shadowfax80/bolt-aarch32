-    Manager.registerPass(std::make_unique<LongJmpPass>(PrintLongJmp));
-
     Manager.registerPass(
         std::make_unique<PointerAuthCFIFixup>(PrintPAuthCFIFixup));
   }
 
+  // Tighten branches according to offset differences between branch and
+  // targets. Shared by AArch64 and AArch32 (ARM-mode veneers / LongJmp).
+  if (BC.isAArch64() || BC.isARM()) {
+    Manager.registerPass(std::make_unique<LongJmpPass>(PrintLongJmp));
+  }
+
   // This pass should always run last.*
   Manager.registerPass(std::make_unique<FinalizeFunctions>(PrintFinalized));
 
diff --git a/bolt/test/ARM/Inputs/arm32-far-bl.s b/bolt/test/ARM/Inputs/arm32-far-bl.s
new file mode 100644
index 000000000000..99d55c0c11e9
--- /dev/null
+++ b/bolt/test/ARM/Inputs/arm32-far-bl.s
@@ -0,0 +1,18 @@
+	.syntax unified
+	.arm
+	.section .text.start,"ax",%progbits
+	.globl _start
+	.type _start, %function
+_start:
+	bl	far_away
+	mov	r0, #42
+	mov	r7, #1
+	svc	#0
+	.size	_start, .-_start
+
+	.section .text.far,"ax",%progbits
+	.globl	far_away
+	.type	far_away, %function
+far_away:
+	bx	lr
+	.size	far_away, .-far_away
diff --git a/bolt/test/ARM/Inputs/arm32-far.ld b/bolt/test/ARM/Inputs/arm32-far.ld
new file mode 100644
index 000000000000..e245199cfb74
--- /dev/null
+++ b/bolt/test/ARM/Inputs/arm32-far.ld
@@ -0,0 +1,9 @@
+ENTRY(_start)
+SECTIONS {
+  . = 0x10000;
+  .text : {
+    *(.text.start)
+    . = . + 0x2100000;
+    *(.text.far)
+  }
+}
diff --git a/bolt/test/ARM/arm-longjmp-veneer.test b/bolt/test/ARM/arm-longjmp-veneer.test
new file mode 100644
index 000000000000..d7c3c0b33271
--- /dev/null
+++ b/bolt/test/ARM/arm-longjmp-veneer.test
@@ -0,0 +1,22 @@
+## Out-of-range ARM BL: drop the linker veneer, then LongJmp emits movw/movt/bx.
+
+# REQUIRES: system-linux
+
+RUN: llvm-mc -filetype=obj -triple=armv7-unknown-linux-gnueabi %p/Inputs/arm32-far-bl.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32-far.ld %t.o -o %t.exe
+RUN: llvm-bolt %t.exe -o %t.bolt --pad-funcs-before=far_away:0x2100000 2>&1 | FileCheck %s --check-prefix=LOG
+RUN: llvm-readelf -h %t.bolt | FileCheck %s --check-prefix=HDR
+RUN: llvm-objdump -d --start-address=0x2400000 --stop-address=0x2400020 %t.bolt | FileCheck %s --check-prefix=ASM
+
+LOG: BOLT-INFO: number of removed linker-inserted veneers: {{[1-9][0-9]*}}
+LOG: BOLT-INFO: Inserted {{[1-9][0-9]*}} stubs
+LOG-NOT: BOLT-ERROR
+
+HDR: Entry point address: 0x2400000
+
+;; Stub at _start+0x10: MOVW ip / MOVT ip / BX ip (objdump may lack $a).
+ASM: 2400000:
+ASM: bl
+ASM: {{e300c|movw}}
+ASM: {{e340c|movt}}
+ASM: {{e12fff1c|bx}}
