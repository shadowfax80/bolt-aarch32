diff --git a/bolt/test/ARM/Inputs/arm32-add-bl.s b/bolt/test/ARM/Inputs/arm32-add-bl.s
new file mode 100644
index 000000000000..787a68ef3fd9
--- /dev/null
+++ b/bolt/test/ARM/Inputs/arm32-add-bl.s
@@ -0,0 +1,14 @@
+	.syntax unified
+	.arm
+	.text
+	.global _start
+	.type _start, %function
+_start:
+	add r0, r0, #1
