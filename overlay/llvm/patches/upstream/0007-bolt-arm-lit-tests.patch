diff --git a/bolt/test/ARM/Inputs/arm32-interwork.s b/bolt/test/ARM/Inputs/arm32-interwork.s
new file mode 100644
index 000000000000..43e129c306a6
--- /dev/null
+++ b/bolt/test/ARM/Inputs/arm32-interwork.s
@@ -0,0 +1,39 @@
+	.syntax unified
+	.text
+	.global _start
+	.type _start, %function
+	.arm
+_start:
+	@ ARM caller → Thumb callee (must encode BLX / survive identity rewrite)
+	blx thumb_add1
+	@ r0 should be 43
+	cmp r0, #43
+	bne .Lfail
+	blx thumb_to_arm
+	cmp r0, #42
+	bne .Lfail
+	mov r0, #0
+	bx lr
+.Lfail:
+	mov r0, #1
+	bx lr
+
+	.thumb
+	.thumb_func
+	.type thumb_add1, %function
+thumb_add1:
+	adds r0, #1
+	bx lr
+
+	.thumb_func
+	.type thumb_to_arm, %function
+thumb_to_arm:
+	@ Thumb caller → ARM callee
+	blx arm_ret42
+	bx lr
+
+	.arm
+	.type arm_ret42, %function
+arm_ret42:
+	mov r0, #42
+	bx lr
