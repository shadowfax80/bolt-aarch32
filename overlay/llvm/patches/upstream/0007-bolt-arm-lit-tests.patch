diff --git a/bolt/test/ARM/Inputs/arm32-thumb-it.s b/bolt/test/ARM/Inputs/arm32-thumb-it.s
new file mode 100644
index 000000000000..e4c5da1a791e
--- /dev/null
+++ b/bolt/test/ARM/Inputs/arm32-thumb-it.s
@@ -0,0 +1,18 @@
+	.syntax unified
+	.thumb
+	.text
+	.global _start
+	.type _start, %function
+_start:
+	@ Force a real IT / ITE bundle (Thumb-2). Identity rewrite must keep
+	@ the IT header adjacent to its body — never split or insert between.
+	movs r0, #0
+	cmp r0, #0
+	ite eq
+	moveq r1, #1
+	movne r1, #2
+	cmp r0, #1
+	itt ne
+	addne r2, r2, #1
+	addne r2, r2, r0
+	bx lr
diff --git a/bolt/test/ARM/Inputs/arm32-thumb-loop.s b/bolt/test/ARM/Inputs/arm32-thumb-loop.s
