@@ -0,0 +1,12 @@
+	.syntax unified
+	.thumb
+	.text
+	.global _start
+	.type _start, %function
+_start:
+	adds r0, #1
+	b .Lloop
+.Lloop:
+	subs r0, #1
+	bne .Lloop
+	bx lr
