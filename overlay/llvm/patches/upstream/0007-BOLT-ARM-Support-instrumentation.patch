+      if (!MIB->getOffset(*LastInstr))
         continue;
-      FromOffset = *BC.MIB->getOffset(*LastInstr);
+      FromOffset = *MIB->getOffset(*LastInstr);
 
       // Do not instrument edges in the spanning tree
       auto STIt = STOutSet.find(&BB);
