index 000000000000..67c5ce1e02f7
--- /dev/null
+++ b/bolt/test/ARM/Inputs/arm32-thumb-loop.s
@@ -0,0 +1,12 @@
+	.syntax unified
+	.thumb
+	.text
+	.global _start
+	.type _start, %function
+_start:
+	adds r0, #1
+	b .Lloop
+.Lloop:
+	subs r0, #1
+	bne .Lloop
+	bx lr
