diff --git a/bolt/test/ARM/arm-disasm.test b/bolt/test/ARM/arm-disasm.test
new file mode 100644
index 000000000000..d8eba72e2c8a
--- /dev/null
+++ b/bolt/test/ARM/arm-disasm.test
@@ -0,0 +1,11 @@
+## Disassemble a tiny ARM-mode function.
+
+RUN: %clang --target=armv7-none-eabi -c -o %t.o %p/Inputs/arm32-add-bl.s
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+RUN: llvm-bolt --print-disasm -o %t.out %t.exe 2>&1 | FileCheck %s
+
+CHECK: Binary Function "_start
+CHECK: add
+CHECK: bl
+CHECK: b
+CHECK-NOT: BOLT-ERROR
diff --git a/bolt/test/ARM/arm-longjmp-veneer.test b/bolt/test/ARM/arm-longjmp-veneer.test
new file mode 100644
index 000000000000..d7c3c0b33271
--- /dev/null
+++ b/bolt/test/ARM/arm-longjmp-veneer.test
@@ -0,0 +1,22 @@
+## Out-of-range ARM BL: drop the linker veneer, then LongJmp emits movw/movt/bx.
+
+# REQUIRES: system-linux
+
+RUN: llvm-mc -filetype=obj -triple=armv7-unknown-linux-gnueabi %p/Inputs/arm32-far-bl.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32-far.ld %t.o -o %t.exe
+RUN: llvm-bolt %t.exe -o %t.bolt --pad-funcs-before=far_away:0x2100000 2>&1 | FileCheck %s --check-prefix=LOG
+RUN: llvm-readelf -h %t.bolt | FileCheck %s --check-prefix=HDR
+RUN: llvm-objdump -d --start-address=0x2400000 --stop-address=0x2400020 %t.bolt | FileCheck %s --check-prefix=ASM
+
+LOG: BOLT-INFO: number of removed linker-inserted veneers: {{[1-9][0-9]*}}
+LOG: BOLT-INFO: Inserted {{[1-9][0-9]*}} stubs
+LOG-NOT: BOLT-ERROR
+
+HDR: Entry point address: 0x2400000
+
+;; Stub at _start+0x10: MOVW ip / MOVT ip / BX ip (objdump may lack $a).
+ASM: 2400000:
+ASM: bl
+ASM: {{e300c|movw}}
+ASM: {{e340c|movt}}
+ASM: {{e12fff1c|bx}}
diff --git a/bolt/test/ARM/arm-rewrite.test b/bolt/test/ARM/arm-rewrite.test
new file mode 100644
index 000000000000..4287465c69bb
--- /dev/null
+++ b/bolt/test/ARM/arm-rewrite.test
@@ -0,0 +1,12 @@
+## Identity rewrite of ARM-mode ET_EXEC.
+
+RUN: %clang --target=armv7-none-eabi -c -o %t.o %p/Inputs/arm32-add-bl.s
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+RUN: llvm-bolt %t.exe -o %t.bolt 2>&1 | FileCheck %s --check-prefix=CHECK-RUN
+RUN: llvm-readelf -h %t.bolt | FileCheck %s --check-prefix=CHECK-ELF
+RUN: llvm-objdump -d %t.bolt | FileCheck %s --check-prefix=CHECK-ASM
+
+CHECK-RUN-NOT: BOLT-ERROR
+CHECK-ELF: Type: EXEC
+CHECK-ASM: add
+CHECK-ASM: bl
diff --git a/bolt/test/ARM/elf32-parse.test b/bolt/test/ARM/elf32-parse.test
new file mode 100644
index 000000000000..ae4cf2b67318
--- /dev/null
+++ b/bolt/test/ARM/elf32-parse.test
@@ -0,0 +1,9 @@
+## Verify that BOLT accepts ARM32 ELF executables and lists sections.
+
+RUN: llvm-mc -filetype=obj -triple=armv7-unknown-linux-gnueabi %p/Inputs/arm32-add-bl.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+RUN: llvm-bolt --print-sections -o %t.out %t.exe 2>&1 | FileCheck %s
+
+CHECK: BOLT-INFO: Sections from original binary
+CHECK: .text
+CHECK-NOT: BOLT-ERROR: Unrecognized machine in ELF file
diff --git a/bolt/test/ARM/lit.local.cfg b/bolt/test/ARM/lit.local.cfg
new file mode 100644
index 000000000000..52810609fb5d
--- /dev/null
+++ b/bolt/test/ARM/lit.local.cfg
@@ -0,0 +1,9 @@
+if 'ARM' not in config.root.targets:
+    config.unsupported = True
+
+flags = '--target=armv7-none-eabi -nostdlib -ffreestanding -Wl,--emit-relocs'
+thumb_flags = '--target=thumbv7-none-eabi -nostdlib -ffreestanding -Wl,--emit-relocs'
+
+config.substitutions.insert(0, ('%cflags', f'%cflags {flags}'))
+config.substitutions.insert(0, ('%cxxflags', f'%cxxflags {flags}'))
+config.substitutions.insert(0, ('%clang', config.clang.replace('clang', 'clang') if config.clang else 'clang'))
diff --git a/bolt/test/ARM/thumb-rewrite.test b/bolt/test/ARM/thumb-rewrite.test
new file mode 100644
index 000000000000..2adc0038e009
--- /dev/null
+++ b/bolt/test/ARM/thumb-rewrite.test
@@ -0,0 +1,15 @@
+## Identity rewrite of Thumb-2 ET_EXEC (no IT).
+
+RUN: llvm-mc -filetype=obj -triple=thumbv7-unknown-linux-gnueabi %p/Inputs/arm32-thumb-loop.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+RUN: llvm-bolt %t.exe -o %t.bolt 2>&1 | FileCheck %s --check-prefix=CHECK-LOG
+RUN: llvm-readelf -h %t.bolt | FileCheck %s --check-prefix=CHECK-ELF
+RUN: llvm-objdump -s --section=.text %t.bolt | FileCheck %s --check-prefix=CHECK-ASM
+
+CHECK-LOG: BOLT: {{[1-9][0-9]*}} out of {{[0-9]+}} functions were overwritten
+CHECK-LOG-NOT: BOLT-ERROR
+CHECK-LOG-NOT: unable to disassemble
+CHECK-ELF: Type: EXEC
+# Raw .text must keep Thumb adds (0x3001) and bx lr (0x4770).
+CHECK-ASM: 0130
+CHECK-ASM: 7047
