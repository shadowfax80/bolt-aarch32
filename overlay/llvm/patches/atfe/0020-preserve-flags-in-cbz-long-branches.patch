diff --git a/bolt/test/ARM/Inputs/check-cbz-flags.py b/bolt/test/ARM/Inputs/check-cbz-flags.py
new file mode 100644
--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-cbz-flags.py
@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+"""Check the emitted Thumb instruction sequence despite odd $t mapping symbols."""
+import re
+import subprocess
+import sys
+
+mc, readelf, image, map_path = sys.argv[1:]
+sections = subprocess.check_output([readelf, '--sections', image], text=True)
+text = re.search(r'\[\s*\d+\]\s+\.text\s+\S+\s+([0-9a-fA-F]+)\s+([0-9a-fA-F]+)\s+([0-9a-fA-F]+)', sections)
+assert text, 'missing .text section'
+base, file_off, _ = (int(part, 16) for part in text.groups())
+with open(image, 'rb') as fh:
+    data = fh.read()
+entries = {}
+for line in open(map_path, encoding='utf-8'):
+    name, _old, new, size = line.split()
+    entries[name] = (int(new, 16) & ~1, int(size, 16))
+for name, inverse in [('probe', 'cbnz'), ('probe_nz', 'cbz')]:
+    addr, size = entries[name]
+    code = data[file_off + addr - base:file_off + addr - base + size]
+    result = subprocess.run([mc, '--disassemble', '--triple=thumbv7-none-eabi'],
+        input=' '.join('0x%02x' % byte for byte in code),
+        text=True, capture_output=True, check=True)
+    insns = [line.strip() for line in result.stdout.splitlines() if line.strip()]
+    assert re.search(r'^cmp\s+r1, #0$', insns[0]), (name, insns)
+    assert re.search(r'^' + inverse + r'\s+r0, #2$', insns[1]), (name, insns)
+    assert re.search(r'^b\.w\s+#8$', insns[2]), (name, insns)
+    assert re.search(r'^bne\s+', insns[3]), (name, insns)
+    assert all(not line.startswith('cmp') for line in insns[1:]), (name, insns)
+    print(name + ': flags preserved, nearby skip and original target checked')
