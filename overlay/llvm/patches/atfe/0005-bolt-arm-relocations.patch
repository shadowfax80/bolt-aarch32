+static uint64_t encodeValueARM(uint32_t Type, uint64_t Value, uint64_t PC) {
+  switch (Type) {
+  default:
+    llvm_unreachable("unsupported relocation");
+  case ELF::R_ARM_ABS32:
+  case ELF::R_ARM_MOVW_ABS_NC:
+  case ELF::R_ARM_MOVT_ABS:
+  case ELF::R_ARM_THM_MOVW_ABS_NC:
+  case ELF::R_ARM_THM_MOVT_ABS:
+  case ELF::R_ARM_TARGET1:
+  case ELF::R_ARM_TARGET2:
+    break;
+  case ELF::R_ARM_REL32:
+  case ELF::R_ARM_PREL31:
+    Value -= PC;
+    break;
+  case ELF::R_ARM_PC24:
+  case ELF::R_ARM_PLT32:
+  case ELF::R_ARM_JUMP24:
+    // Unconditional B (A1): imm24 = offset/4.
+    Value -= PC;
+    Value = ((Value >> 2) & 0x00ffffffULL) | 0xea000000ULL;
+    break;
+  case ELF::R_ARM_CALL:
+    // Unconditional BL (A1).
+    Value -= PC;
+    Value = ((Value >> 2) & 0x00ffffffULL) | 0xeb000000ULL;
+    break;
+  case ELF::R_ARM_THM_CALL:
+  case ELF::R_ARM_THM_JUMP24: {
+    // Thumb BL T1 / B T4 with J1J2 encoding. Layout matches AArch64's approach
+    // of emitting a full instruction word (pending reloc pwrites the result).
+    // Thumb bit is ISA metadata, not part of the branch displacement. PC for
+    // Thumb is addr+4 (BOLT passes the instruction address as PC).
+    Value &= ~1ULL;
+    Value -= (PC + 4);
+    const uint32_t S = (Value >> 14) & 0x0400;
+    const uint32_t J1 = (((~(Value >> 10)) ^ (Value >> 11)) & 0x2000);
+    const uint32_t J2 = (((~(Value >> 11)) ^ (Value >> 13)) & 0x0800);
+    const uint32_t Imm10 = (Value >> 12) & 0x03ff;
+    const uint32_t Imm11 = (Value >> 1) & 0x07ff;
+    const uint16_t Hi = 0xf000 | S | Imm10;
+    // BL: 11 J1 1 J2 Imm11; B.W: 10 J1 0 J2 Imm11
+    const uint16_t LoBase =
+        (Type == ELF::R_ARM_THM_CALL) ? 0xd000 : 0x9000;
+    const uint16_t Lo = LoBase | J1 | J2 | Imm11;
+    Value = Hi | (static_cast<uint64_t>(Lo) << 16);
+    break;
+  }
+  }
+  return Value;
+}
+
+static bool canEncodeValueARM(uint32_t Type, uint64_t Value, uint64_t PC) {
+  switch (Type) {
+  default:
+    return true;
+  case ELF::R_ARM_CALL:
+  case ELF::R_ARM_JUMP24:
+    return isInt<26>(Value - PC);
+  case ELF::R_ARM_THM_CALL:
+  case ELF::R_ARM_THM_JUMP24:
+    return isInt<25>(Value - PC);
+  }
+}
+
+static uint64_t extractValueARM(uint32_t Type, uint64_t Contents,
+                                uint64_t PC) {
+  switch (Type) {
+  default:
+    return Contents;
+  case ELF::R_ARM_ABS32:
+    return Contents;
+  case ELF::R_ARM_REL32:
+  case ELF::R_ARM_PC24:
+  case ELF::R_ARM_PLT32:
+  case ELF::R_ARM_PREL31:
+    return static_cast<int64_t>(PC) + SignExtend64<32>(Contents);
+  case ELF::R_ARM_CALL:
+  case ELF::R_ARM_JUMP24: {
+    uint64_t Imm = Contents & 0x00ffffff;
+    return static_cast<int64_t>(PC) + SignExtend64<26>(Imm << 2);
+  }
+  case ELF::R_ARM_THM_CALL:
+  case ELF::R_ARM_THM_JUMP24: {
+    uint32_t S = (Contents >> 26) & 1;
+    uint32_t J1 = (Contents >> 13) & 1;
+    uint32_t J2 = (Contents >> 11) & 1;
+    uint32_t I1 = J1 ^ S ? 0 : 1;
+    uint32_t I2 = J2 ^ S ? 0 : 1;
+    uint32_t Imm10 = (Contents >> 16) & 0x3ff;
+    uint32_t Imm11 = Contents & 0x7ff;
+    uint64_t Offset = (S << 24) | (I1 << 23) | (I2 << 22) | (Imm10 << 12) |
+                      (Imm11 << 1);
+    return static_cast<int64_t>(PC) + SignExtend64<25>(Offset);
+  }
+  }
+}
