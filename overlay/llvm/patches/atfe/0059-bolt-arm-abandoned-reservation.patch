 // indirect/transitive reachability and later entry redirects are not a proof
 // that the callee stays free of probes. This intentionally rejects split
 // load/store primitives as well as calls made with a reservation outstanding.
+//
+// R15: a *return* with a live reservation (try-lock failure paths such as
+// LK's arch_spin_trylock: ldrex; cmp; strexeq; bx lr) abandons the
+// reservation. Nothing can consume it: every analyzed exclusive store must be
+// reached with a local reservation on all paths (checked below), so it is
+// admitted when a raw scan finds no exclusive store outside analyzed
+// functions. Calls and branches out with a live reservation stay rejected.
+static Error findUnanalyzedExclusiveStore(BinaryContext &BC,
+                                          uint64_t &Address) {
+  for (BinarySection &Section : BC.textSections()) {
+    if (!Section.getSize())
+      continue;
+    const uint64_t Start = Section.getAddress(), End = Start + Section.getSize();
+    std::vector<std::pair<uint64_t, uint64_t>> Covered;
+    for (auto &It : BC.getBinaryFunctions()) {
+      const BinaryFunction &BF = It.second;
+      if (BF.getSize() && BF.getAddress() < End &&
+          BF.getAddress() + BF.getSize() > Start)
+        Covered.emplace_back(BF.getAddress(), BF.getAddress() + BF.getSize());
+    }
+    llvm::sort(Covered);
+    ArrayRef<uint8_t> Bytes = arrayRefFromStringRef(Section.getContents());
+    auto scanGap = [&](uint64_t Lo, uint64_t Hi) -> bool {
+      for (uint64_t A = alignTo(Lo, 2); A + 2 <= Hi; A += 2) {
+        for (const bool Thumb : {true, false}) {
+          if (!Thumb && (A % 4 || A + 4 > Hi))
+            continue;
+          MCDisassembler *Decoder = Thumb ? BC.ThumbDisAsm.get() : BC.DisAsm.get();
+          MCInst Inst;
+          uint64_t Size = 0;
+          if (Decoder->getInstruction(Inst, Size, Bytes.slice(A - Start, Hi - A),
+                                      A, nulls()) != MCDisassembler::Success)
+            continue;
+          if (BC.getMIBFor(Thumb)->getExclusiveMemoryAccessKind(Inst) ==
+              MCPlusBuilder::ExclusiveMemoryAccessKind::Store) {
+            Address = A;
+            return true;
+          }
+        }
+      }
+      return false;
+    };
+    uint64_t Cursor = Start;
+    for (const auto &[Lo, Hi] : Covered) {
+      if (Lo > Cursor && scanGap(Cursor, std::min(Lo, End)))
+        return Error::success();
+      Cursor = std::max(Cursor, Hi);
+    }
+    if (Cursor < End && scanGap(Cursor, End))
+      return Error::success();
+  }
+  Address = 0;
+  return Error::success();
+}
