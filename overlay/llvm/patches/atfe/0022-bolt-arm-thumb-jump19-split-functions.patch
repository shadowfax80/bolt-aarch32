@@ -0,0 +1,56 @@
+# Conditional Thumb-2 branch B<c>.W (T3) with R_ARM_THM_JUMP19: target encoded
+# relative to PC (= address + 4), condition field preserved, both directions.
+#
+# RUN: llvm-mc -triple=thumbv7-linux-gnueabi -arm-add-build-attributes -filetype=obj -o %t.o %s
+# RUN: llvm-objdump -r %t.o | FileCheck --check-prefix=CHECK-TYPE %s
+# RUN: llvm-jitlink -noexec -slab-address 0x76ff0000 -slab-allocate 10Kb \
+# RUN:              -slab-page-size 4096 -check %s %t.o
+
+	.syntax unified
+	.thumb
+
+	.section .text.back,"ax",%progbits
+	.globl	back_target
+	.type	back_target,%function
+	.p2align	1
+	.thumb_func
+back_target:
+	bx	lr
+	.size	back_target, .-back_target
+
+	.text
+# CHECK-TYPE: {{[0-9a-f]+}} R_ARM_THM_JUMP19 fwd_target
+# CHECK-TYPE: {{[0-9a-f]+}} R_ARM_THM_JUMP19 back_target
+# jitlink-check: decode_operand(fwd_site, 0) = fwd_target - next_pc(fwd_site)
+# jitlink-check: decode_operand(back_site, 0) = back_target - next_pc(back_site)
+# The condition (NE = 1, GT = 0xc) sits in bits 6-9 of the first halfword.
+# jitlink-check: (*{2}fwd_site) & 0x03c0 = 0x0040
+# jitlink-check: (*{2}back_site) & 0x03c0 = 0x0300
+	.globl	main
+	.type	main,%function
+	.p2align	1
+	.thumb_func
+main:
+	.globl	fwd_site
+	.type	fwd_site,%function
+	.thumb_func
+fwd_site:
+	bne.w	fwd_target
+	.size	fwd_site, 4
+	.globl	back_site
+	.type	back_site,%function
+	.thumb_func
+back_site:
+	bgt.w	back_target
+	.size	back_site, 4
+	bx	lr
+	.size	main, .-main
+
+	.section .text.fwd,"ax",%progbits
+	.globl	fwd_target
+	.type	fwd_target,%function
+	.p2align	1
+	.thumb_func
+fwd_target:
+	bx	lr
+	.size	fwd_target, .-fwd_target
--- /dev/null
+++ b/bolt/test/ARM/arm-thumb-split.test
@@ -0,0 +1,18 @@
+## -split-functions on Thumb: the hot fragment's conditional branch to the cold
+## fragment is a B<c>.W (R_ARM_THM_JUMP19) and must reach the cold fragment
+## directly. Before the fix JITLink rejected relocation 51, and then routed the
+## branch through an ARM-state interworking stub because the fragment symbol
+## ("kernel.cold.0") was not known to be Thumb.
+RUN: llvm-mc -triple=thumbv7-none-eabi -filetype=obj %p/Inputs/arm32-thumb-split.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+RUN: llvm-bolt %t.exe -o %t.bolt --no-huge-pages --data %p/Inputs/arm32-thumb-split.fdata \
+RUN:   -split-functions -split-all-cold -reorder-blocks=ext-tsp
+RUN: llvm-nm %t.bolt > %t.syms
+RUN: llvm-objdump -d --triple=thumbv7a-none-eabi %t.bolt > %t.dis
+RUN: cat %t.syms %t.dis | FileCheck %s
+
+CHECK: {{0*}}[[COLD:[1-9a-f][0-9a-f]*]] t kernel.cold.0
+CHECK: <kernel>:
+CHECK: bne.w 0x[[COLD]] <kernel.cold.0>
+CHECK: <kernel.cold.0>:
+CHECK-NEXT: adds r0, #0x2
--- /dev/null
+++ b/bolt/test/ARM/Inputs/arm32-thumb-split.s
@@ -0,0 +1,29 @@
+# Thumb function with a hot path and a cold path, for -split-functions.
+	.syntax unified
+	.thumb
+	.text
+	.globl	_start
+	.type	_start,%function
+	.p2align	1
+	.thumb_func
+_start:
+	movs	r0, #0
+	bl	kernel
+	b	_start
+	.size	_start, .-_start
+
+	.globl	kernel
+	.type	kernel,%function
+	.p2align	1
+	.thumb_func
+kernel:
+	cmp	r0, #0
+	bne	cold_path
+	movs	r0, #1
+	bx	lr
+cold_path:
+	adds	r0, #2
+	adds	r0, #3
+	adds	r0, #4
+	bx	lr
+	.size	kernel, .-kernel
