+    // R22: a register-list load defines every listed register, but not every
+    // LDM form marks its list as definitions (the privileged/user-bank
+    // `ldm rN, {...}^` does not), so hasDefOfPhysReg alone misses it. Treat
+    // any variadic load naming the base in its list as a redefinition.
+    auto ListLoadDefines = [&](const MCInst &Inst) {
+      const MCInstrDesc &Desc = BC.MII->get(Inst.getOpcode());
+      if (!Desc.isVariadic() || !Desc.mayLoad())
+        return false;
+      // Operands: [writeback defs], Rn, pred, pred-reg, then the register list
+      // (its first entry is a declared operand, the rest are variadic).
+      for (unsigned I = Desc.getNumDefs() + 3, E = Inst.getNumOperands(); I < E;
+           ++I)
+        if (Inst.getOperand(I).isReg() &&
+            BC.MRI->isSubRegisterEq(BaseReg, Inst.getOperand(I).getReg()))
+          return true;
+      return false;
