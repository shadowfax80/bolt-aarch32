--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-arm-it-isolation.py
@@ -0,0 +1,70 @@
+"""R11: a Thumb function cut off inside an IT block must not change the
+admission of the independent functions that follow (or precede) it. The
+admission report must reject only the truncated function and treat every
+clean function exactly as in the control image, whatever the order."""
+from pathlib import Path
+import json
+import shutil
+import subprocess
+import sys
+import tempfile
+
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+HEADER = '''.syntax unified
+.arch armv7-a
+.text
+.arm
+.global _start
+.type _start,%function
+_start:
+push {r4,lr}
+bl good_thumb
+pop {r4,pc}
+.size _start,.-_start
+'''
+
+
+def fn(name, body, isa='thumb'):
+    return (f'.balign 4\n.{isa}\n.global {name}\n.type {name},%function\n'
+            + ('.thumb_func\n' if isa == 'thumb' else '') + f'{name}:\n{body}\n.size {name},.-{name}\n')
+
+
+GOOD = fn('good_thumb', 'bx lr') + fn('another_good', 'bx lr') + fn('last_arm', 'bx lr', 'arm')
+BAD = {'itt': fn('bad_it', '.hword 0xbf04\n.hword 0x2001'),   # itt eq; movs r0,#1; <end>
+       'ite': fn('bad_it', '.hword 0xbf0c\n.hword 0x2001')}   # ite eq; movs r0,#1; <end>
+CASES = {'control': GOOD,
+         'itt-before': BAD['itt'] + GOOD, 'ite-before': BAD['ite'] + GOOD,
+         'itt-after': GOOD + BAD['itt'], 'ite-after': GOOD + BAD['ite']}
+
+
+def admission(name, body):
+    d = out / name
+    d.mkdir()
+    (d / 'in.s').write_text(HEADER + body)
+    (d / 'in.ld').write_text('ENTRY(_start)\nSECTIONS { . = 0x8000; .text : { *(.text*) } }\n')
+    for cmd in ([tc / 'llvm-mc', '-triple=armv7-none-eabi', '-arm-add-build-attributes', '-filetype=obj',
+                 d / 'in.s', '-o', d / 'in.o'],
+                [tc / 'ld.lld', '--emit-relocs', '-T', d / 'in.ld', d / 'in.o', '-o', d / 'in.elf']):
+        subprocess.run([str(x) for x in cmd], check=True, capture_output=True)
+    p = subprocess.run([str(tc / 'llvm-bolt'), str(d / 'in.elf'), '-o', '/dev/null', '--no-huge-pages',
+                        '-lite=0', '--arm-admission-report=' + str(d / 'report.json')],
+                       capture_output=True, text=True, timeout=60)
+    (d / 'run.log').write_text(p.stdout + p.stderr)
+    report = json.loads((d / 'report.json').read_text())
+    return {f['name']: f['status'] for f in report['functions']}
+
+
+results = {name: admission(name, body) for name, body in CASES.items()}
+control = results['control']
+bad = 0
+for name, got in results.items():
+    clean = {k: v for k, v in got.items() if k != 'bad_it'}
+    ok = clean == control and (name == 'control' or got.get('bad_it') not in (None, control.get('good_thumb')))
+    print(f"{'PASS' if ok else 'FAIL'}: {name}: {got}")
+    bad += not ok
+sys.exit(1 if bad else 0)
--- /dev/null
+++ b/bolt/test/ARM/arm-it-isolation.test
@@ -0,0 +1,5 @@
+## R11: a Thumb function truncated inside an IT block must not change the
+## admission of independent functions before or after it.
+
+RUN: rm -rf %t.dir
+RUN: %python %p/Inputs/check-arm-it-isolation.py %t.dir
