+// Stub addresses depend on first use. Graph block iteration uses pointer
+// hashing, so visit original sections/addresses in a stable order instead.
+template <typename ManagerT>
+static void visitEdgesInAddressOrder(LinkGraph &G, ManagerT &Manager) {
+  std::vector<Block *> Worklist(G.blocks().begin(), G.blocks().end());
+  llvm::sort(Worklist, [](const Block *A, const Block *B) {
+    if (A->getSection().getOrdinal() != B->getSection().getOrdinal())
+      return A->getSection().getOrdinal() < B->getSection().getOrdinal();
+    return A->getAddress() < B->getAddress();
+  });
+  for (Block *B : Worklist)
+    for (Edge &E : B->edges())
+      Manager.visitEdge(G, B, E);
+}
+
 template <typename StubsManagerType>
 Error buildTables_ELF_aarch32(LinkGraph &G) {
   LLVM_DEBUG(dbgs() << "Visiting edges in graph:\n");
 
   StubsManagerType StubsManager;
-  visitExistingEdges(G, StubsManager);
+  visitEdgesInAddressOrder(G, StubsManager);
   aarch32::GOTBuilder GOT;
-  visitExistingEdges(G, GOT);
+  visitEdgesInAddressOrder(G, GOT);
 
   return Error::success();
 }
