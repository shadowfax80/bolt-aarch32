 size_t sectionAlignment(const jitlink::Section &Section) {
   assert(!Section.empty() && "Cannot get alignment for empty section");
+  if (Section.getName().starts_with("__llvm_jitlink_aarch32_STUBS")) {
+    // Thumb entries may come first, but later ARM entries still require
+    // word alignment. Align the section for every contained block.
+    size_t Alignment = 1;
+    for (const auto *Block : Section.blocks())
+      Alignment = std::max(Alignment, size_t(Block->getAlignment()));
+    return Alignment;
+  }
   return JITLinkLinker::orderedBlocks(Section).front()->getAlignment();
 }
 
