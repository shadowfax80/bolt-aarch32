diff --git a/bolt/test/ARM/Inputs/check-stub-determinism.py b/bolt/test/ARM/Inputs/check-stub-determinism.py
new file mode 100644
--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-stub-determinism.py
@@ -0,0 +1,46 @@
+import pathlib
+import subprocess
+import sys
+bolt = sys.argv[1:-3]
+objcopy, source, prefix = sys.argv[-3:]
+reference = None
+for run in range(8):
+    output = f"{prefix}.{run}.bolt"
+    text = f"{prefix}.{run}.text"
+    stubs = f"{prefix}.{run}.stubs"
+    mapping = f"{prefix}.{run}.map"
+    subprocess.run([*bolt, source, "-o", output,
+                    "--funcs=_start,thumb_caller,arm_second",
+                    f"--emit-function-map={mapping}"], check=True)
+    subprocess.run([objcopy, f"--dump-section=.text={text}",
+                    f"--dump-section=__llvm_jitlink_aarch32_STUBS_v7={stubs}",
+                    output], check=True)
+    code = pathlib.Path(text).read_bytes()
+    stub_code = pathlib.Path(stubs).read_bytes()
+    addresses = {}
+    for line in pathlib.Path(mapping).read_text().splitlines():
+        name, original, rewritten, size = line.split()
+        addresses[name] = int(rewritten, 16)
+    base = min(addresses.values())
+    stub_base = (base + len(code) + 3) & ~3
+    assert stub_code, "No stubs generated"
+    # Each ARM call must land on the physical start of an ARM stub, including
+    # after a halfword-aligned Thumb stub has been allocated in the section.
+    for name in ("_start", "arm_second"):
+        pc = addresses[name] + 4
+        offset = pc - base
+        word = int.from_bytes(code[offset:offset+4], "little")
+        assert word >> 24 == 0xeb, "Call lost its link bit"
+        displacement = (word & 0xffffff) << 2
+        if displacement & (1 << 25):
+            displacement -= 1 << 26
+        target = pc + 8 + displacement
+        offset = target - stub_base
+        assert 0 <= offset <= len(stub_code)-12, "Call outside stub section"
+        instruction = int.from_bytes(stub_code[offset:offset+4], "little")
+        assert instruction & 0xfff0f000 == 0xe300c000, "Call misses ARM stub start"
+    contents = (code, stub_code)
+    if reference is None:
+        reference = contents
+    elif contents != reference:
+        raise SystemExit(f"Rewritten text/stubs differ in link {run}")
diff --git a/bolt/test/ARM/arm-stub-determinism.test b/bolt/test/ARM/arm-stub-determinism.test
new file mode 100644
--- /dev/null
+++ b/bolt/test/ARM/arm-stub-determinism.test
@@ -0,0 +1,4 @@
+## Repeated links must allocate interworking stubs in a stable order.
+RUN: llvm-mc -triple=armv7-none-eabi -filetype=obj %p/Inputs/arm32-stub-order.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+RUN: %python %p/Inputs/check-stub-determinism.py llvm-bolt llvm-objcopy %t.exe %t
