@@ -0,0 +1,226 @@
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+# Group-final predicated returns and calls in Thumb IT blocks, and A32 BL<c>,
+# stay inside their block. Check the emitted bytes: every IT group keeps its
+# mask and predicated body (returns stay predicated returns), every call keeps
+# its condition and reaches the moved callee (directly or through a LongJmp
+# stub when the callee is far), in both block layouts.
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+SRC = r''' .syntax unified
+ .text
+ .arm
+ .global _start
+ .type _start,%function
+_start:
+ blx t_ret
+ blx t_pop
+ blx t_ite
+ blx t_call
+ blx t_callx
+ bl a_call
+ b _start
+ .size _start,.-_start
+
+ .global a_call
+ .type a_call,%function
+a_call:
+ push {r4, lr}
+ cmp r0, #0
+ bleq a_callee
+ add r0, r0, #3
+ pop {r4, pc}
+ .size a_call,.-a_call
+
+ .global a_callee
+ .type a_callee,%function
+a_callee:
+ add r0, r0, #1
+ bx lr
+ .size a_callee,.-a_callee
+
+ .thumb
+ .global t_ret
+ .type t_ret,%function
+ .thumb_func
+t_ret:
+ cmp r0, #0
+ it eq
+ bxeq lr
+ adds r0, #1
+ bx lr
+ .size t_ret,.-t_ret
+
+ .global t_pop
+ .type t_pop,%function
+ .thumb_func
+t_pop:
+ push {r4, lr}
+ cmp r0, #5
+ itt ne
+ movne r0, #1
+ popne {r4, pc}
+ movs r0, #2
+ pop {r4, pc}
+ .size t_pop,.-t_pop
+
+ .global t_ite
+ .type t_ite,%function
+ .thumb_func
+t_ite:
+ cmp r0, #9
+ ite eq
+ moveq r0, #3
+ bxne lr
+ adds r0, #4
+ bx lr
+ .size t_ite,.-t_ite
+
+ .global t_call
+ .type t_call,%function
+ .thumb_func
+t_call:
+ push {r4, lr}
+ cmp r0, #0
+ it ne
+ blne t_callee
+ adds r0, #1
+ pop {r4, pc}
+ .size t_call,.-t_call
+
+ .global t_callx
+ .type t_callx,%function
+ .thumb_func
+t_callx:
+ push {r4, lr}
+ cmp r0, #0
+ it gt
+ blxgt a_callee
+ adds r0, #1
+ pop {r4, pc}
+ .size t_callx,.-t_callx
+
+ .global t_callee
+ .type t_callee,%function
+ .thumb_func
+t_callee:
+ adds r0, #2
+ bx lr
+ .size t_callee,.-t_callee
+'''
+
+LD = 'ENTRY(_start)\nSECTIONS {\n  . = 0x8000;\n  .text : { *(.text*) }\n}\n'
+FUNCS = ('t_ret', 't_pop', 't_ite', 't_call', 't_callx', 'a_call')
+CALLS = {'t_call': ('blne', 't_callee'), 't_callx': ('blxgt', 'a_callee'),
+         'a_call': ('bleq', 'a_callee')}
+
+
+def run(cmd):
+    p = subprocess.run([str(x) for x in cmd], cwd=out, capture_output=True,
+                       text=True)
+    if p.returncode:
+        sys.exit(f'FAIL: {cmd[0]} exited {p.returncode}\n{p.stdout}{p.stderr}')
+    return p.stdout + p.stderr
+
+
+def disassemble(exe):
+    dis = run([tc / 'llvm-objdump', '-d', '--no-show-raw-insn', exe])
+    funcs, insts, order, cur = {}, {}, [], None
+    for line in dis.splitlines():
+        m = re.match(r'^([0-9a-f]+) <(\w+)>:', line)
+        if m:
+            cur = m.group(2)
+            funcs[cur] = int(m.group(1), 16)
+            continue
+        m = re.match(r'\s*([0-9a-f]+):\s+(\S+)\s*([^@]*)', line)
+        if m and cur:
+            a = int(m.group(1), 16)
+            insts[a] = (cur, m.group(2), m.group(3).strip())
+            order.append(a)
+    return funcs, insts, order
+
+
+def it_groups(name, insts, order):
+    """IT groups of a function as (it, mask, body) with targets removed."""
+    seq = [insts[a][1:] for a in order if insts[a][0] == name]
+    groups = []
+    for i, (mn, ops) in enumerate(seq):
+        if re.fullmatch(r'it[te]*', mn):
+            body = tuple((m, re.sub(r'0x[0-9a-f]+ <[^>]*>', '<T>', o))
+                         for m, o in seq[i + 1:i + len(mn)])
+            groups.append((mn, ops, body))
+    return sorted(groups)
+
+
+def call_dest(addr, insts, funcs, order, depth=0):
+    """Final function reached by a call, following a LongJmp stub."""
+    _, mn, ops = insts[addr]
+    m = re.search(r'<(\w+)(\+0x[0-9a-f]+)?>', ops)
+    if m and not m.group(2):
+        return m.group(1)
+    if depth > 2:
+        return None
+    # Stub: movw/movt r12, #imm; bx r12 at the call's target.
+    tgt = int(ops.split()[0], 16)
+    i = order.index(tgt)
+    lo = hi = None
+    for a in order[i:i + 3]:
+        mn2, ops2 = insts[a][1:]
+        v = re.search(r'#0x([0-9a-f]+)|#(\d+)', ops2)
+        if mn2 == 'movw' and v:
+            lo = int(v.group(1), 16) if v.group(1) else int(v.group(2))
+        if mn2 == 'movt' and v:
+            hi = int(v.group(1), 16) if v.group(1) else int(v.group(2))
+    if lo is None or hi is None:
+        return None
+    dest = ((hi << 16) | lo) & ~1
+    return next((f for f, a in funcs.items() if a == dest), None)
+
+
+(out / 'in.s').write_text(SRC)
+(out / 'in.ld').write_text(LD)
+run([tc / 'llvm-mc', '-arm-add-build-attributes', '-filetype=obj',
+     '-triple=armv7-unknown-linux-gnueabi', 'in.s', '-o', 'in.o'])
+run([tc / 'ld.lld', '--emit-relocs', '-T', 'in.ld', 'in.o', '-o', 'in.exe'])
+in_funcs, in_insts, in_order = disassemble(out / 'in.exe')
+
+bad = 0
+far = ['--pad-funcs-before=t_callee:0x2100000',
+       '--pad-funcs-before=a_callee:0x2100000']
+for mode, extra in (('default', []), ('reverse', ['--reorder-blocks=reverse']),
+                    ('far', far)):
+    log = run([tc / 'llvm-bolt', 'in.exe', '-o', f'{mode}.exe', '-lite=0',
+               '--no-huge-pages', *extra])
+    (out / f'{mode}.log').write_text(log)
+    if 'ERROR' in log:
+        print(f'FAIL: {mode}: {log[-800:]}')
+        bad += 1
+        continue
+    funcs, insts, order = disassemble(out / f'{mode}.exe')
+    for name in FUNCS:
+        moved = funcs.get(name, 0) != in_funcs[name]
+        same = it_groups(name, insts, order) == it_groups(name, in_insts, in_order)
+        ok = moved and same
+        detail = ''
+        if name in CALLS:
+            mn, callee = CALLS[name]
+            sites = [a for a in order if insts[a][0] == name and insts[a][1] == mn]
+            dest = call_dest(sites[0], insts, funcs, order) if len(sites) == 1 else None
+            ok = ok and dest == callee
+            detail = f'; {mn} reaches {dest}'
+        bad += not ok
+        print(f"{'PASS' if ok else 'FAIL'}: {mode}: {name}: moved={moved} "
+              f"IT groups unchanged={same}{detail}")
+    if mode == 'far' and 'Inserted 0 stubs' in log:
+        print('FAIL: far: no LongJmp stub inserted')
+        bad += 1
+sys.exit(1 if bad else 0)
--- /dev/null
+++ b/bolt/test/ARM/arm-predicated-returns-calls.test
@@ -0,0 +1,6 @@
+## Group-final predicated returns and calls in Thumb IT blocks, and A32 BL<c>,
+## stay inside their block: IT groups are emitted unchanged and calls keep
+## their condition and reach the moved callee, also through LongJmp stubs.
+
+RUN: rm -rf %t.dir
+RUN: %python %p/Inputs/check-arm-predicated-returns-calls.py %t.dir
