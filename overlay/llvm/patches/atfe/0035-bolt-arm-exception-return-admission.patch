+TEST_F(ARMReturns, ExceptionReturnsCannotBypassPCWriteAdmission) {
+  struct Case { bool Thumb; std::vector<uint8_t> Bytes; };
+  const Case Cases[] = {
+      {false, {0x00,0x0a,0x13,0xf8}}, // arm_rfeda
+      {false, {0x00,0x0a,0x33,0xf8}}, // arm_rfeda_wb
+      {false, {0x00,0x0a,0x13,0xf9}}, // arm_rfedb
+      {false, {0x00,0x0a,0x33,0xf9}}, // arm_rfedb_wb
+      {false, {0x00,0x0a,0x93,0xf8}}, // arm_rfeia
+      {false, {0x00,0x0a,0xb3,0xf8}}, // arm_rfeia_wb
+      {false, {0x00,0x0a,0x93,0xf9}}, // arm_rfeib
+      {false, {0x00,0x0a,0xb3,0xf9}}, // arm_rfeib_wb
+      {true, {0x13,0xe8,0x00,0xc0}}, // thumb_rfedb
+      {true, {0x33,0xe8,0x00,0xc0}}, // thumb_rfedb_wb
+      {true, {0x93,0xe9,0x00,0xc0}}, // thumb_rfeia
+      {true, {0xb3,0xe9,0x00,0xc0}}, // thumb_rfeia_wb
+      {true, {0xde,0xf3,0x00,0x8f}}, // thumb_subs0
+      {true, {0xde,0xf3,0x04,0x8f}}, // thumb_subs4
+  };
+  for (const Case &C : Cases) {
+    SCOPED_TRACE(C.Thumb ? "Thumb" : "ARM");
+    MCInst Inst;
+    uint64_t Size = 0;
+    MCDisassembler *Decoder = C.Thumb ? BC->ThumbDisAsm.get() : BC->DisAsm.get();
+    ASSERT_EQ(Decoder->getInstruction(Inst, Size, C.Bytes, 0x1000, nulls()),
+              MCDisassembler::Success);
+    EXPECT_EQ(Size, C.Bytes.size());
+    EXPECT_TRUE(BC->getMIBFor(C.Thumb)->isUnsupportedPCWrite(Inst));
+  }
+  // Default armv7 disassembly may not decode ERET without virtualization.
+  // When enabled and decoded, its isReturn descriptor must not bypass admission.
+  MCInst ERET;
+  ERET.setOpcode(ARM::ERET);
+  EXPECT_TRUE(BC->MIB->isUnsupportedPCWrite(ERET));
+}
