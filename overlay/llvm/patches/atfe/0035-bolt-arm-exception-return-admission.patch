+from pathlib import Path
+import json, subprocess, sys, tempfile
+parent=Path(sys.argv[1]);parent.mkdir(parents=True,exist_ok=True)
+observe='--observe' in sys.argv
+out=Path(tempfile.mkdtemp(prefix='exception-',dir=parent));results=[]
+cases=[('arm',mode+wb,mode+' r3'+wb) for mode in ('rfeda','rfedb','rfeia','rfeib') for wb in ('','!')]
+cases += [('thumb',mode+wb,mode+' r3'+wb) for mode in ('rfedb','rfeia') for wb in ('','!')]
+cases += [('thumb','subs'+str(n),'subs pc,lr,#'+str(n)) for n in (0,4)]
+for isa,kind,instruction in cases:
+    d=out/(isa+'_'+kind.replace('!','_wb'));d.mkdir()
+    asm='.syntax unified\n.arch armv7-a\n.text\n.'+isa+'\n.global _start\n.type _start,%function\n'+('.thumb_func\n' if isa=='thumb' else '')+'_start:\nbl probe\nbx lr\n.size _start,.-_start\n.balign 4\n.global probe\n.type probe,%function\n'+('.thumb_func\n' if isa=='thumb' else '')+'probe:\n'+instruction+'\nmov r0,#7\nbx lr\n.size probe,.-probe\n'
+    (d/'input.s').write_text(asm);(d/'layout.ld').write_text('ENTRY(_start)\nSECTIONS { . = 0x8000; .text : { *(.text*) } }\n')
+    def run(label,cmd):
+        p=subprocess.run([str(x) for x in cmd],capture_output=True,text=True)
+        (d/(label+'.log')).write_text(p.stdout+p.stderr);return p
+    p=run('mc',['llvm-mc','-triple=armv7-none-eabi','-arm-add-build-attributes','-filetype=obj',d/'input.s','-o',d/'input.o']);assert p.returncode==0,p.stderr
+    p=run('link',['ld.lld','--emit-relocs','-T',d/'layout.ld',d/'input.o','-o',d/'input.elf']);assert p.returncode==0,p.stderr
+    for mode,options in [('normal',[]),('reverse',['--reorder-blocks=reverse']),('inline',['--force-inline=probe']),('instrument',['--instrument','--instrument-calls=false','--instrumentation-sleep-time=1','--arm-instrumentation-contract=privileged-single-core-no-fiq'])]:
+        candidate=d/(mode+'.elf')
+        p=run(mode,['llvm-bolt',d/'input.elf','-o',candidate,'--no-huge-pages','-lite=0','--funcs=probe',*options])
+        good=p.returncode==1 and 'unsupported AArch32 PC-writing control transfer' in p.stdout+p.stderr and not candidate.exists()
+        results.append(dict(isa=isa,kind=kind,mode=mode,returncode=p.returncode,output=candidate.exists(),rejected=good))
+        if not good and not observe:raise RuntimeError('exception return admitted: '+isa+' '+kind+' '+mode+'\n'+p.stdout+p.stderr)
+(out/'results.json').write_text(json.dumps(results,indent=2)+'\n')
+print('Exception return admissions:',sum(r['rejected'] for r in results),'/',len(results),'rejected;',out)
