+                << BF << " is not in the same fragment\n";
+      exit(1);
+    }
+    const MCSymbol *Dest = Target;
+    if (It->second <= BranchPos) {
+      MCSymbol *&Stub = StubFor[Target];
+      if (!Stub) {
