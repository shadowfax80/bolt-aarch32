-# Conservative: function left byte-identical rather than risk corrupting
-# a jump table BOLT can't fully decode.
-# CHECK-OUT: 00f00301 dfe801f0 02040608 0a207047
-# CHECK-OUT: 14207047 1e207047 28207047
--- /dev/null
+++ b/bolt/test/ARM/arm-inline-table.test
@@ -0,0 +1,18 @@
+## AArch32 TBB/TBH switch tables (patch 0024): decoded into CFG edges, rewritten
+## as TBH with an inline halfword table; case blocks laid out before the table
+## are reached through B.W stubs after it.
+RUN: llvm-mc -triple=thumbv7-none-eabi -filetype=obj %p/Inputs/arm32-tbb.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+RUN: llvm-bolt %t.exe -o %t.bolt --no-huge-pages -lite=0 -print-cfg -print-only=sw_tbb \
+RUN:   2>&1 | FileCheck %s --check-prefix=CFG
+RUN: %python %p/Inputs/check-inline-table.py llvm-objdump llvm-readelf llvm-objcopy %t.bolt sw_tbb 10 11 12 13 14 | FileCheck %s --check-prefix=TBB
+RUN: %python %p/Inputs/check-inline-table.py llvm-objdump llvm-readelf llvm-objcopy %t.bolt sw_tbh 20 21 22
+RUN: llvm-bolt %t.exe -o %t.rev --no-huge-pages -lite=0 -reorder-blocks=reverse
+RUN: %python %p/Inputs/check-inline-table.py llvm-objdump llvm-readelf llvm-objcopy %t.rev sw_tbb 10 11 12 13 14 | FileCheck %s --check-prefix=REV
+RUN: %python %p/Inputs/check-inline-table.py llvm-objdump llvm-readelf llvm-objcopy %t.rev sw_tbh 20 21 22
+
+CFG: IsSimple : 1
+CFG: tbh
+CFG: Successors: {{.*}}, {{.*}}, {{.*}}, {{.*}}, {{.*}}
+TBB: PASS sw_tbb: 5 entries, 0 via stubs
+REV: PASS sw_tbb: 5 entries, {{[1-5]}} via stubs
--- /dev/null
+++ b/bolt/test/ARM/Inputs/arm32-tbb.s
@@ -0,0 +1,62 @@
+@ TBB switch with an inline byte table (and a TBH one), for arm-inline-table.test.
+	.syntax unified
+	.thumb
+	.text
+	.globl	sw_tbb
+	.type	sw_tbb,%function
+	.p2align	1
+	.thumb_func
+sw_tbb:
+	cmp	r0, #4
+	bhi	9f
+	tbb	[pc, r0]
+1:	.byte	(2f-1b)/2
+	.byte	(3f-1b)/2
+	.byte	(4f-1b)/2
+	.byte	(5f-1b)/2
+	.byte	(6f-1b)/2
+	.p2align	1
+2:	movs	r0, #10
+	bx	lr
+3:	movs	r0, #11
+	bx	lr
+4:	movs	r0, #12
+	bx	lr
+5:	movs	r0, #13
+	bx	lr
+6:	movs	r0, #14
+	bx	lr
+9:	movs	r0, #99
+	bx	lr
+	.size	sw_tbb, .-sw_tbb
+
+	.globl	sw_tbh
+	.type	sw_tbh,%function
+	.p2align	1
+	.thumb_func
+sw_tbh:
+	cmp	r0, #2
+	bhi	9f
+	tbh	[pc, r0, lsl #1]
+1:	.short	(2f-1b)/2
+	.short	(3f-1b)/2
+	.short	(4f-1b)/2
+2:	movs	r0, #20
+	bx	lr
+3:	movs	r0, #21
+	bx	lr
+4:	movs	r0, #22
+	bx	lr
+9:	movs	r0, #98
+	bx	lr
+	.size	sw_tbh, .-sw_tbh
+
+	.globl	_start
+	.type	_start,%function
+	.p2align	1
+	.thumb_func
+_start:
+	bl	sw_tbb
+	bl	sw_tbh
+	b	_start
+	.size	_start, .-_start
--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-inline-table.py
@@ -0,0 +1,44 @@
+"""arm-inline-table.test checker: follow every TBH table entry (and B.W stub) in the
+BOLT output and check that index i reaches `movs r0, #<expected[i]>`."""
+import re
+import subprocess
+import sys
+
+objdump, readelf, objcopy, elf, func, *expected = sys.argv[1:]
+expected = [int(x) for x in expected]
+
+secs = subprocess.run([readelf, "-S", "-W", elf], capture_output=True, text=True, check=True).stdout
+text = next(l for l in secs.splitlines() if re.search(r"\]\s+\.text\s", l))
+addr = int(text.split()[text.split().index(".text") + 2], 16)
+subprocess.run([objcopy, "-O", "binary", "--only-section=.text", elf, elf + ".text"], check=True)
+data = open(elf + ".text", "rb").read()
+
+dis = subprocess.run([objdump, "-d", "--triple=thumbv7a-none-eabi", "-j", ".text", elf],
+                     capture_output=True, text=True, check=True).stdout
+insn = {}
+for line in dis.splitlines():
+    m = re.match(r"\s*([0-9a-f]+):\s+(?:[0-9a-f]{4} ?)+\s+(\S+)\s*(.*)", line)
+    if m:
+        insn[int(m[1], 16)] = (m[2], m[3])
+
+start = re.search(rf"^([0-9a-f]+) <{func}>:", dis, re.M)
+if not start:
+    sys.exit(f"FAIL: {func} not in output .text")
+pc = int(start[1], 16)
+tbh = next((a for a in sorted(insn) if a >= pc and insn[a][0] == "tbh"), None)
+if tbh is None:
+    sys.exit(f"FAIL: no tbh in {func}")
+table = tbh + 4
+stubs = 0
+for i, want in enumerate(expected):
+    off = table + 2 * i - addr
+    entry = data[off] | data[off + 1] << 8
+    t = table + 2 * entry
+    op, arg = insn.get(t, ("?", ""))
+    if op in ("b.w", "b"):
+        stubs += 1
+        t = int(re.search(r"0x([0-9a-f]+)", arg)[1], 16)
+        op, arg = insn.get(t, ("?", ""))
+    if op != "movs" or f"#0x{want:x}" not in arg and f"#{want}" not in arg:
+        sys.exit(f"FAIL: {func} entry {i} reaches {t:#x} {op} {arg}, want movs r0, #{want}")
+print(f"PASS {func}: {len(expected)} entries, {stubs} via stubs")
