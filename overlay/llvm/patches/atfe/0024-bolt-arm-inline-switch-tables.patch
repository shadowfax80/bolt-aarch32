+bool BinaryFunction::processInlineTableBranch(MCInst &Instruction,
+                                              uint64_t Size, uint64_t Offset) {
+  const unsigned EntrySize = BC.MIB->getInlineTableEntrySize(Instruction);
+  if (!EntrySize || Size != 4)
+    return false;
+  // Thumb PC = instruction + 4 = the first table byte. The table is the data
+  // island ($d) that starts there.
+  const uint64_t TableOffset = Offset + Size;
+  const size_t TableSize = getSizeOfDataInCodeAt(TableOffset);
+  if (!TableSize)
+    return false;
+  ErrorOr<ArrayRef<uint8_t>> Data = getData();
+  if (!Data || TableOffset + TableSize > Data->size())
+    return false;
+
+  std::vector<uint64_t> Targets;
+  for (size_t I = 0; I + EntrySize <= TableSize; I += EntrySize) {
+    uint64_t Entry = (*Data)[TableOffset + I];
+    if (EntrySize == 2)
+      Entry |= uint64_t((*Data)[TableOffset + I + 1]) << 8;
+    Targets.push_back(TableOffset + 2 * Entry);
+  }
+  // Alignment padding after a TBB table reads as entries that point back
+  // into the table itself: drop them from the end.
+  while (!Targets.empty() && Targets.back() < TableOffset + TableSize)
+    Targets.pop_back();
+  if (Targets.empty())
+    return false;
+  for (uint64_t Target : Targets)
+    if (Target < TableOffset + TableSize || Target >= getSize() ||
+        getSizeOfDataInCodeAt(Target) || (Target & 1))
+      return false;
+
+  std::vector<MCSymbol *> Labels;
+  std::set<uint64_t> Seen;
+  for (uint64_t Target : Targets) {
+    Labels.push_back(getOrCreateLocalLabel(getAddress() + Target));
+    if (Seen.insert(Target).second)
+      TakenBranches.emplace_back(Offset, Target);
+  }
+  BC.MIB->convertToHalfwordTableBranch(Instruction);
+  BC.MIB->addAnnotation(Instruction, "InlineTable",
+                        static_cast<uint32_t>(InlineTables.size()));
+  InlineTables.emplace_back(std::move(Labels));
+  return true;
+}
