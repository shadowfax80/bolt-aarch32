+        MCSymbolRefExpr::create(Dest, *BC.Ctx),
+        MCSymbolRefExpr::create(TableLabel, *BC.Ctx), *BC.Ctx);
+    Streamer.emitValue(MCBinaryExpr::createDiv(
+                           Diff, MCConstantExpr::create(2, *BC.Ctx), *BC.Ctx),
+                       2);
+  }
+  Streamer.emitLabel(TableEnd);
+  MCPlusBuilder *ThumbMIB = BC.getMIBFor(/*IsThumb=*/true);
+  const MCSubtargetInfo &ThumbSTI = BC.ThumbSTI ? *BC.ThumbSTI : *BC.STI;
+  for (auto &[Stub, Target] : Stubs) {
