+bool BinaryFunction::listLoadDefinesARM(const MCInst &Inst,
+                                        MCPhysReg Reg) const {
+  const MCInstrDesc &Desc = BC.MII->get(Inst.getOpcode());
+  if (!Desc.isVariadic() || !Desc.mayLoad())
+    return false;
+  // Operands: [writeback defs], Rn, pred, pred-reg, then the register list
+  // (its first entry is a declared operand, the rest are variadic).
+  for (unsigned I = Desc.getNumDefs() + 3, E = Inst.getNumOperands(); I < E; ++I)
+    if (Inst.getOperand(I).isReg() &&
+        BC.MRI->isSubRegisterEq(Reg, Inst.getOperand(I).getReg()))
+      return true;
+  return false;
+}
+
+bool BinaryFunction::isTableBaseDeadAtCases(MCPhysReg Reg,
+                                            uint64_t BranchOffset) {
+  auto BranchIt = Instructions.find(BranchOffset);
+  const std::vector<MCSymbol *> *Table =
+      BranchIt == Instructions.end() ? nullptr : getInlineTable(BranchIt->second);
+  if (!Table)
+    return false;
+  DenseMap<const MCSymbol *, uint64_t> LabelOffsets;
+  for (const auto &[Off, Sym] : Labels)
+    LabelOffsets[Sym] = Off;
+  // AAPCS: compiled code never hands a jump-table address to a callee or a
+  // caller, so a call or return ends the live range of a call-clobbered
+  // register (r0-r3, r12) unless something read it first. A callee-saved
+  // register must be restored (redefined) before a return.
+  const bool CallClobbered = BC.MIB->getAAPCSRegKindARM(Reg) != 2;
+  auto Fail = [&](const char *Why, uint64_t Off) {
+    LLVM_DEBUG(dbgs() << "BOLT-DEBUG: table base " << BC.MRI->getName(Reg)
+                      << " live at case path 0x" << Twine::utohexstr(Off)
+                      << " in " << *this << ": " << Why << "\n");
+    return false;
+  };
+  SmallVector<uint64_t, 16> Work;
+  DenseSet<uint64_t> Visited;
+  for (const MCSymbol *Label : *Table) {
+    auto L = LabelOffsets.find(Label);
+    if (L == LabelOffsets.end())
+      return false;
+    Work.push_back(L->second);
+  }
+  unsigned Budget = 4096;
+  while (!Work.empty()) {
+    uint64_t Off = Work.pop_back_val();
+    if (!Visited.insert(Off).second)
+      continue;
+    for (auto It = Instructions.find(Off);; ++It) {
+      if (It == Instructions.end() || !Budget--)
+        return Fail("end of code or budget", Off);
+      if (It->first != Off && !Visited.insert(It->first).second)
+        break;
+      const MCInst &I = It->second;
+      if (BC.MIB->hasUseOfPhysReg(I, Reg))
+        return Fail("read", It->first);
+      if ((BC.MIB->hasDefOfPhysReg(I, Reg) || listLoadDefinesARM(I, Reg)) &&
+          !BC.MIB->isPredicatedARM(I))
+        break; // Dead on this path.
+      if (const std::vector<MCSymbol *> *Nested = getInlineTable(I)) {
+        for (const MCSymbol *Label : *Nested) {
+          auto L = LabelOffsets.find(Label);
+          if (L == LabelOffsets.end())
+            return Fail("nested table target", It->first);
+          Work.push_back(L->second);
+        }
+        break;
+      }
+      const bool Exit = BC.MIB->isReturn(I) || BC.MIB->isTailCall(I);
+      if (Exit || BC.MIB->isCall(I)) {
+        if (CallClobbered)
+          break;
+        if (Exit)
+          return Fail("callee-saved base not restored", It->first);
+        continue;
+      }
+      if (BC.MIB->isBranch(I)) {
+        const MCSymbol *Target = BC.MIB->getTargetSymbol(I);
+        auto L = Target ? LabelOffsets.find(Target) : LabelOffsets.end();
+        if (L == LabelOffsets.end()) {
+          if (Target && !BC.MIB->isConditionalBranch(I) &&
+              !BC.MIB->isPredicatedARM(I) && CallClobbered)
+            break; // Tail call out of the function.
+          return Fail("unresolved branch", It->first);
+        }
+        Work.push_back(L->second);
+        if (!BC.MIB->isConditionalBranch(I) && !BC.MIB->isPredicatedARM(I))
+          break;
+      }
+      auto Next = std::next(It);
+      const unsigned Size = BC.MII->get(I.getOpcode()).getSize();
+      if (Next == Instructions.end() || !Size || Next->first != It->first + Size)
+        return Fail("data or end of function", It->first);
+    }
+  }
+  return true;
+}
