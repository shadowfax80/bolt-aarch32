@@ -0,0 +1,5 @@
+## R26: an inline-table base re-pointed at the emitted table must be dead at
+## every case target; cases that read it (on any path) are rejected.
+
+RUN: rm -rf %t.dir
+RUN: %python %p/Inputs/check-arm-table-base-liveness.py %t.dir
--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-arm-table-base-liveness.py
@@ -0,0 +1,110 @@
+"""R26: a re-pointed inline-table base (A32 `add rB, pc, #k; ldr pc, [rB,
+...]`, A32 -O0 load-then-jump, Thumb `adr rB; tbb/tbh`) holds the new table
+address after the branch. BOLT admits the table only when rB is dead at every
+case target: redefined before any read on every path. Calls and returns end
+the live range of a call-clobbered rB (AAPCS); a callee-saved rB must be
+restored before returning."""
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+HEAD = ''' .syntax unified
+ .text
+ .arm
+ .global _start
+ .type _start,%function
+_start:
+ blx sw
+ b _start
+ .size _start,.-_start
+ .global helper
+ .type helper,%function
+helper:
+ bx lr
+ .size helper,.-helper
+'''
+
+
+def a32(base, c1, c2='mov r0, #2\n bx lr'):
+    return HEAD + f''' .arm
+ .global sw
+ .type sw,%function
+sw:
+ and r2, r0, #3
+ add {base}, pc, #0
+ ldr pc, [{base}, r2, lsl #2]
+ .word c1, c2, c2, c2
+c1:
+ {c1}
+c2:
+ {c2}
+ .size sw,.-sw
+'''
+
+
+def t32(c1):
+    return HEAD + f''' .thumb
+ .global sw
+ .type sw,%function
+ .thumb_func
+sw:
+ and r1, r0, #3
+ adr.w r2, .Ltab
+ tbb [pc, r1]
+.Ltab:
+ .byte (c1-.Ltab)/2, (c2-.Ltab)/2, (c2-.Ltab)/2, (c2-.Ltab)/2
+c1:
+ {c1}
+c2:
+ movs r0, #2
+ bx lr
+ .size sw,.-sw
+'''
+
+
+WHY = 'inline jump table base read in sw'
+CASES = (
+    ('a32-dead', a32('r3', 'mov r0, #1\n bx lr'), True),
+    ('a32-read', a32('r3', 'ldr r0, [r3]\n bx lr'), False),
+    ('a32-redefined-then-read', a32('r3', 'mov r3, #5\n add r0, r3, #1\n bx lr'), True),
+    ('a32-read-after-branch', a32('r3', 'mov r0, #1\n b c3\nc3:\n add r0, r0, r3\n bx lr'), False),
+    ('a32-predicated-redefinition', a32('r3', 'cmp r0, #0\n moveq r3, #0\n add r0, r0, r3\n bx lr'), False),
+    ('a32-read-in-other-case', a32('r3', 'mov r0, #1\n bx lr', 'add r0, r3, #0\n bx lr'), False),
+    ('a32-call-ends-range', a32('r3', 'push {lr}\n bl helper\n pop {lr}\n mov r0, #1\n bx lr'), True),
+    ('a32-callee-saved-not-restored', a32('r4', 'mov r0, #1\n bx lr'), False),
+    ('a32-callee-saved-restored', a32('r4', 'pop {r4}\n bx lr', 'pop {r4}\n mov r0, #2\n bx lr'), True),
+    ('t32-dead', t32('movs r0, #1\n bx lr'), True),
+    ('t32-read', t32('ldrb r0, [r2]\n bx lr'), False),
+)
+
+
+def run(cmd, check=True):
+    p = subprocess.run([str(x) for x in cmd], cwd=out, capture_output=True, text=True)
+    if check and p.returncode:
+        sys.exit(f'FAIL: {Path(str(cmd[0])).name} exited {p.returncode}\n{p.stdout}{p.stderr}')
+    return p.returncode, p.stdout + p.stderr
+
+
+bad = 0
+(out / 'in.ld').write_text('ENTRY(_start)\nSECTIONS {\n  . = 0x8000;\n  .text : { *(.text*) }\n}\n')
+for name, src, admit in CASES:
+    (out / f'{name}.s').write_text(src)
+    run([tc / 'llvm-mc', '-arm-add-build-attributes', '-filetype=obj', '-triple=armv7-unknown-linux-gnueabi',
+         f'{name}.s', '-o', f'{name}.o'])
+    run([tc / 'ld.lld', '--emit-relocs', '-T', 'in.ld', f'{name}.o', '-o', f'{name}.exe'])
+    rc, log = run([tc / 'llvm-bolt', f'{name}.exe', '-o', f'{name}.bolt', '-lite=0', '--funcs=sw'], check=False)
+    (out / f'{name}.log').write_text(log)
+    ok = rc == 0 if admit else (rc != 0 and WHY in log)
+    print(f"{'PASS' if ok else 'FAIL'}: {name}: {'admitted' if rc == 0 else 'rejected'}")
+    if not ok:
+        print(log[-600:])
+    bad += not ok
+sys.exit(1 if bad else 0)
