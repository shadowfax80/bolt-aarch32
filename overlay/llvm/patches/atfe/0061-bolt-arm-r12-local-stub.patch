+// R8: AArch32 stubs reach their target through r12 (movw/movt r12; bx r12).
+// AAPCS lets a callee clobber r12, so stubs for calls and tail calls are fine,
+// but a stub on a local branch (e.g. hot -> cold fragment) overwrites r12 in
+// the middle of the function. Is r12 live on entry to Target? Backward
+// fixpoint over the function's CFG: an instruction that reads r12 before
+// writing it makes it live; a write or a (non-tail) call kills it; returns and
+// tail calls leave it dead; an indirect branch with unknown successors is
+// treated as a use (conservative).
+static bool isARMR12LiveIn(const BinaryFunction &BF,
+                           const BinaryBasicBlock &Target) {
+  const BinaryContext &BC = BF.getBinaryContext();
+  MCPlusBuilder *MIB = BC.getMIBFor(BF.isARMThumb());
+  unsigned R12 = 0;
+  for (unsigned Reg = 1, E = BC.MRI->getNumRegs(); Reg < E; ++Reg)
+    if (StringRef(BC.MRI->getName(Reg)).equals_insensitive("r12")) {
+      R12 = Reg;
+      break;
+    }
+  if (!R12)
+    return true;
+  struct GenKill {
+    bool Gen = false, Kill = false;
+  };
+  DenseMap<const BinaryBasicBlock *, GenKill> GK;
+  for (const BinaryBasicBlock &BB : BF) {
+    GenKill G;
+    for (const MCInst &Inst : BB) {
+      if (MIB->isPseudo(Inst) || MIB->isCFI(Inst))
+        continue;
+      // Calls and returns are handled here: the generic register queries
+      // need ABI hooks the ARM builder does not provide. Under AAPCS r12 is
+      // not an argument or return value; only an explicit operand uses it.
+      if (MIB->isCall(Inst) || MIB->isReturn(Inst)) {
+        if (!G.Kill)
+          for (const MCOperand &Op : Inst)
+            if (Op.isReg() && Op.getReg() == R12)
+              G.Gen = true;
+        if (MIB->isCall(Inst) && !MIB->isTailCall(Inst))
+          G.Kill = true;
+        continue;
+      }
+      if (!G.Kill) {
+        BitVector Src(BC.MRI->getNumRegs());
+        MIB->getSrcRegs(Inst, Src);
+        if (Src[R12] || (MIB->isIndirectBranch(Inst) && BB.succ_empty()))
+          G.Gen = true;
+      }
+      BitVector Written(BC.MRI->getNumRegs());
+      MIB->getWrittenRegs(Inst, Written);
+      if (Written[R12])
+        G.Kill = true;
+    }
+    GK[&BB] = G;
+  }
+  DenseMap<const BinaryBasicBlock *, bool> LiveIn;
+  for (bool Changed = true; Changed;) {
+    Changed = false;
+    for (const BinaryBasicBlock &BB : llvm::reverse(BF)) {
+      bool Out = false;
+      for (const BinaryBasicBlock *Succ : BB.successors())
+        Out |= LiveIn.lookup(Succ);
+      const GenKill &G = GK[&BB];
+      const bool In = G.Gen || (!G.Kill && Out);
+      if (In != LiveIn.lookup(&BB)) {
+        LiveIn[&BB] = In;
+        Changed = true;
+      }
+    }
+  }
+  return LiveIn.lookup(&Target);
+}
