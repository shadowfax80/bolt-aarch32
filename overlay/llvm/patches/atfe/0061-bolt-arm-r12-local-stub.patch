+++ b/bolt/test/ARM/Inputs/check-arm-r12-stub.py
@@ -0,0 +1,91 @@
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+# R8: a local branch (hot -> cold fragment) that needs a LongJmp stub uses
+# movw/movt r12; bx r12. When r12 is live at the cold block, BOLT must refuse
+# instead of clobbering it; when the cold block writes r12 before reading it,
+# the stub is fine and the split succeeds.
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+
+def source(isa, cold):
+    w = '.w' if isa == 'thumb' else ''
+    tf = ' .thumb_func\n' if isa == 'thumb' else ''
+    return f''' .syntax unified
+ .text
+ .arm
+ .global _start
+ .type _start,%function
+_start:
+ bl f
+ bl pad
+ b _start
+ .size _start,.-_start
+
+ .{isa}
+ .global f
+ .type f,%function
+{tf}f:
+ mov{w} r12, #5
+ cmp r0, #0
+ beq{w} .Lcold
+ add{w} r0, r0, #1
+ bx lr
+.Lcold:
+{cold}
+ bx lr
+ .size f,.-f
+
+ .arm
+ .global pad
+ .type pad,%function
+pad:
+ bx lr
+ .size pad,.-pad
+'''
+
+
+LD = 'ENTRY(_start)\nSECTIONS {\n  . = 0x10000;\n  .text : { *(.text*) }\n}\n'
+# _start's two calls are hot; f's branch to .Lcold never taken -> .Lcold cold.
+FDATA = '1 _start 0 1 f 0 0 100\n1 _start 4 1 pad 0 0 100\n'
+
+
+def run(cmd, check=True):
+    p = subprocess.run([str(x) for x in cmd], cwd=out, capture_output=True, text=True)
+    if check and p.returncode:
+        sys.exit(f'FAIL: {Path(str(cmd[0])).name} exited {p.returncode}\n{p.stdout}{p.stderr}')
+    return p.returncode, p.stdout + p.stderr
+
+
+bad = 0
+for isa, pad in (('thumb', '0x110000'), ('arm', '0x2100000')):
+    for name, cold, live in (('live', ' add r0, r0, r12', True),
+                             ('dead', ' mov r12, #7\n add r0, r0, r12', False)):
+        tag = f'{isa}-{name}'
+        (out / f'{tag}.s').write_text(source(isa, cold))
+        (out / 'in.ld').write_text(LD)
+        (out / 'prof.fdata').write_text(FDATA)
+        run([tc / 'llvm-mc', '-arm-add-build-attributes', '-filetype=obj',
+             '-triple=armv7-unknown-linux-gnueabi', f'{tag}.s', '-o', f'{tag}.o'])
+        run([tc / 'ld.lld', '--emit-relocs', '-T', 'in.ld', f'{tag}.o', '-o', f'{tag}.exe'])
+        rc, log = run([tc / 'llvm-bolt', f'{tag}.exe', '-o', f'{tag}.bolt', '--no-huge-pages',
+                       '-lite=0', '-data=prof.fdata', '--split-functions', '--split-all-cold',
+                       f'--pad-funcs-before=pad:{pad}'], check=False)
+        (out / f'{tag}.log').write_text(log)
+        split = 'f.cold' in run([tc / 'llvm-nm', f'{tag}.bolt'], check=False)[1] if rc == 0 else None
+        if live:
+            ok = rc != 0 and 'r12 is live there (R8)' in log
+        else:
+            ok = rc == 0 and split
+        print(f"{'PASS' if ok else 'FAIL'}: {tag}: rc={rc} split={split}")
+        if not ok:
+            print(log[-1500:])
+        bad += not ok
+sys.exit(1 if bad else 0)
--- /dev/null
+++ b/bolt/test/ARM/arm-r12-local-stub.test
@@ -0,0 +1,5 @@
+## R8: a LongJmp stub on a local (hot -> cold) branch uses r12. BOLT refuses when
+## r12 is live at the target block and accepts the split when it is dead.
+
+RUN: rm -rf %t.dir
+RUN: %python %p/Inputs/check-arm-r12-stub.py %t.dir
