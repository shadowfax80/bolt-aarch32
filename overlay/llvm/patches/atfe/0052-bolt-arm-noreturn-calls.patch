+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+# A function whose last instruction is a call is admitted only when the call
+# is an unconditional direct call to the primary entry of a function proven
+# not to return (no return, indirect branch or computed PC write; tail
+# branches and the final call reach proven functions; cannot run off its
+# end). Every unproven case must keep the fallthrough rejection.
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+HEAD = r''' .syntax unified
+ .text
+ .arm
+ .global _start
+ .type _start,%function
+_start:
+ bl user_arm
+ blx user_thumb
+ b _start
+ .size _start,.-_start
+'''
+
+# A32 and T32 noreturn chains: halt loops; fatal calls a returning helper,
+# then ends in a call to halt.
+CHAINS = r'''
+ .arm
+ .global halt_arm
+ .type halt_arm,%function
+halt_arm:
+ wfi
+ b halt_arm
+ .size halt_arm,.-halt_arm
+
+ .global helper_arm
+ .type helper_arm,%function
+helper_arm:
+ add r0, r0, #1
+ bx lr
+ .size helper_arm,.-helper_arm
+
+ .global fatal_arm
+ .type fatal_arm,%function
+fatal_arm:
+ push {r4, lr}
+ bl helper_arm
+ bl halt_arm
+ .size fatal_arm,.-fatal_arm
+
+ .thumb
+ .global halt_thumb
+ .type halt_thumb,%function
+ .thumb_func
+halt_thumb:
+ wfi
+ b halt_thumb
+ .size halt_thumb,.-halt_thumb
+
+ .global fatal_thumb
+ .type fatal_thumb,%function
+ .thumb_func
+fatal_thumb:
+ push {r4, lr}
+ blx helper_arm
+ bl halt_thumb
+ .size fatal_thumb,.-fatal_thumb
+'''
+
+POSITIVE = r'''
+ .arm
+ .global user_arm
+ .type user_arm,%function
+user_arm:
+ cmp r0, #0
+ beq 1f
+ bx lr
+1:
+ bl fatal_arm
+ .size user_arm,.-user_arm
+
+ .thumb
+ .global user_thumb
+ .type user_thumb,%function
+ .thumb_func
+user_thumb:
+ cmp r0, #0
+ beq 1f
+ bx lr
+1:
+ bl fatal_thumb
+ .size user_thumb,.-user_thumb
+
+ .global after_thumb
+ .type after_thumb,%function
+ .thumb_func
+after_thumb:
+ adds r0, #7
+ bx lr
+ .size after_thumb,.-after_thumb
+'''
+
+
+def negative(callee_src, last_call):
+    # user_arm ends in `last_call`; user_thumb is a plain returning function.
+    return CHAINS + callee_src + r'''
+ .arm
+ .global user_arm
+ .type user_arm,%function
+user_arm:
+ cmp r0, #0
+ beq 1f
+ bx lr
+1:
+ ''' + last_call + r'''
+ .size user_arm,.-user_arm
+
+ .global after_arm
+ .type after_arm,%function
+after_arm:
+ add r0, r0, #7
+ bx lr
+ .size after_arm,.-after_arm
+
+ .thumb
+ .global user_thumb
+ .type user_thumb,%function
+ .thumb_func
+user_thumb:
+ bx lr
+ .size user_thumb,.-user_thumb
+'''
+
+
+FIXTURES = {
+    'positive': (CHAINS + POSITIVE, None),
+    # The callee can return on one path.
+    'may-return': (negative(r'''
+ .arm
+ .global maybe
+ .type maybe,%function
+maybe:
+ cmp r0, #0
+ bxne lr
+ b halt_arm
+ .size maybe,.-maybe
+''', 'bl maybe'), 'unmodeled AArch32 function fallthrough in user_arm'),
+    # An indirect branch is not provable.
+    'indirect': (negative(r'''
+ .arm
+ .global jump
+ .type jump,%function
+jump:
+ bx r1
+ .size jump,.-jump
+''', 'bl jump'), 'unmodeled AArch32 function fallthrough in user_arm'),
+    # A conditional final call can fall through.
+    'conditional-call': (negative('', 'bleq fatal_arm'),
+                         'unmodeled AArch32 function fallthrough in user_arm'),
+    # The callee tail-branches to a returning function.
+    'tail-to-returning': (negative(r'''
+ .arm
+ .global tailer
+ .type tailer,%function
+tailer:
+ add r0, r0, #1
+ b helper_arm
+ .size tailer,.-tailer
+''', 'bl tailer'), 'unmodeled AArch32 function fallthrough in user_arm'),
+    # Mutual recursion without a base case is not taken as a proof.
+    'recursion': (negative(r'''
+ .arm
+ .global ping
+ .type ping,%function
+ping:
+ push {r4, lr}
+ bl pong
+ .size ping,.-ping
+ .global pong
+ .type pong,%function
+pong:
+ push {r4, lr}
+ bl ping
+ .size pong,.-pong
+''', 'bl ping'), 'unmodeled AArch32 function fallthrough in'),
+}
+
+LD = 'ENTRY(_start)\nSECTIONS {\n  . = 0x8000;\n  .text : { *(.text*) }\n}\n'
+
+
+def run(cmd, check=True):
+    p = subprocess.run([str(x) for x in cmd], cwd=out, capture_output=True,
+                       text=True)
+    if check and p.returncode:
+        sys.exit(f'FAIL: {cmd[0]} exited {p.returncode}\n{p.stdout}{p.stderr}')
+    return p.returncode, p.stdout + p.stderr
+
+
+bad = 0
+for name, (body, expect_error) in FIXTURES.items():
+    (out / f'{name}.s').write_text(HEAD + body)
+    (out / 'in.ld').write_text(LD)
+    run([tc / 'llvm-mc', '-arm-add-build-attributes', '-filetype=obj',
+         '-triple=armv7-unknown-linux-gnueabi', f'{name}.s', '-o', f'{name}.o'])
+    run([tc / 'ld.lld', '--emit-relocs', '-T', 'in.ld', f'{name}.o', '-o',
+         f'{name}.exe'])
+    for mode, extra in (('default', []), ('reverse', ['--reorder-blocks=reverse'])):
+        rc, log = run([tc / 'llvm-bolt', f'{name}.exe', '-o', f'{name}.{mode}.exe',
+                       '-lite=0', *extra], check=False)
+        (out / f'{name}.{mode}.log').write_text(log)
+        if expect_error:
+            ok = rc != 0 and expect_error in log and \
+                 not (out / f'{name}.{mode}.exe').exists()
+            print(f"{'PASS' if ok else 'FAIL'}: {name}/{mode}: rejected={rc != 0}")
+            bad += not ok
+            continue
+        if rc:
+            print(f'FAIL: {name}/{mode}: llvm-bolt failed\n{log[-1500:]}')
+            bad += 1
+            continue
+        _, dis = run([tc / 'llvm-objdump', '-d', '--no-show-raw-insn',
+                      f'{name}.{mode}.exe'])
+        _, fmap = run([tc / 'llvm-nm', f'{name}.{mode}.exe'])
+        syms = {l.split()[2]: int(l.split()[0], 16) & ~1
+                for l in fmap.splitlines() if len(l.split()) == 3}
+        for user, callee in (('user_arm', 'fatal_arm'),
+                             ('user_thumb', 'fatal_thumb')):
+            m = re.search(r'<' + user + r'>:\n(.*?)(?:\n\n|\Z)', dis, re.S)
+            insts = [l.split(':', 1)[1].split('@')[0].strip()
+                     for l in m.group(1).splitlines() if ':' in l] if m else []
+            # Rewritten (moved); the same four instructions in either layout:
+            # cmp, b<c>, one return, one call to the proven callee. Nothing
+            # (no return or branch) is added after the call. Trailing
+            # alignment filler is ignored.
+            body = [i for i in insts if i not in ('movs\tr0, r0', 'nop')]
+            calls = [i for i in body if re.match(r'bl\s', i)]
+            ok = syms.get(user, 0) >= 0x400000 and len(body) == 4 and \
+                 sum(i.startswith('bx') for i in body) == 1 and \
+                 len(calls) == 1 and f'<{callee}>' in calls[0]
+            print(f"{'PASS' if ok else 'FAIL'}: {name}/{mode}: {user}: "
+                  f"{'; '.join(insts)}")
+            bad += not ok
+sys.exit(1 if bad else 0)
