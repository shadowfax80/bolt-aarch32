+// AArch32 instruction that may not execute: a condition other than AL in its
+// predicate operand (IT-block bodies carry the IT condition), or a
+// compare-and-branch, which has no predicate operand.
+static bool isPredicatedARM(const BinaryContext &BC, const MCPlusBuilder &MIB,
+                            const MCInst &Inst) {
+  const int PredIdx = BC.MII->get(Inst.getOpcode()).findFirstPredOperandIdx();
+  if (PredIdx >= 0 && static_cast<unsigned>(PredIdx) < Inst.getNumOperands() &&
+      Inst.getOperand(PredIdx).isImm())
+    return Inst.getOperand(PredIdx).getImm() != 14; // ARMCC::AL
+  return MIB.isConditionalBranch(Inst);
+}
+
+bool BinaryFunction::isProvenNoReturnARM() const {
+  if (!BC.isARM() || !getSize() || isPseudo())
+    return false;
+  std::lock_guard<std::recursive_mutex> Lock(BC.ARMNoReturnMutex);
+  auto It = BC.ARMNoReturnCache.find(this);
+  if (It != BC.ARMNoReturnCache.end())
+    return It->second.value_or(false); // Recursion is not a proof.
+  BC.ARMNoReturnCache[this] = std::nullopt;
+
+  const bool Result = [&] {
+    ErrorOr<ArrayRef<uint8_t>> Data = getData();
+    if (!Data)
+      return false;
+    const bool Thumb = isARMThumb();
+    MCPlusBuilder *MIB = BC.getMIBFor(Thumb);
+    // Plain decode: the symbolic disassembler may hold another function's
+    // symbolizer while this runs from that function's disassembly.
+    MCDisassembler *DisAsm =
+        Thumb && BC.ThumbDisAsm ? BC.ThumbDisAsm.get() : BC.DisAsm.get();
+    // Only the primary entry of a proven function may be relied on.
+    auto targetNoReturn = [&](uint64_t Target) {
+      const BinaryFunction *F = BC.getBinaryFunctionAtAddress(Target);
+      return F && F->getAddress() == Target && F->isProvenNoReturnARM();
+    };
+    bool EndsInExit = false; // The last instruction cannot run off the end.
+    MCInst Inst;
+    uint64_t Size = 0;
+    for (uint64_t Offset = 0; Offset < getSize(); Offset += Size) {
+      if (const size_t DataSize = getSizeOfDataInCodeAt(Offset)) {
+        Size = DataSize;
+        continue;
+      }
+      const uint64_t Addr = getAddress() + Offset;
+      if (!DisAsm->getInstruction(Inst, Size, Data->slice(Offset), Addr,
+                                  nulls()) ||
+          !Size)
+        return false;
+      EndsInExit = false;
+      if (MIB->isReturn(Inst) || MIB->isIndirectBranch(Inst) ||
+          MIB->isUnsupportedPCWrite(Inst))
+        return false;
+      const bool Predicated = isPredicatedARM(BC, *MIB, Inst);
+      uint64_t Target = 0;
+      if (MIB->isCall(Inst)) {
+        // An indirect call returns here; a direct one may end the function.
+        if (MIB->isIndirectCall(Inst))
+          continue;
+        if (!MIB->evaluateBranch(Inst, Addr, Size, Target))
+          return false;
+        EndsInExit = !Predicated && targetNoReturn(Target & ~1ULL);
+        continue;
+      }
+      if (MIB->isBranch(Inst)) {
+        if (!MIB->evaluateBranch(Inst, Addr, Size, Target))
+          return false;
+        Target &= ~1ULL;
+        // A branch out of the function is a tail call.
+        if ((Target < getAddress() || Target >= getAddress() + getSize()) &&
+            !targetNoReturn(Target))
+          return false;
+        EndsInExit = !Predicated;
+      }
+    }
+    return EndsInExit;
+  }();
+  BC.ARMNoReturnCache[this] = Result;
+  return Result;
+}
