--- a/bolt/test/ARM/arm-thumb-entry.test
+++ b/bolt/test/ARM/arm-thumb-entry.test
@@ -0,0 +1,6 @@
+## A Thumb entry and STT_FUNC values use bit zero for ISA state. Mapping symbols
+## use the actual even code address after a function moves.
+RUN: llvm-mc -triple=thumbv7-none-eabi -filetype=obj -defsym THUMB_ENTRY=1 %p/Inputs/arm32-cbz-flags.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32-cbz-flags.ld %t.o -o %t.exe
+RUN: llvm-bolt %t.exe -o %t.bolt --no-huge-pages --emit-function-map=%t.map
+RUN: %python %p/Inputs/check-thumb-entry.py llvm-readelf %t.bolt %t.map
--- a/bolt/test/ARM/Inputs/check-thumb-entry.py
+++ b/bolt/test/ARM/Inputs/check-thumb-entry.py
@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+"""Check moved ARM/Thumb entry, function symbols, and mapping symbols."""
+
+import re
+import subprocess
+import sys
+
+
+readelf, binary, function_map = sys.argv[1:]
+header = subprocess.check_output([readelf, '-h', binary], text=True)
+symbols = subprocess.check_output([readelf, '-s', binary], text=True)
+mapping = {}
+with open(function_map, encoding='utf-8') as stream:
+    for line in stream:
+        name, old, new, size = line.split()
+        mapping[name] = (int(old, 16), int(new, 16), int(size, 16))
+
+entry_match = re.search(r'Entry point address:\s+0x([0-9a-f]+)', header)
+assert entry_match, header
+entry = int(entry_match.group(1), 16)
+assert entry == mapping['_start'][1] | 1, (entry, mapping['_start'])
+assert mapping['_start'][0] != mapping['_start'][1], mapping['_start']
+
+found = {}
+for line in symbols.splitlines():
+    match = re.match(r'\s*\d+:\s+([0-9a-f]+)\s+(\d+)\s+(\w+)\s+(\w+)\s+\w+\s+\w+\s+(\S+)', line)
+    if match:
+        value, size, kind, binding, name = match.groups()
+        found[name] = (int(value, 16), int(size), kind, binding)
+
+for name in ('_start', 'probe', 'probe_nz'):
+    old, new, size = mapping[name]
+    assert old != new, (name, mapping[name])
+    assert found[name] == (new | 1, size, 'FUNC', 'GLOBAL'), (name, found.get(name), mapping[name])
+
+assert found['$t'][0] == mapping['_start'][1], (found['$t'], mapping['_start'])
+assert found['$t'][1] == 0 and found['$t'][2] == 'NOTYPE', found['$t']
