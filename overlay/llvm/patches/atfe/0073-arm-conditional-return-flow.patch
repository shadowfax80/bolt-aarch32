+cmp r0,#0
+ittt eq
+moveq r0,r0
+addeq sp,#4
+popeq {r4,pc}
+cmp r0,#1
+beq one
+mov.w r0,#7
+add sp,#4
+pop {r4,pc}
+one: mov.w r0,#9
+add sp,#4
+pop {r4,pc}''', True))
