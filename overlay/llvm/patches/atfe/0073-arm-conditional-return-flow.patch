+from pathlib import Path
+import json
+import shutil
+import subprocess
+import sys
+import tempfile
+
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+runtime = tc.parent / 'bolt-rt-baremetal-arm/libbolt_rt_baremetal.a'
+parent = Path(sys.argv[1]); parent.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='r35-', dir=parent))
+rows = []
+qemu = shutil.which('qemu-arm')
+
+def run(label, argv, directory):
+    p = subprocess.run([str(x) for x in argv], cwd=directory, capture_output=True, text=True)
+    (directory / (label + '.log')).write_text(p.stdout + p.stderr)
+    return p
+
+driver = '''.arm
+.global _start
+.type _start,%function
+_start:
+ mov r8,sp
+ mov r4,#0
+ mov r0,#0
+ bl probe
+ mrs r5,apsr
+ and r5,r5,#0xf0000000
+ mov r6,#0x60000000
+ cmp r5,r6
+ bne bad
+ add r4,r4,r0
+ cmp sp,r8
+ bne bad
+ mov r0,#1
+ bl probe
+ mrs r5,apsr
+ and r5,r5,#0xf0000000
+ mov r6,#0x60000000
+ cmp r5,r6
+ bne bad
+ add r4,r4,r0
+ cmp sp,r8
+ bne bad
+ mov r0,#2
+ bl probe
+ mrs r5,apsr
+ and r5,r5,#0xf0000000
+ mov r6,#0x20000000
+ cmp r5,r6
+ bne bad
+ add r4,r4,r0
+ cmp sp,r8
+ bne bad
+ cmp r4,#16
+ bne bad
+ mov r0,#0
+ b exit
+bad: mov r0,#99
+exit: mov r7,#1
+ svc #0
+ b .
+.size _start,.-_start
+'''
+
+cases = []
+for kind, push, ret in [('bx', '', 'bx lr'), ('mov', '', 'mov pc,lr'),
+                       ('pop', 'push {lr}\n', 'pop {pc}'),
+                       ('ldm', 'push {r4,lr}\n', 'pop {r4,pc}')]:
+    conditional = ret.replace('bx ', 'bxeq ').replace('mov ', 'moveq ').replace('pop ', 'popeq ')
+    body = push + 'cmp r0,#0\n' + conditional + '\ncmp r0,#1\nbeq one\nmov r0,#7\n' + ret + '\none: mov r0,#9\n' + ret
+    cases.append(('arm-' + kind, '.arm\n', body, True))
