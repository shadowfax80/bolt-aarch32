+    ('arm-targeted-return', '.arm\n', 'cmp r0,#0\nbeq ret\nmov r0,#7\nret: bxeq lr\nbx lr', False),
+    ('arm-after-branch', '.arm\n', 'cmp r0,#0\nbne one\nbxeq lr\none: mov r0,#7\nbx lr', False),
+    ('thumb-mixed-ite', '.thumb\n.thumb_func\n', 'cmp r0,#0\nite eq\nmoveq r2,#3\nbxne lr\nmov.w r0,#7\nbx lr', False),
+    ('thumb-narrow-flags', '.thumb\n.thumb_func\n', 'cmp r0,#0\nitt eq\naddeq r2,r2,#1\nbxeq lr\nmov.w r0,#7\nbx lr', False),
