diff --git a/bolt/lib/Target/ARM/ARMMCPlusBuilder.cpp b/bolt/lib/Target/ARM/ARMMCPlusBuilder.cpp
--- a/bolt/lib/Target/ARM/ARMMCPlusBuilder.cpp
+++ b/bolt/lib/Target/ARM/ARMMCPlusBuilder.cpp
@@ -347,8 +347,16 @@
           !Inst.getOperand(5).isReg() || Inst.getOperand(5).getReg())
         return false;
       Reg = Inst.getOperand(0).getReg();
-      Disp = Inst.getOpcode() == ARM::ADDri ? Inst.getOperand(2).getImm()
-                                            : -Inst.getOperand(2).getImm();
+      {
+        // R24: the operand is the encoded modified immediate (imm8 rotated
+        // right by twice the 4-bit rotation field), not a byte count.
+        const unsigned Enc = Inst.getOperand(2).getImm();
+        if (Enc > 0xFFF)
+          return false;
+        const int64_t Value = llvm::rotr<uint32_t>(
+            ARM_AM::getSOImmValImm(Enc), ARM_AM::getSOImmValRot(Enc));
+        Disp = Inst.getOpcode() == ARM::ADDri ? Value : -Value;
+      }
       return Reg != ARM::PC;
     default:
       return false;
