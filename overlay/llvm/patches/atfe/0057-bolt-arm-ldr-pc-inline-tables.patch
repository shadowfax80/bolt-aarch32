+from pathlib import Path
+import re
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+
+# A32 inline jump table (clang -marm -O2): `add rB, pc, #k; ...;
+# ldr pc, [rB, rI, lsl #2]; .word case0, ...`. BOLT re-emits the table right
+# after the LDR with absolute words to the moved case blocks and points the
+# base (`adr rB`) at it. A base register clobbered before the LDR is rejected.
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+
+def fixture(clobber):
+    return r''' .syntax unified
+ .text
+ .arm
+ .global _start
+ .type _start,%function
+_start:
+ bl sw
+ b _start
+ .size _start,.-_start
+
+ .global sw
+ .type sw,%function
+sw:
+ and r2, r0, #3
+ add r3, pc, #8
+ mov r1, r0
+ ''' + ('mov r3, #0' if clobber else 'mov r0, #77') + r'''
+ ldr pc, [r3, r2, lsl #2]
+ .word 1f, 2f, 3f, 4f
+1:
+ add r0, r1, #1
+ bx lr
+2:
+ add r0, r1, #2
+ bx lr
+3:
+ add r0, r1, #3
+ bx lr
+4:
+ add r0, r1, #4
+ bx lr
+ .size sw,.-sw
+'''
+
+
+LD = 'ENTRY(_start)\nSECTIONS {\n  . = 0x8000;\n  .text : { *(.text*) }\n}\n'
+
+
+def run(cmd, check=True):
+    p = subprocess.run([str(x) for x in cmd], cwd=out, capture_output=True, text=True)
+    if check and p.returncode:
+        sys.exit(f'FAIL: {cmd[0]} exited {p.returncode}\n{p.stdout}{p.stderr}')
+    return p.returncode, p.stdout + p.stderr
+
+
+bad = 0
+for name, clobber in (('table', False), ('clobbered-base', True)):
+    (out / f'{name}.s').write_text(fixture(clobber))
+    (out / 'in.ld').write_text(LD)
+    run([tc / 'llvm-mc', '-arm-add-build-attributes', '-filetype=obj',
+         '-triple=armv7-unknown-linux-gnueabi', f'{name}.s', '-o', f'{name}.o'])
+    run([tc / 'ld.lld', '--emit-relocs', '-T', 'in.ld', f'{name}.o', '-o', f'{name}.exe'])
+    for mode, extra in (('default', []), ('reverse', ['--reorder-blocks=reverse'])):
+        rc, log = run([tc / 'llvm-bolt', f'{name}.exe', '-o', f'{name}.{mode}.bolt',
+                       '-lite=0', '--funcs=sw', *extra], check=False)
+        (out / f'{name}.{mode}.log').write_text(log)
+        if clobber:
+            ok = rc != 0 and 'unsupported AArch32 inline jump table base in sw' in log
+            print(f"{'PASS' if ok else 'FAIL'}: {name}/{mode}: rejected={rc != 0}")
+            bad += not ok
+            continue
+        if rc:
+            print(f'FAIL: {name}/{mode}: llvm-bolt failed\n{log[-1000:]}')
+            bad += 1
+            continue
+        _, dis = run([tc / 'llvm-objdump', '-d', f'{name}.{mode}.bolt'])
+        m = re.search(r'^([0-9a-f]+) <sw>:\n(.*?)(?:\n\n|\Z)', dis, re.S | re.M)
+        rows = [re.match(r'\s*([0-9a-f]+):\s+((?:[0-9a-f]{2} ?)+|[0-9a-f]{8})\s+(\S+)\s*(.*)', l)
+                for l in m.group(2).splitlines()] if m else []
+        rows = [r for r in rows if r]
+        start = int(m.group(1), 16) if m else 0
+        addrs = {int(r.group(1), 16): (r.group(3), r.group(4)) for r in rows}
+        # Base: `add rB, pc, #k` (or adr) -> address of the table after the LDR.
+        base = next((a for a, (mn, ops) in addrs.items()
+                     if mn in ('add', 'adr') and 'pc' in ops), None)
+        ldr = next((a for a, (mn, ops) in addrs.items()
+                    if mn == 'ldr' and ops.startswith('pc,')), None)
+        ok = start >= 0x400000 and base is not None and ldr is not None
+        if ok:
+            k = re.search(r'#(-?(?:0x)?[0-9a-f]+)', addrs[base][1])
+            table = base + 8 + int(k.group(1), 0) if k else None
+            words = [addrs.get(table + 4 * i) for i in range(4)]
+            vals = [int(w[1], 16) if w and w[0] == '.word' else None for w in words]
+            ok = table == ldr + 4 and all(v is not None and start <= v < start + 0x100 and
+                                         addrs.get(v, ('',))[0] == 'add' for v in vals)
+            print(f"{'PASS' if ok else 'FAIL'}: {name}/{mode}: base->{table and hex(table)}, "
+                  f"ldr@{hex(ldr)}, words {[v and hex(v) for v in vals]}")
+        else:
+            print(f'FAIL: {name}/{mode}: sw not rewritten or pattern missing')
+        bad += not ok
+sys.exit(1 if bad else 0)
