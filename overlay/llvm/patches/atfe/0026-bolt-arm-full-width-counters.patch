--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-arm-counter-bytes.py
@@ -0,0 +1,58 @@
+"""Check MC-builder output against independently assembled counter instructions."""
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+elf,mapping,out=map(Path,sys.argv[1:4])
+out.mkdir(parents=True,exist_ok=True)
+blob=elf.read_bytes()
+off=struct.unpack_from('<I',blob,32)[0]
+size,count,names=struct.unpack_from('<HHH',blob,46)
+headers=[struct.unpack_from('<10I',blob,off+i*size) for i in range(count)]
+strings=blob[headers[names][4]:headers[names][4]+headers[names][5]]
+sections={strings[h[0]:strings.index(b'\0',h[0])].decode():h for h in headers}
+counters=sections['.bolt.instr.counters']
+rows={p[0]:tuple(int(x,16) for x in p[1:]) for line in mapping.read_text(encoding='utf-8').splitlines() if (p:=line.split())}
+assert set(rows)=={'counter_arm','counter_thumb'}
+for index,mode in enumerate(('arm','thumb')):
+    address=counters[3]+8*index
+    body=f''' .syntax unified
+ .arch armv7-a
+ .text
+ .{mode}
+ sub sp,sp,#16
+ str r0,[sp]
+ str r1,[sp,#4]
+ str r2,[sp,#8]
+ str r3,[sp,#12]
+ movw r0,#{address&65535}
+ movt r0,#{address>>16}
+ mrs r2,cpsr
+ cpsid i
+ ldr r1,[r0]
+ ldr r3,[r0,#4]
+ adds{'.w' if mode=='thumb' else ''} r1,r1,#1
+ adc r3,r3,#0
+ str r1,[r0]
+ str r3,[r0,#4]
+ msr cpsr_fc,r2
+ ldr r0,[sp]
+ ldr r1,[sp,#4]
+ ldr r2,[sp,#8]
+ ldr r3,[sp,#12]
+ add sp,sp,#16
+ bx lr
+'''
+    # Thumb's narrow load/store spellings differ from the builder's wide forms.
+    if mode=='thumb':
+        body=body.replace(' str ',' str.w ').replace(' ldr ',' ldr.w ')
+    asm=out/(mode+'.s');asm.write_text(body,encoding='utf-8')
+    obj=out/(mode+'.o');binary=out/(mode+'.bin')
+    subprocess.run(['llvm-mc','-triple=armv7-none-eabi','-filetype=obj',str(asm),'-o',str(obj)],check=True)
+    subprocess.run(['llvm-objcopy','--dump-section=.text='+str(binary),str(obj)],check=True)
+    _,address,length=rows['counter_'+mode]
+    section=next(h for h in sections.values() if h[1]!=8 and h[3]<=address<address+length<=h[3]+h[5])
+    pos=section[4]+address-section[3]
+    assert blob[pos:pos+length]==binary.read_bytes(),mode+' counter instruction bytes differ from independent assembly'
+print('PASS: ARM/Thumb uint64 carry, CPSR_fc and 16-byte stack-frame bytes')
--- /dev/null
+++ b/bolt/test/ARM/arm-counter-carry.test
@@ -0,0 +1,9 @@
+## Encoding regression for full-width slots; semantic seeded carry runs on Pi.
+RUN: llvm-mc -triple=armv7-none-eabi -arm-add-build-attributes -filetype=obj %p/Inputs/arm-counter-probes.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+RUN: llvm-mc -triple=armv7-none-eabi -filetype=obj %p/Inputs/arm-counter-runtime.s -o %t.rt.o
+RUN: llvm-ar rcs %t.rt.a %t.rt.o
+RUN: llvm-bolt %t.exe -o %t.bolt --no-huge-pages -lite=0 --instrument --instrument-calls=false \
+RUN:   --instrumentation-sleep-time=1 --runtime-instrumentation-lib=%t.rt.a \
+RUN:   --funcs=counter_arm,counter_thumb --emit-function-map=%t.map
+RUN: %python %p/Inputs/check-arm-counter-bytes.py %t.bolt %t.map %t.check
