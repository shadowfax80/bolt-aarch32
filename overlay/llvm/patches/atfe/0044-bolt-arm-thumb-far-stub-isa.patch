--- /dev/null
+++ b/bolt/test/ARM/thumb-far-stub.test
@@ -0,0 +1,53 @@
+# Thumb callers must emit Thumb MOVW/MOVT/BX stubs, including interworking.
+# REQUIRES: system-linux
+# RUN: split-file %s %t
+# RUN: llvm-mc -arm-add-build-attributes -triple=armv7-none-eabi -filetype=obj %t/input.s -o %t.arm.o
+# RUN: ld.lld --emit-relocs -T %t/link.ld %t.arm.o -o %t.arm
+# RUN: llvm-bolt %t.arm -o %t.arm.bolt --no-huge-pages -lite=0 --pad-funcs-before=far_away:0x2100000 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-mc -arm-add-build-attributes -triple=armv7-none-eabi -defsym=THUMB_CALLEE=1 -filetype=obj %t/input.s -o %t.thumb.o
+# RUN: ld.lld --emit-relocs -T %t/link.ld %t.thumb.o -o %t.thumb
+# RUN: llvm-bolt %t.thumb -o %t.thumb.bolt --no-huge-pages -lite=0 --pad-funcs-before=far_away:0x2100000 --reorder-blocks=reverse 2>&1 | FileCheck %s --check-prefix=LOG
+# LOG: number of removed linker-inserted veneers: 1
+# LOG: Inserted 1 stubs
+# LOG-NOT: BOLT-ERROR
+#--- input.s
+.syntax unified
+.arch armv7-a
+.section .text.start,"ax",%progbits
+.thumb
+.global _start
+.type _start,%function
+.thumb_func
+_start:
+push {r4,lr}
+movs r0,#17
+blx __ARMv5LongLdrPcThunk_far_away
+pop {r4,pc}
+.size _start,.-_start
+.arm
+.balign 4
+.global __ARMv5LongLdrPcThunk_far_away
+.type __ARMv5LongLdrPcThunk_far_away,%function
+__ARMv5LongLdrPcThunk_far_away:
+ldr pc,[pc,#-4]
+.word far_away
+.size __ARMv5LongLdrPcThunk_far_away,.-__ARMv5LongLdrPcThunk_far_away
+.section .text.far,"ax",%progbits
+.global far_away
+.type far_away,%function
+.ifdef THUMB_CALLEE
+.thumb
+.thumb_func
+far_away:
+add.w r0,r0,#7
+bx lr
+.else
+.arm
+far_away:
+add r0,r0,#7
+bx lr
+.endif
+.size far_away,.-far_away
+#--- link.ld
+ENTRY(_start)
+SECTIONS { . = 0x10000; .text : { *(.text.start) . = . + 0x2100000; *(.text.far) } }
