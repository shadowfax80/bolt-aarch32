+++ b/bolt/test/ARM/Inputs/check-arm-instrumentation-scope.py
@@ -0,0 +1,43 @@
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+parent=Path(sys.argv[1]);parent.mkdir(parents=True,exist_ok=True)
+out=Path(tempfile.mkdtemp(prefix='scope-',dir=parent))
+inputs=Path(sys.argv[2])
+def run(label,command,ok=True,diagnostic=None):
+    p=subprocess.run([str(x) for x in command],capture_output=True,text=True)
+    text=p.stdout+p.stderr
+    (out/(label+'.log')).write_text(text,encoding='utf-8')
+    if (p.returncode==0)!=ok or diagnostic and diagnostic not in text:
+        raise RuntimeError(label+': unexpected result\n'+text)
+    return text
+run('mc',['llvm-mc','-triple=armv7-none-eabi','-arm-add-build-attributes','-filetype=obj',inputs/'arm-counter-probes.s','-o',out/'input.o'])
+run('link',['ld.lld','--emit-relocs','-T',inputs/'arm32.ld',out/'input.o','-o',out/'input.elf'])
+run('shared',['ld.lld','-shared','--emit-relocs','-T',inputs/'arm32.ld',out/'input.o','-o',out/'shared.elf'])
+run('rt-mc',['llvm-mc','-triple=armv7-none-eabi','-filetype=obj',inputs/'arm-counter-runtime.s','-o',out/'rt.o'])
+run('rt-ar',['llvm-ar','rcs',out/'rt.a',out/'rt.o'])
+contract='--arm-instrumentation-contract=privileged-single-core-no-fiq'
+base=['--no-huge-pages','-lite=0','--instrument','--instrumentation-sleep-time=1',
+      '--runtime-instrumentation-lib='+str(out/'rt.a'),'--funcs=counter_arm,counter_thumb']
+cases=[
+    ('missing',['--instrument-calls=false'],'requires --arm-instrumentation-contract'),
+    ('userspace',['--instrument-calls=false','--arm-instrumentation-contract=userspace'],'requires --arm-instrumentation-contract'),
+    ('default-calls',[contract],'call/indirect-call profiling is unsupported'),
+    ('explicit-calls',[contract,'--instrument-calls=true'],'call/indirect-call profiling is unsupported'),
+    ('fork',[contract,'--instrument-calls=false','--instrumentation-wait-forks'],'does not support process/fork options'),
+    ('pid',[contract,'--instrument-calls=false','--instrumentation-file-append-pid'],'does not support process/fork options'),
+    ('binpath',[contract,'--instrument-calls=false','--instrumentation-binpath=/input'],'does not support process/fork options'),
+    ('shared',[contract,'--instrument-calls=false'],'supports static bare-metal executables only'),
+]
+for label,options,message in cases:
+    candidate=out/(label+'-output.elf')
+    source=out/('shared.elf' if label=='shared' else 'input.elf')
+    run(label,['llvm-bolt',source,'-o',candidate,*base,*options],False,message)
+    if candidate.exists():raise RuntimeError(label+': rejection left an output')
+candidate=out/'accepted.elf'
+run('accepted',['llvm-bolt',out/'input.elf','-o',candidate,*base,contract,'--instrument-calls=false'],True,
+    'caller acknowledges privileged-single-core-no-fiq')
+if not candidate.exists():raise RuntimeError('accepted contract produced no image')
+print('PASS: eight excluded operating combinations and accepted contract')
