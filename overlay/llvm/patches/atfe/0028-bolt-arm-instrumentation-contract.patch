 void InstrumentationRuntimeLibrary::adjustCommandLineOptions(
     const BinaryContext &BC) const {
+  // ELF metadata cannot establish privilege or concurrency. AArch32 uses
+  // CPSID/MSR and a non-atomic 64-bit update: require an explicit caller
+  // contract, then reject unsupported profiling paths before transformations.
+  if (BC.isARM()) {
+    if (opts::ARMInstrumentationContract != "privileged-single-core-no-fiq") {
+      errs() << "BOLT-ERROR: AArch32 instrumentation requires "
+                "--arm-instrumentation-contract=privileged-single-core-no-fiq; "
+                "reset and snapshots must be quiescent\n";
+      exit(1);
+    }
+    if (!BC.IsStaticExecutable) {
+      errs() << "BOLT-ERROR: AArch32 instrumentation supports static "
+                "bare-metal executables only\n";
+      exit(1);
+    }
+    if (opts::InstrumentCalls) {
+      errs() << "BOLT-ERROR: AArch32 call/indirect-call profiling is unsupported; "
+                "use --instrument-calls=false\n";
+      exit(1);
+    }
+    if (opts::InstrumentationWaitForks || opts::InstrumentationFileAppendPID ||
+        !opts::InstrumentationBinpath.empty()) {
+      errs() << "BOLT-ERROR: AArch32 bare-metal instrumentation does not "
+                "support process/fork options\n";
+      exit(1);
+    }
+    outs() << "BOLT-INFO: AArch32 instrumentation caller acknowledges "
