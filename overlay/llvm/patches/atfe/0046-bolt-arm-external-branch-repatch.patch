+from pathlib import Path
+import re
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+
+# pop {r4, lr} is a 4-byte pop.w in Thumb, so the Thumb sites are at +2,
+# +6, +16 and +20.
+# Callers that BOLT does not emit keep their original code, but their direct
+# branches to moved functions are re-patched in place. Decode the final bytes
+# independently: every site must keep its ISA, condition and BL/BLX choice and
+# reach the callee's new address.
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+SRC = r''' .syntax unified
+ .text
+ .arm
+ .global _start
+ .type _start,%function
+_start:
+ bl arm_caller
+ blx thumb_caller
+ b _start
+ .size _start,.-_start
+
+ .global arm_caller
+ .type arm_caller,%function
+arm_caller:
+ push {r4, lr}
+ cmp r0, #0
+ bl arm_callee
+ blx thumb_callee
+ blne arm_callee
+ pop {r4, lr}
+ cmp r0, #1
+ bne arm_callee
+ b arm_callee
+ .size arm_caller,.-arm_caller
+
+ .global arm_callee
+ .type arm_callee,%function
+arm_callee:
+ add r0, r0, #1
+ add r0, r0, #2
+ add r0, r0, #3
+ bx lr
+ .size arm_callee,.-arm_callee
+
+ .thumb
+ .global thumb_caller
+ .type thumb_caller,%function
+ .thumb_func
+thumb_caller:
+ push {r4, lr}
+ bl thumb_callee
+ blx arm_callee
+ pop {r4, lr}
+ cmp r0, #1
+ bne.w thumb_callee
+ b.w thumb_callee
+ .size thumb_caller,.-thumb_caller
+
+ .global thumb_callee
+ .type thumb_callee,%function
+ .thumb_func
+thumb_callee:
+ adds r0, #1
+ adds r0, #2
+ adds r0, #3
+ adds r0, #4
+ adds r0, #5
+ adds r0, #6
+ bx lr
+ .size thumb_callee,.-thumb_callee
+'''
+
+LD = 'ENTRY(_start)\nSECTIONS {\n  . = 0x8000;\n  .text : { *(.text*) }\n}\n'
+
+
+def run(cmd):
+    p = subprocess.run([str(x) for x in cmd], cwd=out, capture_output=True,
+                       text=True)
+    if p.returncode:
+        sys.exit(f'FAIL: {cmd[0]} exited {p.returncode}\n{p.stdout}{p.stderr}')
+    return p.stdout + p.stderr
+
+
+def symbols(elf):
+    syms = {}
+    for line in run([tc / 'llvm-nm', elf]).splitlines():
+        parts = line.split()
+        if len(parts) == 3:
+            syms[parts[2]] = int(parts[0], 16)
+    return syms
+
+
+(out / 'in.s').write_text(SRC)
+(out / 'in.ld').write_text(LD)
+run([tc / 'llvm-mc', '-arm-add-build-attributes', '-filetype=obj',
+     '-triple=armv7-unknown-linux-gnueabi', 'in.s', '-o', 'in.o'])
+run([tc / 'ld.lld', '--emit-relocs', '-T', 'in.ld', 'in.o', '-o', 'in.exe'])
+log = run([tc / 'llvm-bolt', 'in.exe', '-o', 'out.exe', '-lite=0',
+           '-skip-funcs=arm_caller,thumb_caller'])
