+static uint32_t encodeThumbBranchWord(int64_t Offset, uint16_t LoBase) {
+  const uint32_t S = (Offset >> 24) & 1;
+  const uint32_t J1 = (~(Offset >> 23) ^ S) & 1;
+  const uint32_t J2 = (~(Offset >> 22) ^ S) & 1;
+  const uint16_t Hi = 0xf000 | (S << 10) | ((Offset >> 12) & 0x3ff);
+  const uint16_t Lo =
+      LoBase | (J1 << 13) | (J2 << 11) | ((Offset >> 1) & 0x7ff);
+  return Hi | (static_cast<uint32_t>(Lo) << 16);
+}
+
+std::optional<uint32_t>
+Relocation::encodeARMBranch(uint32_t Type, uint64_t Target, uint64_t PC,
+                            uint32_t Original, std::optional<bool> TargetThumb) {
+  Target &= ~1ULL;
+  switch (Type) {
+  default:
+    return std::nullopt;
+  case ELF::R_ARM_PC24:
+  case ELF::R_ARM_PLT32:
+  case ELF::R_ARM_JUMP24:
+  case ELF::R_ARM_CALL: {
+    // Re-encode the original A32 instruction: keep B/Bcc/BLcc condition and
+    // choose BL or BLX from the target ISA. PC reads as the address + 8.
+    const bool IsBLX = (Original & 0xfe000000u) == 0xfa000000u;
+    const bool IsBL = !IsBLX && ((Original >> 24) & 0xf) == 0xb;
+    const bool IsB = !IsBLX && ((Original >> 24) & 0xf) == 0xa;
+    if (!IsBLX && !IsBL && !IsB)
+      return std::nullopt;
+    const bool Thumb = TargetThumb.value_or(IsBLX);
+    const int64_t Offset = int64_t(Target) - int64_t(PC + 8);
+    if (!isInt<26>(Offset))
+      return std::nullopt;
+    if (IsB) {
+      if (Thumb || (Offset & 3))
+        return std::nullopt;
+      return (Original & 0xff000000u) | ((Offset >> 2) & 0x00ffffff);
+    }
+    if (Thumb) {
+      // BLX (immediate) is unconditional; a conditional BL cannot switch ISA.
+      if (IsBL && (Original >> 28) != 0xe)
+        return std::nullopt;
+      return 0xfa000000u | (((Offset >> 1) & 1) << 24) |
+             ((Offset >> 2) & 0x00ffffff);
+    }
+    if (Offset & 3)
+      return std::nullopt;
+    const uint32_t Cond = IsBLX ? 0xe0000000u : (Original & 0xf0000000u);
+    return Cond | 0x0b000000u | ((Offset >> 2) & 0x00ffffff);
+  }
+  case ELF::R_ARM_THM_CALL:
+  case ELF::R_ARM_THM_JUMP24: {
+    // T32 BL/BLX/B.W. The first halfword is in the low 16 bits. BL and B.W
+    // have Lo bit 12 set; BLX (to A32) clears it and uses Align(PC, 4).
+    const uint16_t Lo = Original >> 16;
+    if ((Original & 0xf800) != 0xf000 || !(Lo & 0x8000))
+      return std::nullopt;
+    const bool IsCall = Lo & 0x4000;
+    const bool Thumb = TargetThumb.value_or(Lo & 0x1000);
+    uint64_t Base = PC + 4;
+    uint16_t LoBase;
+    if (!IsCall) {
+      if (!Thumb || !(Lo & 0x1000))
+        return std::nullopt;
+      LoBase = 0x9000;
+    } else if (Thumb) {
+      LoBase = 0xd000;
+    } else {
+      if (Target & 3)
+        return std::nullopt;
+      Base &= ~3ULL;
+      LoBase = 0xc000;
+    }
+    const int64_t Offset = int64_t(Target) - int64_t(Base);
+    if (!isInt<25>(Offset) || (Offset & 1))
+      return std::nullopt;
+    return encodeThumbBranchWord(Offset, LoBase);
+  }
+  case ELF::R_ARM_THM_JUMP19: {
+    // B<c>.W (T3): Hi = 11110:S:cond:imm6, Lo = 10:J1:0:J2:imm11. Keep cond.
+    const uint16_t Lo = Original >> 16;
+    if ((Original & 0xf800) != 0xf000 || (Lo & 0xd000) != 0x8000 ||
+        !TargetThumb.value_or(true))
+      return std::nullopt;
+    const int64_t Offset = int64_t(Target) - int64_t(PC + 4);
+    if (!isInt<21>(Offset) || (Offset & 1))
+      return std::nullopt;
+    const uint16_t Hi = 0xf000 | (((Offset >> 20) & 1) << 10) |
+                        (Original & 0x03c0) | ((Offset >> 12) & 0x3f);
+    const uint16_t NewLo = 0x8000 | (((Offset >> 18) & 1) << 13) |
+                           (((Offset >> 19) & 1) << 11) |
+                           ((Offset >> 1) & 0x7ff);
+    return Hi | (static_cast<uint32_t>(NewLo) << 16);
+  }
+  }
+}
