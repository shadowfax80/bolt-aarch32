+        if kind == 'blx':
+            base_pc &= ~3
+        return kind, 0xe, base_pc + off
+    off = (s << 20) | (j2 << 19) | (j1 << 18) | ((hi & 0x3f) << 12) | \
+          ((lo & 0x7ff) << 1)
+    off = (off ^ (1 << 20)) - (1 << 20)
+    return 'bcc.w', (hi >> 6) & 0xf, addr + 4 + off
+
+
+AL, NE = 0xe, 0x1
+arm = old['arm_caller']
+thumb = old['thumb_caller'] & ~1
+ac, tc_ = new['arm_callee'] & ~1, new['thumb_callee'] & ~1
+expect = [
+    ('arm bl', arm_branch(arm + 8), ('bl', AL, ac)),
+    ('arm blx', arm_branch(arm + 12), ('blx', AL, tc_)),
+    ('arm blne', arm_branch(arm + 16), ('bl', NE, ac)),
+    ('arm bne', arm_branch(arm + 28), ('b', NE, ac)),
+    ('arm b', arm_branch(arm + 32), ('b', AL, ac)),
+    ('thumb bl', thumb_branch(thumb + 2), ('bl', AL, tc_)),
+    ('thumb blx', thumb_branch(thumb + 6), ('blx', AL, ac)),
+    # B<c>.W reaches +-1 MiB; the moved callee is farther, so the branch must
+    # keep its original target (the input body stays intact) and condition.
+    ('thumb bne.w', thumb_branch(thumb + 16), ('bcc.w', NE, old['thumb_callee'] & ~1)),
+    ('thumb b.w', thumb_branch(thumb + 20), ('b.w', AL, tc_)),
+]
+if 'cannot reach' not in log:
+    sys.exit('FAIL: no warning for the out-of-range B<c>.W')
+bad = 0
+for name, got, want in expect:
+    ok = got == want
+    bad += not ok
+    print(f"{'PASS' if ok else 'FAIL'}: {name}: got {got[0]} cond={got[1]:x} "
+          f"dest={got[2]:#x}; want {want[0]} cond={want[1]:x} dest={want[2]:#x}")
+sys.exit(1 if bad else 0)
