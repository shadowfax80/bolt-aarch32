+if 'BOLT-ERROR' in log:
+    sys.exit('FAIL: BOLT-ERROR\n' + log)
+
+old, new = symbols(out / 'in.exe'), symbols(out / 'out.exe')
+for f in ('arm_callee', 'thumb_callee'):
+    if (old[f] & ~1) == (new[f] & ~1):
+        sys.exit(f'FAIL: {f} did not move')
+
+# The original text keeps its input address in .bolt.org.text.
+sec = run([tc / 'llvm-readelf', '-S', 'out.exe'])
+m = re.search(r'\.bolt\.org\.text\s+PROGBITS\s+([0-9a-f]+)', sec)
+if not m:
+    sys.exit('FAIL: no .bolt.org.text in output')
+base = int(m.group(1), 16)
+run([tc / 'llvm-objcopy', '-O', 'binary', '--only-section=.bolt.org.text',
+     'out.exe', 'org.bin'])
+org = (out / 'org.bin').read_bytes()
+
+
+def word(addr):
+    return struct.unpack_from('<I', org, addr - base)[0]
+
+
+def halves(addr):
+    return struct.unpack_from('<HH', org, addr - base)
+
+
+def arm_branch(addr):
+    w = word(addr)
+    cond, op = w >> 28, (w >> 24) & 0xf
+    off = ((w & 0xffffff) ^ 0x800000) - 0x800000
+    dest = addr + 8 + (off << 2)
+    if cond == 0xf:
+        return 'blx', 0xe, dest + (((w >> 24) & 1) << 1)
+    return {0xa: 'b', 0xb: 'bl'}.get(op, f'op{op:x}'), cond, dest
+
+
+def thumb_branch(addr):
+    hi, lo = halves(addr)
+    s = (hi >> 10) & 1
+    j1, j2 = (lo >> 13) & 1, (lo >> 11) & 1
+    if lo & 0x1000 or (lo >> 14) & 1:  # B.W, BL, BLX (T4/T1/T2 J1/J2 form)
+        i1, i2 = 1 - (j1 ^ s), 1 - (j2 ^ s)
+        off = (s << 24) | (i1 << 23) | (i2 << 22) | ((hi & 0x3ff) << 12) | \
+              ((lo & 0x7ff) << 1)
+        off = (off ^ (1 << 24)) - (1 << 24)
+        kind = {0x9000: 'b.w', 0xd000: 'bl', 0xc000: 'blx'}.get(
+            lo & 0xd000, f'lo{lo:x}')
