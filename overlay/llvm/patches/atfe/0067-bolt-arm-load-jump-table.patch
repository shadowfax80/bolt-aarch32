+  bool isRegisterTableJump(const MCInst &Inst, MCPhysReg *Reg) const override {
+    if (Inst.getOpcode() == ARM::MOVr) {
+      // (Rd, Rm, pred, predreg, cc_out): mov pc, rX, unconditional, no S.
