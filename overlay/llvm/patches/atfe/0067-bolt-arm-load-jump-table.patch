+bool BinaryFunction::isRegisterTableShape(int64_t TableOff, MCPhysReg BaseReg) {
+  if (TableOff < 8 || !BC.isARM() || isARMThumb())
+    return false;
+  ErrorOr<ArrayRef<uint8_t>> Data = getData();
+  if (!Data || uint64_t(TableOff) > Data->size())
+    return false;
+  MCInst Load, Jump;
+  uint64_t LoadSize, JumpSize;
+  MCPhysReg Rt, LoadBase, JumpReg;
+  if (getSizeOfDataInCodeAt(TableOff - 8) ||
+      !BC.DisAsm->getInstruction(Load, LoadSize, Data->slice(TableOff - 8),
+                                 getAddress() + TableOff - 8, nulls()) ||
+      LoadSize != 4 ||
+      !BC.DisAsm->getInstruction(Jump, JumpSize, Data->slice(TableOff - 4),
+                                 getAddress() + TableOff - 4, nulls()) ||
+      JumpSize != 4 || !BC.MIB->isTableLoad(Load, &Rt, &LoadBase) ||
+      !BC.MIB->isRegisterTableJump(Jump, &JumpReg) || LoadBase != BaseReg ||
+      Rt != JumpReg || Rt == BaseReg)
+    return false;
+  RegisterTableJumps[TableOff - 4] = JumpReg;
+  return true;
+}
