+          Inst.getOperand(0).getReg() != ARM::PC || !Inst.getOperand(1).isReg() ||
+          !Inst.getOperand(2).isImm() || Inst.getOperand(2).getImm() != ARMCC::AL ||
+          !Inst.getOperand(4).isReg() || Inst.getOperand(4).getReg())
+        return false;
+      const MCPhysReg R = Inst.getOperand(1).getReg();
+      if (R == ARM::PC || R == ARM::LR || R == ARM::SP)
+        return false;
+      *Reg = R;
+      return true;
+    }
+    if (Inst.getOpcode() == ARM::BX && Inst.getNumOperands() &&
+        Inst.getOperand(0).isReg()) {
+      const MCPhysReg R = Inst.getOperand(0).getReg();
+      if (R == ARM::PC || R == ARM::LR || R == ARM::SP)
+        return false;
+      *Reg = R;
+      return true;
+    }
+    return false;
+  }
