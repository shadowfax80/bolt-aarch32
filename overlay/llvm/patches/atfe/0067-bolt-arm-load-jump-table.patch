--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-arm-load-jump-table.py
@@ -0,0 +1,122 @@
+"""R21: A32 -O0 load-then-jump tables (`add rB, pc, #k; ldr rX, [rB, rI,
+lsl #2]; mov pc, rX` or `bx rX`, absolute words after the jump). BOLT
+re-emits the table after the jump, points the base at it, and admits only
+when every case block redefines rX before reading it. Non-adjacent load,
+clobbered base and a case that reads rX stay rejected."""
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+
+def source(jump='mov pc, r0', between='', case1='ldr r0, [sp]', after_load=''):
+    # add r1, pc, #k: the table sits right after the jump.
+    k = 4 + 4 * (between + after_load).count('\n')
+    return f''' .syntax unified
+ .text
+ .arm
+ .global _start
+ .type _start,%function
+_start:
+ bl sw
+ b _start
+ .size _start,.-_start
+
+ .global sw
+ .type sw,%function
+sw:
+ sub sp, sp, #8
+ str r0, [sp]
+ and r0, r0, #3
+ add r1, pc, #{k}
+{between} ldr r0, [r1, r0, lsl #2]
+{after_load} {jump}
+ .word c1, c2, c3, c4
+c1:
+ {case1}
+ add r0, r0, #1
+ b done
+c2:
+ ldr r0, [sp]
+ add r0, r0, #2
+ b done
+c3:
+ ldr r0, [sp]
+ add r0, r0, #3
+ b done
+c4:
+ ldr r0, [sp]
+ add r0, r0, #4
+done:
+ add sp, sp, #8
+ bx lr
+ .size sw,.-sw
+'''
+
+
+CASES = (('mov-pc', source(), True, ''),
+         ('bx', source('bx r0'), True, ''),
+         ('case-reads-rx', source(case1='mov r2, r0'), False, 'inline jump table register in sw'),
+         ('base-gap', source(between=' mov r2, r2\n'), True, ''),
+         ('not-adjacent', source(after_load=' mov r2, r2\n'), False, 'PC read in sw'),
+         ('clobbered-base', source(between=' mov r1, #0\n'), False, 'in sw'))
+
+
+def run(cmd, check=True):
+    p = subprocess.run([str(x) for x in cmd], cwd=out, capture_output=True, text=True)
+    if check and p.returncode:
+        sys.exit(f'FAIL: {Path(str(cmd[0])).name} exited {p.returncode}\n{p.stdout}{p.stderr}')
+    return p.returncode, p.stdout + p.stderr
+
+
+bad = 0
+for name, src, admit, why in CASES:
+    (out / f'{name}.s').write_text(src)
+    (out / 'in.ld').write_text('ENTRY(_start)\nSECTIONS {\n  . = 0x8000;\n  .text : { *(.text*) }\n}\n')
+    run([tc / 'llvm-mc', '-arm-add-build-attributes', '-filetype=obj', '-triple=armv7-unknown-linux-gnueabi',
+         f'{name}.s', '-o', f'{name}.o'])
+    run([tc / 'ld.lld', '--emit-relocs', '-T', 'in.ld', f'{name}.o', '-o', f'{name}.exe'])
+    for mode, extra in (('default', []), ('reverse', ['--reorder-blocks=reverse'])):
+        rc, log = run([tc / 'llvm-bolt', f'{name}.exe', '-o', f'{name}.{mode}.bolt', '-lite=0',
+                       '--funcs=sw', *extra], check=False)
+        (out / f'{name}.{mode}.log').write_text(log)
+        if not admit:
+            ok = rc != 0 and why in log
+            print(f"{'PASS' if ok else 'FAIL'}: {name}/{mode}: rejected={rc != 0}")
+            if not ok:
+                print(log[-600:])
+            bad += not ok
+            continue
+        if rc:
+            print(f'FAIL: {name}/{mode}: llvm-bolt failed\n{log[-800:]}')
+            bad += 1
+            continue
+        _, dis = run([tc / 'llvm-objdump', '-d', f'{name}.{mode}.bolt'])
+        m = re.search(r'^([0-9a-f]+) <sw>:\n(.*?)(?:\n\n|\Z)', dis, re.S | re.M)
+        # Case labels are symbols, so objdump splits sw into blocks: index all rows.
+        rows = re.findall(r'^\s*([0-9a-f]+):\s+((?:[0-9a-f]{2} ?){4}|[0-9a-f]{8})\s+(\S+)\s*([^\n]*)', dis, re.M)
+        addr = {int(a, 16): (mn, ops) for a, _, mn, ops in rows}
+        start = int(m.group(1), 16)
+        mine = {a: v for a, v in addr.items() if start <= a < start + 0x200}  # the rewritten sw
+        base = next((a for a, (mn, ops) in mine.items() if mn in ('add', 'adr') and 'pc' in ops), None)
+        jump = next((a for a, (mn, ops) in mine.items()
+                     if (mn == 'mov' and ops.startswith('pc,')) or (mn == 'bx' and ops.strip() == 'r0')), None)
+        ok = base is not None and jump is not None
+        if ok:
+            k = int(re.search(r'#(-?(?:0x)?[0-9a-f]+)', addr[base][1]).group(1), 0)
+            table = base + 8 + k
+            vals = [int(addr[table + 4 * i][1], 16) if addr.get(table + 4 * i, ('',))[0] == '.word' else None
+                    for i in range(4)]
+            ok = table == jump + 4 and all(v and start <= v < start + 0x200 and
+                                           addr.get(v, ('',))[0] == 'ldr' for v in vals)
+        print(f"{'PASS' if ok else 'FAIL'}: {name}/{mode}: base->{hex(table) if base else None} jump@{jump and hex(jump)}")
+        bad += not ok
+sys.exit(1 if bad else 0)
--- /dev/null
+++ b/bolt/test/ARM/arm-load-jump-table.test
@@ -0,0 +1,6 @@
+## R21: A32 -O0 load-then-jump tables (ldr rX, [rB, rI, lsl #2]; mov pc|bx rX)
+## are re-emitted after the jump with the base re-pointed; admitted only when
+## every case redefines rX; non-adjacent load and clobbered base rejected.
+
+RUN: rm -rf %t.dir
+RUN: %python %p/Inputs/check-arm-load-jump-table.py %t.dir
