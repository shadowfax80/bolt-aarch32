+import itertools
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+out = Path(sys.argv[1])
+out.mkdir(parents=True, exist_ok=True)
+inputs = Path(sys.argv[2])
+
+def run(label, args, expected=0):
+    p = subprocess.run([str(x) for x in args], capture_output=True, text=True)
+    text = p.stdout + p.stderr
+    (out/(label+'.log')).write_text(text, encoding='utf-8')
+    if (p.returncode == 0) != (expected == 0):
+        raise RuntimeError(label+': unexpected exit '+str(p.returncode)+'\n'+text)
+    return text
+
+header = '.syntax unified\n.arch armv7-a\n.text\n.thumb\n'
+def function(name, body):
+    return f'.balign 4\n.global {name}\n.type {name},%function\n.thumb_func\n{name}:\n{body}\n.size {name},.-{name}\n'
+
+def link(label, source):
+    asm = out/(label+'.s')
+    asm.write_text(header+source, encoding='utf-8')
+    obj, elf = out/(label+'.o'), out/(label+'.elf')
+    run(label+'-mc', ['llvm-mc','-triple=armv7-none-eabi','-arm-add-build-attributes','-filetype=obj',asm,'-o',obj])
+    run(label+'-link', ['ld.lld','--emit-relocs','-T',inputs/'arm32.ld',obj,'-o',elf])
+    return elf
+
+runtime = out/'runtime.a'
+run('runtime-mc', ['llvm-mc','-triple=armv7-none-eabi','-filetype=obj',inputs/'arm-counter-runtime.s','-o',out/'runtime.o'])
+run('runtime-ar', ['llvm-ar','rcs',runtime,out/'runtime.o'])
+start = '.arm\n.global _start\n.type _start,%function\n_start:\nbl helper\nbx lr\n.size _start,.-_start\n.thumb\n'
+source = start+function('helper','bx lr')
+names = []
+for size in range(1,5):
+    for tail in itertools.product('TE',repeat=size-1):
+        mask = 'T'+''.join(tail)
+        name = 'data_'+mask.lower()
+        body = 'movw r1,#0\ncmp r0,#0\nit'+mask[1:].lower()+' eq\n'
+        body += '\n'.join('add'+('eq' if sense=='T' else 'ne')+'.w r1,r1,#'+str(1<<i) for i,sense in enumerate(mask))
+        source += function(name,body+'\nmov r0,r1\nbx lr')
+        names.append(name)
+source += function('loop', '''movw r1,#0
+.Lhead:
+cmp r0,#0
+it eq
+beq.w .Ldone
+add.w r1,r1,#3
+subs.w r0,r0,#1
+it ne
+bne.w .Lhead
+.Ldone:
+mov r0,r1
+bx lr''')
+names.append('loop')
+elf = link('valid',source)
+for mode, extra in [('normal',[]),('reverse',['--reorder-blocks=reverse']),('conservative',['--conservative-instrumentation'])]:
+    candidate = out/(mode+'.elf')
+    mapping = out/(mode+'.map')
+    run(mode,['llvm-bolt',elf,'-o',candidate,'--no-huge-pages','-lite=0','--instrument','--instrument-calls=false',
+              '--instrumentation-sleep-time=1','--runtime-instrumentation-lib='+str(runtime),
+              '--funcs='+','.join(names),'--emit-function-map='+str(mapping),*extra])
+    rows = {line.split()[0] for line in mapping.read_text().splitlines() if line.split()}
+    if rows != set(names): raise RuntimeError('missing emitted IT function')
+    disasm = run(mode+'-disasm',['llvm-objdump','-d',candidate])
+    match = re.search(r'<loop>:\n(.*?)(?=\n[0-9a-f]+ <|\Z)',disasm,re.S)
+    if not match or not re.search(r'add\.w\s+r1, r1, #(?:0x)?3',match[1]):
+        raise RuntimeError('reachable loop body removed')
+    if re.search(r'\s+it\s',match[1]): raise RuntimeError('terminal IT was not normalized')
+
+# Raw IT headers bypass assembler legality checks so malformed and excluded
+# control transfers reach BOLT's admission boundary.
+negatives = {
+    'return': ('.inst.n 0xbf08\nbx lr', 'unsupported control transfer'),
+    'call': ('.inst.n 0xbf08\nbl helper\nbx lr', 'unsupported control transfer'),
+    'early-branch': ('.inst.n 0xbf04\nb end\nmov r0,r0\nend: bx lr', 'unsupported control transfer'),
+    'nested': ('.inst.n 0xbf08\n.inst.n 0xbf08\nmov r0,r0\nbx lr', 'nested Thumb IT group'),
+    'truncated': ('.inst.n 0xbf04\nmov r0,r0', 'truncated Thumb IT group'),
+    'data': ('.inst.n 0xbf08\n.word 0\nbx lr', 'data inside Thumb IT group'),
+    'interior': ('b inside\n.inst.n 0xbf08\ninside: mov r0,r0\nbx lr', 'branch into Thumb IT body'),
+}
+for label, (body,diagnostic) in negatives.items():
+    elf = link(label,start+function('bad',body)+function('helper','bx lr'))
+    candidate = out/(label+'-out.elf')
+    text = run(label+'-bolt',['llvm-bolt',elf,'-o',candidate,'--no-huge-pages','-lite=0','--funcs=bad'],expected=1)
+    if diagnostic not in text: raise RuntimeError(label+': missing diagnostic\n'+text)
+    if candidate.exists(): raise RuntimeError(label+': rejection left an output')
+print('PASS: IT loop fallthrough/layout and seven rejection boundaries')
