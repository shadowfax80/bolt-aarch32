+from pathlib import Path
+import re,subprocess,sys,tempfile
+parent=Path(sys.argv[1]);parent.mkdir(parents=True,exist_ok=True)
+out=Path(tempfile.mkdtemp(prefix='self-moves-',dir=parent))
+asm='.syntax unified\n.arch armv7-a\n.text\n.arm\n.global _start\n.type _start,%function\n_start:\n'
+names=[];expected={}
+for mode,move in [('arm','mov'),('thumb_wide','mov.w'),('thumb_narrow','mov')]:
+    for flag in [False,True]:
+        name=mode+('_flags' if flag else '_plain');names.append(name);expected[name]=flag
+        asm+='bl '+name+'\n'
+asm+='bx lr\n.size _start,.-_start\n'
+for name in names:
+    thumb=not name.startswith('arm_')
+    move='mov'+('s' if expected[name] else '')+('.w' if name.startswith('thumb_wide') else '')
+    asm+=f'''.{'thumb' if thumb else 'arm'}
+.balign 4
+.global {name}
+.type {name},%function
+{'.thumb_func' if thumb else ''}
+{name}:
+cmp r0,#1
+{move} r0,r0
+beq .Lzero_{name}
+mov r0,#11
+bx lr
+.Lzero_{name}:
+mov r0,#22
+bx lr
+.size {name},.-{name}
+'''
+(out/'input.s').write_text(asm)
+(out/'layout.ld').write_text('ENTRY(_start)\nSECTIONS { . = 0x8000; .text : { *(.text*) } }\n')
+def run(label,cmd):
+    p=subprocess.run([str(x) for x in cmd],capture_output=True,text=True)
+    (out/(label+'.log')).write_text(p.stdout+p.stderr)
+    if p.returncode:raise RuntimeError(label+': '+p.stdout+p.stderr)
+    return p.stdout
+run('mc',['llvm-mc','-triple=armv7-none-eabi','-arm-add-build-attributes','-filetype=obj',out/'input.s','-o',out/'input.o'])
+run('link',['ld.lld','--emit-relocs','-T',out/'layout.ld',out/'input.o','-o',out/'input.elf'])
+for mode,extra in [('normal',[]),('reverse',['--reorder-blocks=reverse'])]:
+    candidate=out/(mode+'.elf');mapping=out/(mode+'.map')
+    run(mode,['llvm-bolt',out/'input.elf','-o',candidate,'--no-huge-pages','-lite=0','--funcs='+','.join(names),'--emit-function-map='+str(mapping),*extra])
+    rows={parts[0]:[int(x,16) for x in parts[1:]] for line in mapping.read_text().splitlines() if (parts:=line.split())}
+    if set(rows)!=set(names):raise RuntimeError('missing emitted self-move functions')
+    text=run(mode+'-disasm',['llvm-objdump','-d',candidate])
+    for name,(_,address,size) in rows.items():
+        body=[]
+        for line in text.splitlines():
+            m=re.match(r'\s*([0-9a-f]+):\s+(?:[0-9a-f]{2,8}\s+)+(\S+)\s*(.*)',line)
+            if m and address<=int(m[1],16)<address+size:body.append((m[2],m[3]))
+        moves=[op for op,args in body if re.match(r'r0,\s*r0(?:\s|$)',args)]
+        if expected[name]:
+            if len(moves)!=1 or not moves[0].startswith('movs'):raise RuntimeError(name+': flag-writing move lost '+repr(body))
+        elif moves:raise RuntimeError(name+': pure self-move not eliminated '+repr(body))
+print('PASS: 12 emitted flag-writing/pure self-move cases; Thumb annotation workers exercised',out)
