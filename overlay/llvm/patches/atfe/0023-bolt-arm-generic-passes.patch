+"""arm-passes.test checker: disassembles the BOLT output and checks one property per pass."""
+import re
+import subprocess
+import sys
+
+objdump, elf, which = sys.argv[1], sys.argv[2], sys.argv[3]
+
+
+def disasm(func, triple):
+    out = subprocess.run([objdump, "-d", f"--triple={triple}", f"--disassemble-symbols={func}", elf],
+                         capture_output=True, text=True, check=True).stdout
+    insns = {}
+    for line in out.splitlines():
+        m = re.match(r"\s*([0-9a-f]+):\s+(?:[0-9a-f]{2,8} ?)+\s+(\S+)\s*(.*)", line)
+        if m:
+            insns[int(m[1], 16)] = (m[2], m[3])
+    if not insns:
+        sys.exit(f"FAIL: no instructions for {func}")
+    return insns
+
+
+def target(args):
+    m = re.search(r"0x([0-9a-f]+)", args)
+    return int(m[1], 16) if m else None
+
+
+if which == "arm_cond":
+    ins = disasm("arm_cond", "armv7a-none-eabi")
+    conds = [(a, op, target(arg)) for a, (op, arg) in ins.items() if re.fullmatch(r"b(eq|ne)", op)]
+    if len(conds) != 1:
+        sys.exit(f"FAIL: expected one conditional branch, got {conds}")
+    a, op, t = conds[0]
+    if op != "bne":
+        sys.exit(f"FAIL: arm_cond was not reordered (still {op}); the test proves nothing")
+    if t not in ins:
+        sys.exit(f"FAIL: {op} at {a:#x} targets {t:#x}, not an instruction start")
+    # beq must reach the `sub` path, bne the `add` path, whatever the layout.
+    want = "sub" if op == "beq" else "add"
+    if ins[t][0] != want:
+        sys.exit(f"FAIL: {op} at {a:#x} reaches {ins[t]}, expected {want}")
+    for a, (op, arg) in ins.items():
+        if op in ("b", "beq", "bne") and target(arg) not in ins:
+            sys.exit(f"FAIL: {op} at {a:#x} leaves the function ({arg})")
+elif which == "tailcall":
+    ins = disasm("dj_func", "thumbv7a-none-eabi")
+    if any(op.startswith("bl") for op, _ in ins.values()):
+        sys.exit(f"FAIL: tail call emitted as a call: {ins}")
+    for a, (op, arg) in ins.items():
+        t = target(arg)
+        if op.startswith("b") and t in ins and ins[t][0] in ("b", "b.w"):
+            sys.exit(f"FAIL: double jump left at {a:#x} -> {t:#x}")
+    if not any(op.startswith("b") and "tail_target" in arg for op, arg in ins.values()):
+        sys.exit(f"FAIL: no branch to tail_target in dj_func: {ins}")
+elif which == "inline":
+    ins = disasm("caller", "thumbv7a-none-eabi")
+    calls = [arg for op, arg in ins.values() if op.startswith("bl")]
+    if any("leaf_ok" in c for c in calls):
+        sys.exit(f"FAIL: leaf_ok not inlined: {calls}")
+    if not any(op.startswith("add") and "#0xb" in arg for op, arg in ins.values()):
+        sys.exit(f"FAIL: inlined body of leaf_ok missing: {ins}")
+    if not any("leaf_push" in c for c in calls) or not any("leaf_arm" in c for c in calls):
+        sys.exit(f"FAIL: unsafe callees must stay calls: {calls}")
+elif which == "rodata":
+    ins = disasm("lit_func", "thumbv7a-none-eabi")
+    ops = [(op, arg) for op, arg in ins.values()]
