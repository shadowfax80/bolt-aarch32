+@ Inputs for arm-passes.test: one function per pass under test.
+	.syntax unified
+	.text
+
+@ ARM-mode conditional branch whose blocks get reordered (profile: L1 hot).
+	.arm
+	.globl	arm_cond
+	.type	arm_cond,%function
+	.p2align	2
+arm_cond:
+	cmp	r0, #0
+	beq	1f
+	add	r0, r0, #5
+	b	2f
+1:	sub	r0, r0, #7
+	sub	r0, r0, #7
+2:	bx	lr
+	.size	arm_cond, .-arm_cond
+
+@ Thumb block that only jumps to a block that only tail-calls: the double-jump
+@ peephole turns it into a direct tail call, which must be a B, not a BL.
+	.thumb
+	.globl	tail_target
+	.type	tail_target,%function
+	.p2align	1
+	.thumb_func
+tail_target:
+	adds	r0, #3
+	bx	lr
+	.size	tail_target, .-tail_target
+
+	.globl	dj_func
+	.type	dj_func,%function
+	.p2align	1
+	.thumb_func
+dj_func:
+	cmp	r0, #0
+	beq	3f
+	adds	r0, #1
+	b.w	4f
+3:	subs	r0, #1
+	bx	lr
+4:	b.w	tail_target
+	.size	dj_func, .-dj_func
+
+@ Inlining: a safe Thumb leaf, a leaf with push/pop, an ARM-mode leaf.
+	.globl	leaf_ok
+	.type	leaf_ok,%function
+	.p2align	1
+	.thumb_func
+leaf_ok:
+	adds	r0, #11
+	bx	lr
+	.size	leaf_ok, .-leaf_ok
+
+	.globl	leaf_push
+	.type	leaf_push,%function
+	.p2align	1
+	.thumb_func
+leaf_push:
+	push	{r4, lr}
+	adds	r0, #13
+	pop	{r4, pc}
+	.size	leaf_push, .-leaf_push
+
+	.arm
+	.globl	leaf_arm
+	.type	leaf_arm,%function
+	.p2align	2
+leaf_arm:
+	add	r0, r0, #17
+	bx	lr
+	.size	leaf_arm, .-leaf_arm
+
+	.thumb
+	.globl	caller
+	.type	caller,%function
+	.p2align	1
+	.thumb_func
+caller:
+	push	{r4, lr}
+	bl	leaf_ok
+	bl	leaf_push
+	blx	leaf_arm
+	pop	{r4, pc}
+	.size	caller, .-caller
+
