+## AArch32 behaviour of BOLT's generic passes (patch 0023).
+RUN: llvm-mc -triple=thumbv7-none-eabi -filetype=obj %p/Inputs/arm32-passes.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+
+## ARM-mode Bcc targets are symbolized (operand 0), so a reordered layout keeps
+## them pointing at the right block.
+RUN: llvm-bolt %t.exe -o %t.reorder --no-huge-pages --data %p/Inputs/arm32-passes.fdata \
+RUN:   -lite=0 -reorder-blocks=ext-tsp
+RUN: %python %p/Inputs/check-passes.py llvm-objdump %t.reorder arm_cond
+
+## The double-jump peephole creates a tail call: a B, never a BL.
+RUN: llvm-bolt %t.exe -o %t.peep --no-huge-pages -lite=0 -peepholes=double-jumps
+RUN: %python %p/Inputs/check-passes.py llvm-objdump %t.peep tailcall
+
+## Inlining: only a leaf that touches neither SP, LR (beyond bx lr) nor PC, in
+## the caller's instruction set.
+RUN: llvm-bolt %t.exe -o %t.inline --no-huge-pages -lite=0 -inline-all
+RUN: %python %p/Inputs/check-passes.py llvm-objdump %t.inline inline
+
+## Constant literal-pool loads become MOVW/MOVT.
+RUN: llvm-bolt %t.exe -o %t.rodata --no-huge-pages -lite=0 -simplify-rodata-loads
+RUN: %python %p/Inputs/check-passes.py llvm-objdump %t.rodata rodata
