@@ -235,6 +224,20 @@
     }
     }
     return Analysis->isReturn(Inst);
+  }
+
+  bool isTerminator(const MCInst &Inst) const override {
+    if (isReturn(Inst)) {
+      // Predicated returns can fall through when the condition fails. Keep
+      // them inside the block until conditional-return CFG edges are modeled.
+      const int Pred = Info->get(Inst.getOpcode()).findFirstPredOperandIdx();
+      if (Pred >= 0 && static_cast<unsigned>(Pred) < Inst.getNumOperands() &&
+          Inst.getOperand(Pred).isImm() &&
+          Inst.getOperand(Pred).getImm() != ARMCC::AL)
+        return false;
+      return true;
+    }
+    return MCPlusBuilder::isTerminator(Inst);
   }
 
