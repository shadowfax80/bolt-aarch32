+  const Case Cases[] = {
+      {false, {0x0f,0xf0,0xa0,0xe1}, true, false}, // pcself
+      {false, {0x03,0xf0,0xa0,0xe1}, true, false}, // pc_reg
+      {false, {0x00,0xf0,0x93,0xe5}, true, false}, // pc_load
+      {false, {0x08,0xf0,0x9d,0xe4}, true, false}, // pc_post
+      {false, {0x01,0x80,0xb3,0xe8}, true, false}, // ldm_reg
+      {false, {0x01,0x80,0x93,0xe8}, true, false}, // ldm_fixed
+      {false, {0x01,0x80,0xbd,0xe8}, false, true}, // ldm_sp
+      {false, {0x01,0x80,0xbd,0xe8}, false, true}, // pop
+      {false, {0x13,0xff,0x2f,0xe1}, false, false}, // bx
+      {true, {0xff,0x46}, true, false}, // pcself
+      {true, {0x9f,0x46}, true, false}, // pc_reg
+      {true, {0xd3,0xf8,0x00,0xf0}, true, false}, // pc_load
+      {true, {0x5d,0xf8,0x08,0xfb}, true, false}, // pc_post
+      {true, {0xb3,0xe8,0x01,0x80}, true, false}, // ldm_reg
+      {true, {0x93,0xe8,0x01,0x80}, true, false}, // ldm_fixed
+      {true, {0xbd,0xe8,0x01,0x80}, false, true}, // ldm_sp
+      {true, {0x01,0xbd}, false, true}, // pop
+      {true, {0x18,0x47}, false, false}, // bx
+  };
+  for (const Case &C : Cases) {
+    SCOPED_TRACE(C.Thumb ? "Thumb" : "ARM");
