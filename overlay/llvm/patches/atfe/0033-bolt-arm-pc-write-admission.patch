+            'pc_reg':'mov pc,r3\nmov r0,#7\nbx lr',
+            'pc_load':'ldr pc,[r3]\nmov r0,#7\nbx lr',
+            'pc_post':'ldr pc,[sp],#8\nmov r0,#7\nbx lr',
+            'ldm_reg':'ldmia r3!,{r0,pc}\nmov r0,#7\nbx lr',
+            'ldm_fixed':'ldmia r3,{r0,pc}\nmov r0,#7\nbx lr',
+            'ldm_sp_fixed':'ldmia sp,{r0,pc}\nmov r0,#7\nbx lr',
+            'ldm_sp_db':'ldmdb sp!,{r0,pc}\nmov r0,#7\nbx lr',
+            'ldm_sp':'ldmia sp!,{r0,pc}',
+            'pop':'pop {r0,pc}',
+            'bx':'bx r3',
+            'load':'ldr r0,[r3]\nbx lr'}
+    if isa=='arm':bodies['predicated']='cmp r0,#0\nmoveq pc,r3\nmov r0,#7\nbx lr'
+    else:bodies['predicated']='cmp r0,#0\nit eq\nmoveq pc,r3\nmov r0,#7\nbx lr'
+    for kind,body in bodies.items():
+        name=isa+'_'+kind;d=out/name;d.mkdir()
+        asm='.syntax unified\n.arch armv7-a\n.text\n.'+isa+'\n.global _start\n.type _start,%function\n'+('.thumb_func\n' if isa=='thumb' else '')+'_start:\nbl probe\nbx lr\n.size _start,.-_start\n.balign 4\n.global probe\n.type probe,%function\n'+('.thumb_func\n' if isa=='thumb' else '')+'probe:\n'+body+'\n.size probe,.-probe\n'
+        (d/'input.s').write_text(asm);(d/'layout.ld').write_text('ENTRY(_start)\nSECTIONS { . = 0x8000; .text : { *(.text*) } }\n')
+        def run(label,cmd):
