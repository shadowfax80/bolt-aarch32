+  auto Code = BC.getUnsignedValueAtAddress(BF.getAddress(), 4);
+  auto Target = BC.getUnsignedValueAtAddress(BF.getAddress() + 4, 4);
+  return Code && Target && *Code == 0xe51ff004 &&
+         BC.getBinaryFunctionAtAddress(*Target & ~1ULL);
