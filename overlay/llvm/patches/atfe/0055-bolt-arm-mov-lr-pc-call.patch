+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+# A32 `mov lr, pc; b X` is a call to X returning after the B (clang -marm
+# emits it, e.g. for a noreturn call through a linker thunk). BOLT admits it
+# as `nop; bl X`. A branch straight to the B (which would skip setting LR) is
+# rejected. A thunk `movw/movt r12; bx r12` to a proven noreturn function is
+# itself noreturn, so a caller ending in such a call is not a fallthrough.
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+HEAD = r''' .syntax unified
+ .text
+ .arm
+ .global _start
+ .type _start,%function
+_start:
+ bl user
+ b _start
+ .size _start,.-_start
+
+ .global callee
+ .type callee,%function
+callee:
+ add r0, r0, #5
+ bx lr
+ .size callee,.-callee
+
+ .global halt
+ .type halt,%function
+halt:
+ wfi
+ b halt
+ .size halt,.-halt
+
+ .global __ARMv7ABSLongThunk_halt
+ .type __ARMv7ABSLongThunk_halt,%function
+__ARMv7ABSLongThunk_halt:
+ movw r12, #:lower16:halt
+ movt r12, #:upper16:halt
+ bx r12
+ .size __ARMv7ABSLongThunk_halt,.-__ARMv7ABSLongThunk_halt
+'''
+
+FIXTURES = {
+    'positive': (r'''
+ .global user
+ .type user,%function
+user:
+ push {r4, lr}
+ mov lr, pc
+ b callee
+ add r0, r0, #1
+ cmp r0, #0
+ beq 1f
+ pop {r4, pc}
+1:
+ mov lr, pc
+ b __ARMv7ABSLongThunk_halt
+ .size user,.-user
+''', None),
+    'branch-into-pair': (r'''
+ .global user
+ .type user,%function
+user:
+ push {r4, lr}
+ cmp r0, #0
+ beq 1f
+ mov lr, pc
+1:
+ b callee
+ pop {r4, pc}
+ .size user,.-user
+''', 'branch into AArch32 mov-lr/b call in user'),
+}
+
+LD = 'ENTRY(_start)\nSECTIONS {\n  . = 0x8000;\n  .text : { *(.text*) }\n}\n'
+
+
+def run(cmd, check=True):
+    p = subprocess.run([str(x) for x in cmd], cwd=out, capture_output=True, text=True)
+    if check and p.returncode:
+        sys.exit(f'FAIL: {cmd[0]} exited {p.returncode}\n{p.stdout}{p.stderr}')
+    return p.returncode, p.stdout + p.stderr
+
+
+bad = 0
+for name, (body, error) in FIXTURES.items():
+    (out / f'{name}.s').write_text(HEAD + body)
+    (out / 'in.ld').write_text(LD)
+    run([tc / 'llvm-mc', '-arm-add-build-attributes', '-filetype=obj',
+         '-triple=armv7-unknown-linux-gnueabi', f'{name}.s', '-o', f'{name}.o'])
+    run([tc / 'ld.lld', '--emit-relocs', '-T', 'in.ld', f'{name}.o', '-o', f'{name}.exe'])
+    rc, log = run([tc / 'llvm-bolt', f'{name}.exe', '-o', f'{name}.bolt', '-lite=0',
+                   '--funcs=user,callee,halt,__ARMv7ABSLongThunk_halt'], check=False)
+    (out / f'{name}.log').write_text(log)
+    if error:
+        ok = rc != 0 and error in log and not (out / f'{name}.bolt').exists()
+        print(f"{'PASS' if ok else 'FAIL'}: {name}: rejected={rc != 0}")
+        bad += not ok
+        continue
+    if rc:
+        print(f'FAIL: {name}: llvm-bolt failed\n{log[-1200:]}')
+        bad += 1
+        continue
+    _, dis = run([tc / 'llvm-objdump', '-d', '--no-show-raw-insn', f'{name}.bolt'])
+    m = re.search(r'<user>:\n(.*?)(?:\n\n|\Z)', dis, re.S)
+    insts = [l.split(':', 1)[1].split('@')[0].strip() for l in m.group(1).splitlines()
+             if ':' in l] if m else []
+    _, nm = run([tc / 'llvm-nm', f'{name}.bolt'])
+    moved = any(re.search(r'^0*4[0-9a-f]{5} T user$', l) for l in nm.splitlines())
+    calls = [i for i in insts if re.match(r'bl\s', i)]
+    ok = moved and not any('pc' in i and i.startswith('mov') for i in insts) and \
+        any('<callee>' in c for c in calls) and len(calls) == 2
+    print(f"{'PASS' if ok else 'FAIL'}: {name}: {'; '.join(insts)}")
+    bad += not ok
+sys.exit(1 if bad else 0)
