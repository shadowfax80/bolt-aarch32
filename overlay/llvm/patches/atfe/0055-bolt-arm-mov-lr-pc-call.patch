+## A32 mov lr, pc; b X is admitted as a call (nop; bl X); a branch into the
+## pair is rejected; a movw/movt/bx r12 thunk to a noreturn function is noreturn.
+
+RUN: rm -rf %t.dir
+RUN: %python %p/Inputs/check-arm-mov-lr-pc-call.py %t.dir
