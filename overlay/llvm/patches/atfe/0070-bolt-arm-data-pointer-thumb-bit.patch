+++ b/bolt/test/ARM/arm-ldr-pc-table-mixed-isa.test
@@ -0,0 +1,5 @@
+## R28: A32 ldr-pc inline table entries stay ARM (bit 0 clear) when the binary also
+## contains Thumb code; a Thumb function address in an ARM literal keeps bit 0.
+
+RUN: rm -rf %t.dir
+RUN: %python %p/Inputs/check-arm-ldr-pc-table-mixed-isa.py %t.dir
