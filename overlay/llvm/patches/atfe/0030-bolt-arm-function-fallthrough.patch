+++ b/bolt/test/ARM/Inputs/check-arm-function-fallthrough.py
@@ -0,0 +1,89 @@
+from pathlib import Path
+import json, subprocess, sys, tempfile
+
+parent = Path(sys.argv[1])
+parent.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix="fallthrough-", dir=parent))
+before = "--expect-bug" in sys.argv[2:]
+
+def run(label, command):
+    p = subprocess.run([str(x) for x in command], capture_output=True, text=True)
+    (out / (label + ".log")).write_text(p.stdout + p.stderr)
+    return p
+
+results = {}
+for isa in ("arm", "thumb"):
+    for kind in ("entry", "branch", "call", "conditional", "spoof", "closed", "tail", "padding", "pop", "popwide"):
+        if isa == "arm" and kind == "popwide":
+            continue
+        thumb = ".thumb_func\n" if isa == "thumb" else ""
+        body = {
+            "entry": "mov r0,#1\n",
+            "spoof": "mov r0,#1\n",
+            "branch": "cmp r0,#0\nbeq .Ldone\nbx lr\n.Ldone:\nmov r0,#1\n",
+            "call": "push {r4,lr}\nbl helper\n",
+            "conditional": "cmp r0,#0\nbeq .Lreturn\nb .Llast\n.Lreturn:\nbx lr\n.Llast:\ncmp r0,#1\nbeq .Lreturn\n",
+            "closed": "cmp r0,#0\nbeq .Lreturn\nmov r0,#1\n.Lreturn:\nbx lr\n",
+            "tail": "b neighbor\n",
+            "padding": "bx lr\nnop\nnop\n",
+            "pop": "push {lr}\nmov r0,#7\npop {pc}\n",
+            "popwide": "push.w {lr}\nmov r0,#7\npop.w {pc}\n",
+        }[kind]
+        neighbor = "pop {r4,pc}\n" if kind == "call" else "bx lr\n"
+        label = isa + "-" + kind
+        d = out / label
+        d.mkdir()
+        asm = f""".syntax unified
+.arch armv7-a
+.text
+.arm
+.global _start
+.type _start,%function
+_start: bl probe
+bx lr
+.size _start,.-_start
+.{isa}
+.balign 4
+.global probe
+.type probe,%function
+{thumb}probe:
+{body}.size probe,.-probe
+.balign 4
+.global neighbor
+.type neighbor,%function
+{thumb}neighbor: mov r0,#42
+{neighbor}.size neighbor,.-neighbor
+.balign 4
+.global helper
+.type helper,%function
+{thumb}helper: mov r0,#3
+bx lr
+.size helper,.-helper
+"""
+        function = "__ARMv5LongLdrPcThunk_fake" if kind == "spoof" else "probe"
+        if kind == "spoof":
+            asm = asm.replace("probe", function)
+        (d / "input.s").write_text(asm)
+        (d / "layout.ld").write_text("ENTRY(_start)\nSECTIONS { . = 0x8000; .text : { *(.text*) } }\n")
+        for phase, command in [
+            ("mc", ["llvm-mc", "-triple=armv7-none-eabi", "-arm-add-build-attributes", "-filetype=obj", d / "input.s", "-o", d / "input.o"]),
+            ("link", ["ld.lld", "--emit-relocs", "-T", d / "layout.ld", d / "input.o", "-o", d / "input.elf"]),
+        ]:
+            p = run(label + "-" + phase, command)
+            if p.returncode:
+                raise RuntimeError(p.stdout + p.stderr)
+        unsupported = kind in ("entry", "branch", "call", "conditional", "spoof")
+        for mode, options in [("normal", []), ("reverse", ["--reorder-blocks=reverse"])]:
+            candidate = d / (mode + ".elf")
+            mapping = d / (mode + ".map")
+            p = run(label + "-" + mode, ["llvm-bolt", d / "input.elf", "-o", candidate, "--no-huge-pages", "-lite=0", "--funcs=" + function, "--emit-function-map=" + str(mapping), *options])
+            reject = unsupported and not before
+            if reject:
+                if p.returncode != 1 or "unmodeled AArch32 function fallthrough" not in p.stdout + p.stderr or candidate.exists():
+                    raise RuntimeError(label + ": unsafe fallthrough was not rejected before output\n" + p.stdout + p.stderr)
+            else:
+                if p.returncode or not candidate.exists() or function + " " not in mapping.read_text():
+                    raise RuntimeError(label + ": expected emitted function\n" + p.stdout + p.stderr)
+            results[label + "-" + mode] = {"returncode": p.returncode, "rejected": reject, "output": candidate.exists()}
+(out / "results.json").write_text(json.dumps(results, indent=2) + "\n")
+print("PASS:", "pre-fix unsafe acceptance confirmed;" if before else "20 ARM/Thumb fallthrough rejections;", "18 explicit-return/tail/padding/pop admissions", out)
