+//===- ARMReturns.cpp - ARM basic-block mutation invariants ------------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#ifdef ARM_AVAILABLE
+#include "MCTargetDesc/ARMMCTargetDesc.h"
+#include "bolt/Core/BinaryBasicBlock.h"
+#include "bolt/Core/BinaryContext.h"
+#include "bolt/Core/BinaryFunction.h"
+#include "bolt/Rewrite/RewriteInstance.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/DebugInfo/DWARF/DWARFContext.h"
+#include "llvm/MC/MCInstBuilder.h"
+#include "llvm/MC/MCDisassembler/MCDisassembler.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/Support/TargetSelect.h"
+#include "gtest/gtest.h"
+
+using namespace llvm;
+using namespace llvm::object;
+using namespace llvm::bolt;
+
+namespace {
+class ARMReturns : public testing::Test {
+protected:
+  ELF32LE::Ehdr Header{};
+  std::unique_ptr<ObjectFile> Object;
+  std::unique_ptr<BinaryContext> BC;
+  BinaryFunction *Function{nullptr};
+
+  void SetUp() override {
+    LLVMInitializeARMTargetInfo();
+    LLVMInitializeARMTargetMC();
+    LLVMInitializeARMAsmParser();
+    LLVMInitializeARMDisassembler();
+    LLVMInitializeARMTarget();
+    LLVMInitializeARMAsmPrinter();
+    memcpy(Header.e_ident, "\177ELF", 4);
+    Header.e_ident[ELF::EI_CLASS] = ELF::ELFCLASS32;
+    Header.e_ident[ELF::EI_DATA] = ELF::ELFDATA2LSB;
+    Header.e_machine = ELF::EM_ARM;
+    MemoryBufferRef Input(
+        StringRef(reinterpret_cast<const char *>(&Header), sizeof(Header)),
+        "ARM pseudo fixture");
+    Object = cantFail(ObjectFile::createObjectFile(Input));
+    const Triple TT("armv7-none-eabi");
+    Relocation::Arch = TT.getArch();
+    BC = cantFail(BinaryContext::createBinaryContext(
+        TT, std::make_shared<orc::SymbolStringPool>(), Object->getFileName(),
+        nullptr, true, DWARFContext::create(*Object), {outs(), errs()}));
+    BC->initializeTarget(std::unique_ptr<MCPlusBuilder>(createMCPlusBuilder(
+        TT.getArch(), BC->MIA.get(), BC->MII.get(), BC->MRI.get(), BC->STI.get())));
+    BinarySection &Text = BC->registerOrUpdateSection(
+        ".text", ELF::SHT_PROGBITS, ELF::SHF_ALLOC | ELF::SHF_EXECINSTR);
+    Function = BC->createBinaryFunction("pseudo_probe", Text, 0x1000, 4);
+    // Instruction accessors require an instruction-bearing parent state.
+    Function->setFinalized();
+  }
+
+  MCInst pseudo() {
+    return MCInstBuilder(ARM::B).addExpr(
+        MCSymbolRefExpr::create(BC->Ctx->createTempSymbol(), *BC->Ctx));
+  }
+
+  MCInst real() {
+    MCInst Inst;
+    BC->MIB->createNoop(Inst);
+    return Inst;
+  }
+};
+
+TEST_F(ARMReturns, DecodedSinglePCPop) {
+  BC->initializeThumbTarget(std::unique_ptr<MCPlusBuilder>(createMCPlusBuilder(
+      Triple::arm, BC->MIA.get(), BC->MII.get(), BC->MRI.get(),
+      BC->ThumbSTI.get())));
+  struct Case { bool Thumb; uint8_t Bytes[4]; bool Return; bool Terminator; };
+  const Case Cases[] = {
+      {false, {0x04,0xf0,0x9d,0xe4}, true, true}, // pop {pc}
+      {false, {0x04,0xf0,0x9d,0x14}, true, false}, // popne {pc}
+      {false, {0x04,0x00,0x9d,0xe4}, false, false}, // ldr r0,[sp],#4
+      {false, {0x04,0xf0,0x94,0xe4}, false, false}, // ldr pc,[r4],#4
+      {false, {0x08,0xf0,0x9d,0xe4}, false, false}, // ldr pc,[sp],#8
+      {true, {0x5d,0xf8,0x04,0xfb}, true, true}, // pop.w {pc}
+      {true, {0x5d,0xf8,0x04,0x0b}, false, false}, // ldr r0,[sp],#4
+      {true, {0x54,0xf8,0x04,0xfb}, false, false}, // ldr pc,[r4],#4
+      {true, {0x5d,0xf8,0x08,0xfb}, false, false}, // ldr pc,[sp],#8
+  };
+  for (const Case &C : Cases) {
+    SCOPED_TRACE(C.Thumb ? "Thumb" : "ARM");
+    MCInst Inst;
+    uint64_t Size = 0;
+    MCDisassembler *Decoder = C.Thumb ? BC->ThumbDisAsm.get() : BC->DisAsm.get();
+    ASSERT_NE(Decoder, nullptr);
+    ASSERT_EQ(Decoder->getInstruction(Inst, Size, C.Bytes, 0x1000, nulls()),
+              MCDisassembler::Success);
+    ASSERT_EQ(Size, 4u);
+    MCPlusBuilder *MIB = BC->getMIBFor(C.Thumb);
+    EXPECT_EQ(MIB->isReturn(Inst), C.Return);
+    EXPECT_EQ(MIB->isTerminator(Inst), C.Terminator);
+  }
+}
+} // namespace
+#endif
