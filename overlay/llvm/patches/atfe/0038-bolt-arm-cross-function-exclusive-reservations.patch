+// Inspect original bytes even in skipped callers, after interprocedural entry
+// discovery and before any pass inserts profiling memory traffic. A reservation may not
+// leave its function, even through a call to a currently unselected callee:
+// indirect/transitive reachability and later entry redirects are not a proof
+// that the callee stays free of probes. This intentionally rejects split
+// load/store primitives as well as calls made with a reservation outstanding.
+static Error validateARMExclusiveReservations(BinaryContext &BC) {
+  for (auto &It : BC.getBinaryFunctions()) {
+    BinaryFunction &BF = It.second;
+    if (BF.isPseudo() || !BF.getSize())
+      continue;
+    ErrorOr<ArrayRef<uint8_t>> Data = BF.getData();
+    if (!Data || BF.getSize() > Data->size())
+      return createFatalBOLTError(
+          "AArch32 instrumentation cannot inspect original code in " +
+          BF.getPrintName());
+    const bool Thumb = BF.isARMThumb();
+    MCDisassembler *Decoder = Thumb ? BC.ThumbDisAsm.get() : BC.DisAsm.get();
+    MCPlusBuilder *MIB = BC.getMIBFor(Thumb);
+    struct Decoded {
+      MCInst Inst;
+      uint64_t Size;
+      bool Predicated;
+    };
+    std::map<uint64_t, Decoded> Instructions;
+    bool HasExclusive = false;
+    bool Complete = true;
+    unsigned ITRemaining = 0;
+    for (uint64_t Offset = 0; Offset < BF.getSize();) {
+      if (const size_t N = BF.getSizeOfDataInCodeAt(Offset)) {
+        Complete &= !ITRemaining;
+        Offset += N;
+        continue;
+      }
+      MCInst Inst;
+      uint64_t Size = 0;
+      auto Status = Decoder->getInstruction(
+          Inst, Size, Data->slice(Offset, BF.getSize() - Offset),
+          BF.getAddress() + Offset, nulls());
+      if (Status != MCDisassembler::Success || !Size ||
+          Size > BF.getSize() - Offset) {
+        if (BF.isZeroPaddingAt(Offset))
+          break;
+        Complete = false;
+        // Continue looking for later exclusive instructions after a decode
+        // failure. Never certify such a stream if one is found. General
+        // undecodable-input admission remains a separate target boundary.
+        Offset += Thumb ? 2 : 4;
+        continue;
+      }
+      bool Predicated = ITRemaining != 0;
+      if (ITRemaining)
+        --ITRemaining;
+      if (MIB->isPrefix(Inst)) {
+        Complete &= !Predicated;
+        ITRemaining = MIB->getPredicationPrefixSize(Inst);
+        Complete &= ITRemaining != 0;
+      }
+      const MCInstrDesc &Desc = BC.MII->get(Inst.getOpcode());
+      const int Pred = Desc.findFirstPredOperandIdx();
+      if (Pred >= 0) {
+        if (static_cast<unsigned>(Pred) >= Inst.getNumOperands() ||
+            !Inst.getOperand(Pred).isImm())
+          Complete = false;
+        else
+          Predicated |= Inst.getOperand(Pred).getImm() != 14; // ARM AL
+      }
+      HasExclusive |= MIB->isExclusiveMemoryAccess(Inst);
+      Instructions.emplace(Offset, Decoded{std::move(Inst), Size, Predicated});
+      Offset += Size;
+    }
+    if (!HasExclusive)
+      continue;
+    if (!BF.isIgnored())
+      return createFatalBOLTError(
+          "AArch32 instrumentation does not support exclusive-memory accesses in " +
+          BF.getPrintName());
+    auto fail = [&](uint64_t Offset, StringRef Why) {
+      return createFatalBOLTError(
+          "AArch32 instrumentation cannot preserve cross-function exclusive "
+          "reservations in " + BF.getPrintName() + " at 0x" +
+          Twine::utohexstr(BF.getAddress() + Offset) + ": " + Why);
+    };
+    if (!Complete || ITRemaining)
+      return fail(0, "incomplete original instruction stream");
+    if (BF.isMultiEntry())
+      return fail(0, "multiple function entries");
+
+    // Track both reservation states at joins. A single visited bit for an
+    // instruction would lose a live path arriving after a cleared path.
+    std::vector<std::pair<uint64_t, bool>> Worklist{
+        {Instructions.begin()->first, false}};
+    std::set<std::pair<uint64_t, bool>> Visited;
+    while (!Worklist.empty()) {
+      const auto [Offset, Live] = Worklist.back();
+      Worklist.pop_back();
+      if (!Visited.insert({Offset, Live}).second)
+        continue;
+      auto II = Instructions.find(Offset);
+      if (II == Instructions.end()) {
+        if (Live || Offset < BF.getSize())
+          return fail(Offset, "unmodeled fallthrough or branch destination");
+        continue;
+      }
+      const Decoded &D = II->second;
+      const MCInst &Inst = D.Inst;
+      const MCInstrDesc &Desc = BC.MII->get(Inst.getOpcode());
+      if (MIB->isUnsupportedPCWrite(Inst))
+        return fail(Offset, "unmodeled PC-writing transfer");
+      if (MIB->isCall(Inst)) {
+        if (Live)
+          return fail(Offset, "call with a live reservation");
+        Worklist.emplace_back(Offset + D.Size, false);
+        continue;
+      }
+      if (MIB->isReturn(Inst)) {
+        if (Live)
+          return fail(Offset, "return with a live reservation");
+        if (D.Predicated)
+          Worklist.emplace_back(Offset + D.Size, false);
+        continue;
+      }
+      if (MIB->isIndirectBranch(Inst))
+        return fail(Offset, "unmodeled indirect branch");
+      if (MIB->isBranch(Inst)) {
+        uint64_t Target = 0;
+        if (!MIB->evaluateBranch(Inst, BF.getAddress() + Offset, D.Size, Target))
+          return fail(Offset, "unresolved direct branch");
+        Target &= ~1ULL;
+        if (Target >= BF.getAddress() &&
+            Target < BF.getAddress() + BF.getSize()) {
+          Worklist.emplace_back(Target - BF.getAddress(), Live);
+        } else if (Live) {
+          return fail(Offset, "branch out of function with a live reservation");
+        }
+        if (!MIB->isUnconditionalBranch(Inst) || D.Predicated)
+          Worklist.emplace_back(Offset + D.Size, Live);
+        continue;
+      }
+      if (MIB->isTerminator(Inst)) {
+        if (Live)
+          return fail(Offset, "terminator with a live reservation");
+        continue;
+      }
+      bool After = Live;
+      if (MIB->isExclusiveMemoryAccess(Inst)) {
+        const auto Kind = MIB->getExclusiveMemoryAccessKind(Inst);
+        // LLVM's generic mayLoad/mayStore flags do not distinguish the
+        // exclusive monitor operations. Use the target's explicit kind.
+        if (Kind == MCPlusBuilder::ExclusiveMemoryAccessKind::Store) {
+          if (!Live)
+            return fail(Offset, "exclusive store without a local reservation");
+          After = false;
+        } else if (Kind == MCPlusBuilder::ExclusiveMemoryAccessKind::Load) {
+          After = true;
+        } else {
+          After = false; // CLREX
+        }
+        if (D.Predicated)
+          Worklist.emplace_back(Offset + D.Size, Live);
+      }
+      Worklist.emplace_back(Offset + D.Size, After);
+    }
+  }
+  return Error::success();
+}
