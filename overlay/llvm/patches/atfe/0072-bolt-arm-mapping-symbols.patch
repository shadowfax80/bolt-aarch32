--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-arm-mapping-symbols.py
@@ -0,0 +1,223 @@
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+# R30: AArch32 tools take the instruction set of an address from the last
+# mapping symbol ($a/$t/$d) before it. In the input, an ARM function that
+# directly follows another ARM function has no $a of its own. BOLT used to
+# carry only the input's marks at function entries to the new code and drop
+# all others, so after reordering such a function followed Thumb code without
+# a mark (decoded as Thumb), the kept original section had no marks at all,
+# and linker stubs had none either. Checks:
+#   1. every function in the output starts in its own state;
+#   2. the original section decodes exactly like the input .text;
+#   3. JITLink stubs (ARM and Thumb) are marked with their own state;
+#   4. no address carries marks of both states (a "code resumes" mark after a
+#      function's trailing literal pool landed on the next function's entry).
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+SRC = r'''
+ .syntax unified
+ .text
+ .arm
+ .global _start
+ .type _start,%function
+ .p2align 2
+_start:
+ push {r4, lr}
+ bl arm_a
+ bl arm_b
+ blx th_t
+ blx th_far
+ bl arm_tail
+ blx th_tail
+ pop {r4, pc}
+ .size _start,.-_start
+
+ .global arm_a
+ .type arm_a,%function
+arm_a:
+ ldr r0, 1f
+ bx lr
+1:
+ .word 0x11223344
+ .size arm_a,.-arm_a
+
+ .global arm_b
+ .type arm_b,%function
+arm_b:
+ ldr r0, 2f
+ add r0, r0, #1
+ bx lr
+2:
+ .word 0x55667788
+ .size arm_b,.-arm_b
+
+ .thumb
+ .global th_t
+ .type th_t,%function
+ .thumb_func
+th_t:
+ movs r0, #7
+ b.w arm_b
+ .size th_t,.-th_t
+
+ .global th_far
+ .type th_far,%function
+ .thumb_func
+th_far:
+ movs r0, #9
+ bx lr
+ .size th_far,.-th_far
+
+## Branches to functions BOLT does not emit get JITLink stubs.
+ .global th_tail
+ .type th_tail,%function
+ .thumb_func
+th_tail:
+ b.w keep_t
+ .size th_tail,.-th_tail
+
+ .global keep_t
+ .type keep_t,%function
+ .thumb_func
+keep_t:
+ movs r0, #3
+ bx lr
+ .size keep_t,.-keep_t
+
+ .arm
+ .p2align 2
+ .global arm_tail
+ .type arm_tail,%function
+arm_tail:
+ b keep_a
+ .size arm_tail,.-arm_tail
+
+ .global keep_a
+ .type keep_a,%function
+keep_a:
+ mov r0, #4
+ bx lr
+ .size keep_a,.-keep_a
+'''
+
+
+def run(*args, **kw):
+    p = subprocess.run([str(a) for a in args], capture_output=True, text=True, **kw)
+    if p.returncode:
+        sys.exit(f'FAIL: {args[0]} exited {p.returncode}\n{p.stdout}\n{p.stderr}')
+    return p.stdout + p.stderr
+
+
+def symbols(f):
+    res = []
+    for line in run(tc / 'llvm-readelf', '-s', '-W', f).splitlines():
+        p = line.split()
+        if len(p) >= 8 and p[0].endswith(':') and p[0][:-1].isdigit() and p[6].isdigit():
+            res.append((int(p[1], 16), p[3], int(p[6]), p[7]))
+    return res
+
+
+def state_at(marks, address):
+    state = None
+    for a, k in marks:
+        if a > address:
+            break
+        state = k
+    return state
+
+
+def decode(f, section):
+    res = {}
+    for line in run(tc / 'llvm-objdump', '-d', '--no-show-raw-insn', '-j', section, f).splitlines():
+        m = re.match(r'\s*([0-9a-f]+):\s+(.*)', line)
+        if m:
+            res[int(m.group(1), 16)] = re.sub(r'\s*(@.*|<.*)$', '', m.group(2)).strip()
+    return res
+
+
+(out / 'in.s').write_text(SRC)
+run(tc / 'llvm-mc', '-arm-add-build-attributes', '-triple=armv7-none-eabi', '-filetype=obj',
+    out / 'in.s', '-o', out / 'in.o')
+run(tc / 'ld.lld', '--emit-relocs', '-Ttext=0x10000', out / 'in.o', '-o', out / 'in.elf')
+# th_t, arm_b first: arm_b (no $a of its own in the input) now follows Thumb code.
+(out / 'order.txt').write_text('\n'.join(
+    ['th_t', 'arm_b', '_start', 'arm_a', 'th_far', 'arm_tail', 'th_tail']) + '\n')
+log = run(tc / 'llvm-bolt', out / 'in.elf', '-o', out / 'out.elf', '--no-huge-pages', '-lite=0',
+          '--reorder-functions=user', f'--function-order={out / "order.txt"}',
+          '-skip-funcs=keep_a,keep_t')
+(out / 'bolt.log').write_text(log)
+if 'BOLT-ERROR' in log:
+    sys.exit('FAIL: BOLT-ERROR\n' + log)
+
+ok = True
+syms = symbols(out / 'out.elf')
+marks = {}
+for a, t, ndx, n in syms:
+    if re.fullmatch(r'\$[atd](\..*)?', n):
+        marks.setdefault(ndx, []).append((a, n[1]))
+for v in marks.values():
+    v.sort()
+
+# 1. Function starts.
+funcs = [(a, n, ndx) for a, t, ndx, n in syms if t == 'FUNC']
+for a, n, ndx in sorted(funcs):
+    want = 't' if a & 1 else 'a'
+    got = state_at(marks.get(ndx, []), a & ~1)
+    print(f'function {n} at {a & ~1:#x}: {want} state, marked {got}')
+    if got != want:
+        print(f'FAIL: {n} starts in state {got}, expected {want}')
+        ok = False
+if not {'arm_b', 'arm_tail', 'th_tail', 'keep_a', 'keep_t'} <= {n for a, n, ndx in funcs}:
+    sys.exit('FAIL: unexpected function symbols')
+
+# 2. The original section decodes like the input .text.
+before = decode(out / 'in.elf', '.text')
+after = decode(out / 'out.elf', '.bolt.org.text')
+diff = [a for a in sorted(set(before) | set(after)) if before.get(a) != after.get(a)]
+print(f'original section: {len(before)} input units, {len(diff)} decode differently')
+for a in diff[:8]:
+    print(f'FAIL: {a:#x}: input {before.get(a)!r}, output {after.get(a)!r}')
+ok &= not diff
+if not any('.word' in v for v in after.values()):
+    print('FAIL: literal pools of the original section are not marked as data')
+    ok = False
+
+# 3. Linker stubs: arm_tail (ARM B) and th_tail (Thumb B.W) branch to kept
+# functions, so JITLink makes one ARM and one Thumb MOVW/MOVT/BX stub.
+shdrs = run(tc / 'llvm-readelf', '-S', '-W', out / 'out.elf')
+stub = re.search(r'\[\s*(\d+)\]\s+(__llvm_jitlink_aarch32_STUBS\S*)', shdrs)
+if not stub:
+    sys.exit('FAIL: no JITLink stub section (test input no longer needs a stub)')
+ndx = int(stub.group(1))
+kinds = sorted(k for a, k in marks.get(ndx, []))
+print(f'stub section marks: {kinds}')
+if kinds != ['a', 't']:
+    print('FAIL: expected one $a and one $t in the stub section')
+    ok = False
+stub_code = list(decode(out / 'out.elf', stub.group(2)).values())
+print('stub section decodes as:', stub_code)
+if sorted((i.split() or ['?'])[0] for i in stub_code) !=['bx', 'bx', 'movt', 'movt', 'movw', 'movw']:
+    print('FAIL: stubs do not decode as two MOVW/MOVT/BX sequences')
+    ok = False
+
+# 4. One state per address.
+for ndx, v in marks.items():
+    at = {}
+    for a, k in v:
+        at.setdefault(a, set()).add(k)
+    for a, ks in sorted(at.items()):
+        if len(ks) > 1:
+            print(f'FAIL: section {ndx} address {a:#x} has conflicting marks {sorted(ks)}')
+            ok = False
+
+print('PASS' if ok else 'FAIL')
+sys.exit(0 if ok else 1)
--- /dev/null
+++ b/bolt/test/ARM/arm-mapping-symbols.test
@@ -0,0 +1,5 @@
+## R30: every function, the kept original section and linker stubs carry the
+## mapping symbols of their own instruction set after reordering.
+
+RUN: rm -rf %t.dir
+RUN: %python %p/Inputs/check-arm-mapping-symbols.py %t.dir
