+      // A PC index or another PC operand is not part of that model.
+      if ((Inst.getOpcode() == ARM::t2TBB ||
+           Inst.getOpcode() == ARM::t2TBH) && I == 0)
+        continue;
+      return true;
+    }
+    // Direct branches/calls have modeled PC-relative targets. Register BX/BLX
+    // PC was rejected above; ordinary BX/BLX registers stay supported.
+    if (isBranch(Inst) || isCall(Inst))
+      return false;
+    for (MCPhysReg Reg : Desc.implicit_uses())
+      if (Reg == ARM::PC)
+        return true;
+    return false;
+  }
