+from pathlib import Path
+import json,shutil,subprocess,sys,tempfile
+parent=Path(sys.argv[1]); parent.mkdir(parents=True,exist_ok=True)
+out=Path(tempfile.mkdtemp(prefix='pc-reads-',dir=parent)); rows=[]
