+        'adr_pc':('adr r0,.Lpool\nbx lr\n.balign 4\n.Lpool: .word 0x13579bdf',True),
+        'byte_pc':('ldrb r0,[pc,#0]\nbx lr',True),
+        'half_pc':('ldrh r0,[pc,#0]\nbx lr',True),
+        'signed_byte_pc':('ldrsb r0,[pc,#0]\nbx lr',True),
+        'signed_half_pc':('ldrsh r0,[pc,#0]\nbx lr',True),
+        'prefetch_pc':('pld [pc,#0]\nbx lr',True),
+        'instruction_prefetch_pc':('pli [pc,#0]\nbx lr',True),
+        'dead_pc':('b .Lok\nmov r0,pc\n.Lok: bx lr',True),
+        'vfp_pc':('vldr d0,[pc,#0]\nbx lr',True),
+        'bx_pc':('bx pc',True),
+        'pred_pc':(('cmp r1,#0\nmoveq r0,pc' if isa=='arm' else 'cmp r1,#0\nit eq\nmoveq r0,pc')+'\nbx lr',True),
+        'gpr':('mov r0,r1\nadd r0,r0,#1\nbx lr',False),
+        'load':('ldr r0,[r1]\nldrb r2,[r1]\nldrh r3,[r1]\nbx lr',False),
+        'literal':('ldr r0,.Lpool\nbx lr\n.balign 4\n.Lpool: .word 0x13579bdf',False),
+        'literal_data_pc_bits':('ldr r0,.Lpool\nbx lr\n.balign 4\n.Lpool: .word 0xe1a0000f',False),
+        'call_pop':('push {r4,lr}\nbl helper\npop {r4,pc}',False),
