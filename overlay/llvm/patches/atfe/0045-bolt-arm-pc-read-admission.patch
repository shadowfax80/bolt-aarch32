+    // both operands and implicit-use lists. Their address mode exposes it.
+    if ((Desc.TSFlags & ARMII::AddrModeMask) == ARMII::AddrModeT2_pc)
+      return true;
+    for (unsigned I = Desc.getNumDefs(), E = MCPlus::getNumPrimeOperands(Inst);
+         I < E; ++I) {
+      const MCOperand &Op = Inst.getOperand(I);
+      if (!Op.isReg() || Op.getReg() != ARM::PC)
+        continue;
