+  bool isUnsupportedPCRead(const MCInst &Inst) const override {
+    // Only the modeled word literal forms may use PC as a memory base.
+    // Arbitrary MOV/ADD/STR and FP/byte/halfword literals retain an old
+    // position-dependent value after movement. Reject instead of silently
+    // copying their displacement or dropping a function from an exact scope.
+    if (isLiteralLoad(Inst) || isReturn(Inst))
