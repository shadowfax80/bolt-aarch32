+Error RuntimeLibrary::validateARMInputContract(const ELFObjectFileBase &File,
+                               ARMAttributeParser &Attributes) {
+  auto fail = [](StringRef Reason) {
+    return createFatalBOLTError("AArch32 ISA/ABI contract: " + Reason);
+  };
+  const auto *ELF = dyn_cast<ELF32LEObjectFile>(&File);
+  if (!ELF)
+    return fail("requires little-endian ELF32");
+  const auto &Header = ELF->getELFFile().getHeader();
+  if (Header.e_ident[ELF::EI_OSABI] != ELF::ELFOSABI_NONE ||
+      Header.e_ident[ELF::EI_ABIVERSION] != 0)
+    return fail("unsupported ELF OS/ABI identification");
+  const unsigned Flags = File.getPlatformFlags();
+  if ((Flags & ELF::EF_ARM_EABIMASK) != ELF::EF_ARM_EABI_VER5)
+    return fail("requires EABI version 5");
+  if (Flags & ~(ELF::EF_ARM_EABI_VER5 | ELF::EF_ARM_ABI_FLOAT_SOFT))
+    return fail("unsupported ARM ELF flags (including hard-float or BE8)");
+  bool HaveAttributes = false;
+  for (const SectionRef &Sec : File.sections()) {
+    Expected<StringRef> Name = Sec.getName();
+    if (!Name)
+      return Name.takeError();
+    const bool IsAttributes =
+        ELFSectionRef(Sec).getType() == ELF::SHT_ARM_ATTRIBUTES;
+    if (*Name != ".ARM.attributes" && !IsAttributes)
+      continue;
+    if (HaveAttributes || *Name != ".ARM.attributes" || !IsAttributes)
+      return fail("ambiguous ARM attribute sections");
+    HaveAttributes = true;
+    Expected<StringRef> Contents = Sec.getContents();
+    if (!Contents)
+      return Contents.takeError();
+    if (Error E = validateARMAttributeLayout(*Contents))
+      return E;
+    if (Error E = Attributes.parse(arrayRefFromStringRef(*Contents),
+                                   llvm::endianness::little))
+      return createFatalBOLTError("AArch32 ISA/ABI contract: malformed attributes: " +
+                                  toString(std::move(E)));
+  }
+  if (!HaveAttributes)
+    return fail("requires .ARM.attributes");
+  auto value = [&](unsigned Tag) {
+    return Attributes.getAttributeValue(Tag).value_or(0);
+  };
+  if (value(ARMBuildAttrs::CPU_arch) != ARMBuildAttrs::v7 ||
+      value(ARMBuildAttrs::CPU_arch_profile) !=
+          ARMBuildAttrs::ApplicationProfile)
+    return fail("requires explicit ARMv7-A architecture/profile");
+  if (value(ARMBuildAttrs::ARM_ISA_use) != ARMBuildAttrs::Allowed ||
+      (value(ARMBuildAttrs::THUMB_ISA_use) != ARMBuildAttrs::AllowThumb32 &&
+       value(ARMBuildAttrs::THUMB_ISA_use) != ARMBuildAttrs::AllowThumbDerived))
+    return fail("requires ARM and Thumb-2 ISA permissions");
+  if (value(ARMBuildAttrs::ABI_VFP_args) != ARMBuildAttrs::BaseAAPCS ||
+      value(ARMBuildAttrs::ABI_WMMX_args) ||
+      value(ARMBuildAttrs::WMMX_arch) || value(ARMBuildAttrs::PCS_config))
+    return fail("requires base AAPCS without WMMX or custom PCS");
+  if (Attributes.getAttributeValue(ARMBuildAttrs::nodefaults) ||
+      Attributes.getAttributeString(ARMBuildAttrs::also_compatible_with))
+    return fail("alternate/default-free attribute contracts are unsupported");
+  if (value(ARMBuildAttrs::MVE_arch) || value(ARMBuildAttrs::T2EE_use) ||
+      value(ARMBuildAttrs::DSP_extension) ||
+      value(ARMBuildAttrs::PAC_extension) || value(ARMBuildAttrs::BTI_extension) ||
+      value(ARMBuildAttrs::PACRET_use) || value(ARMBuildAttrs::BTI_use))
+    return fail("unsupported ISA extension attributes");
+  if (value(ARMBuildAttrs::FP_arch) > ARMBuildAttrs::AllowFPv4B ||
+      value(ARMBuildAttrs::Advanced_SIMD_arch) > ARMBuildAttrs::AllowNeon2 ||
+      value(ARMBuildAttrs::DIV_use) > ARMBuildAttrs::AllowDIVExt ||
+      value(ARMBuildAttrs::Virtualization_use) >
+          ARMBuildAttrs::AllowTZVirtualization ||
+      value(ARMBuildAttrs::MPextension_use) > ARMBuildAttrs::AllowMP ||
+      value(ARMBuildAttrs::MPextension_use_old) > ARMBuildAttrs::AllowMP)
+    return fail("unsupported optional ISA extension values");
+  if (Attributes.getAttributeValue(ARMBuildAttrs::MPextension_use_old) &&
+      Attributes.getAttributeValue(ARMBuildAttrs::MPextension_use) &&
+      value(ARMBuildAttrs::MPextension_use_old) !=
+          value(ARMBuildAttrs::MPextension_use))
+    return fail("conflicting MP extension attributes");
+  if (value(ARMBuildAttrs::Advanced_SIMD_arch) &&
+      value(ARMBuildAttrs::FP_arch) < ARMBuildAttrs::AllowFPv3A)
+    return fail("SIMD permission conflicts with FP architecture");
+  return Error::success();
+}
 
