+// Reject ambiguous attribute scopes and repeated tags before using LLVM's
+// first-value attribute map. The initial contract uses one AEABI file scope.
+Error validateARMAttributeLayout(StringRef Contents) {
+  DataExtractor DE(Contents, /*IsLittleEndian=*/true);
+  DataExtractor::Cursor C(0);
+  struct ClearCursorError {
+    DataExtractor::Cursor &C;
+    ~ClearCursorError() { consumeError(C.takeError()); }
+  } Clear{C};
+  auto fail = [](StringRef Reason) {
+    return createFatalBOLTError("AArch32 ISA/ABI contract: " + Reason);
+  };
+  if (DE.getU8(C) != ELFAttrs::Format_Version)
+    return fail("invalid ARM attribute format");
+  bool HaveFile = false;
+  while (C.tell() < Contents.size()) {
+    const uint64_t Begin = C.tell();
+    const uint32_t Length = DE.getU32(C);
+    if (!C || Length < 5 || Length > Contents.size() - Begin)
+      return fail("invalid ARM vendor subsection length");
+    const uint64_t End = Begin + Length;
+    const StringRef Vendor = DE.getCStrRef(C);
+    if (!C || C.tell() > End)
+      return fail("unterminated ARM attribute vendor");
+    if (Vendor != "aeabi") {
+      C.seek(End);
+      continue;
+    }
+    if (HaveFile)
+      return fail("multiple AEABI attribute scopes");
+    const uint64_t ScopeBegin = C.tell();
+    const uint64_t Scope = DE.getULEB128(C);
+    const uint32_t Size = DE.getU32(C);
+    if (!C || Scope != ELFAttrs::File)
+      return fail("only AEABI file attributes are supported");
+    if (Size < C.tell() - ScopeBegin || Size != End - ScopeBegin)
+      return fail("invalid or multiple ARM attribute scopes");
+    HaveFile = true;
+    std::set<uint64_t> Tags;
+    while (C.tell() < End) {
+      const uint64_t Tag = DE.getULEB128(C);
+      if (!C || C.tell() > End)
+        return fail("truncated ARM attribute tag");
+      if (!Tags.insert(Tag).second)
+        return fail("duplicate ARM attribute tag");
+      if (!llvm::any_of(ARMBuildAttrs::getARMAttributeTags(),
+                        [Tag](const TagNameItem &Item) {
+                          return Item.attr == Tag;
+                        }))
+        return fail("unknown ARM attribute tag");
+      if (Tag == ARMBuildAttrs::compatibility) {
+        if (DE.getULEB128(C) != 0)
+          return fail("toolchain-specific ABI compatibility is unsupported");
+        DE.getCStrRef(C);
+      } else if (Tag == ARMBuildAttrs::CPU_raw_name ||
+                 Tag == ARMBuildAttrs::CPU_name ||
+                 Tag == ARMBuildAttrs::also_compatible_with ||
+                 Tag == ARMBuildAttrs::conformance || (Tag >= 32 && (Tag & 1))) {
+        DE.getCStrRef(C);
+      } else {
+        const uint64_t Value = DE.getULEB128(C);
+        if (Value > UINT32_MAX)
+          return fail("ARM attribute value exceeds 32 bits");
+      }
+      if (!C || C.tell() > End)
+        return fail("truncated ARM attribute value");
+    }
+  }
+  if (!HaveFile)
+    return fail("missing AEABI file attributes");
+  return Error::success();
+}
