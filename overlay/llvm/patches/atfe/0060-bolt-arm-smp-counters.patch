--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-arm-counter-smp.py
@@ -0,0 +1,68 @@
+"""SMP counters (--arm-instrumentation-contract=privileged-smp-no-fiq): the
+injected A32 helper and the ARM/Thumb call snippets match independent
+assembly byte for byte, the helper carries an $a mapping symbol, and unknown
+contract values are rejected."""
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import sys
+
+elf, mapping, out = map(Path, sys.argv[1:4])
+out.mkdir(parents=True, exist_ok=True)
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+blob = elf.read_bytes()
+off = struct.unpack_from('<I', blob, 32)[0]
+size, count, names = struct.unpack_from('<HHH', blob, 46)
+headers = [struct.unpack_from('<10I', blob, off + i * size) for i in range(count)]
+strings = blob[headers[names][4]:headers[names][4] + headers[names][5]]
+sections = {strings[h[0]:strings.index(b'\0', h[0])].decode(): h for h in headers}
+counters = sections['.bolt.instr.counters']
+
+
+def file_bytes(address, length):
+    h = next(h for h in sections.values() if h[1] != 8 and h[3] <= address < address + length <= h[3] + h[5])
+    pos = h[4] + address - h[3]
+    return blob[pos:pos + length]
+
+
+def assemble(name, body):
+    asm = out / (name + '.s')
+    asm.write_text(' .syntax unified\n .arch armv7-a\n .text\n' + body, encoding='utf-8')
+    subprocess.run([str(tc / 'llvm-mc'), '-arm-add-build-attributes', '-triple=armv7-none-eabi',
+                    '-filetype=obj', str(asm), '-o', str(out / (name + '.o'))], check=True)
+    subprocess.run([str(tc / 'llvm-objcopy'), '--dump-section=.text=' + str(out / (name + '.bin')),
+                    str(out / (name + '.o'))], check=True)
+    return (out / (name + '.bin')).read_bytes()
+
+
+syms = subprocess.run([str(tc / 'llvm-readelf'), '-s', str(elf)], capture_output=True, text=True, check=True).stdout
+helper = next(int(l.split()[1], 16) for l in syms.splitlines() if l.endswith(' __bolt_instr_counter_incr'))
+assert helper % 4 == 0, 'helper must be A32 (word aligned, even)'
+assert any(l.split()[-1] == '$a' and int(l.split()[1], 16) == helper for l in syms.splitlines()
+           if len(l.split()) >= 8), 'no $a mapping symbol at the helper'
+loop = assemble('helper', ' .arm\n1:\n ldrexd r2, r3, [r0]\n adds r2, r2, #1\n adc r3, r3, #0\n'
+                          ' strexd r1, r2, r3, [r0]\n cmp r1, #0\n bne 1b\n bx lr\n')
+assert file_bytes(helper, len(loop)) == loop, 'helper bytes differ from independent assembly'
+
+rows = {p[0]: tuple(int(x, 16) for x in p[1:]) for line in mapping.read_text(encoding='utf-8').splitlines()
+        if (p := line.split())}
+for index, mode in enumerate(('arm', 'thumb')):
+    counter = counters[3] + 8 * index
+    w = '.w' if mode == 'thumb' else ''
+    regs = ['r0', 'r1', 'r2', 'r3', 'r12', 'lr']
+    body = f' .{mode}\n sub sp, sp, #24\n'
+    body += ''.join(f' str{w} {r}, [sp, #{4 * i}]\n' for i, r in enumerate(regs))
+    body += (f' movw r0, #{counter & 0xffff}\n movt r0, #{counter >> 16}\n mrs r12, apsr\n cpsid i\n'
+             f' movw r1, #{helper & 0xffff}\n movt r1, #{helper >> 16}\n blx r1\n msr CPSR_fc, r12\n')
+    body += ''.join(f' ldr{w} {r}, [sp, #{4 * i}]\n' for i, r in enumerate(regs))
+    body += ' add sp, sp, #24\n bx lr\n'
+    want = assemble(mode, body)
+    _, address, length = rows['counter_' + mode]
+    assert file_bytes(address, length) == want, mode + ' SMP snippet differs from independent assembly'
+
+bad = subprocess.run([str(tc / 'llvm-bolt'), str(elf.with_name(elf.name.replace('.bolt', '.exe'))),
+                      '-o', str(out / 'bad.bolt'), '--instrument', '--instrument-calls=false',
+                      '--arm-instrumentation-contract=privileged-anything'], capture_output=True, text=True)
+assert bad.returncode != 0 and 'privileged-smp-no-fiq' in bad.stderr + bad.stdout, 'unknown contract accepted'
+print('PASS: SMP counter helper, ARM/Thumb call snippets, $a mapping, contract rejection')
--- /dev/null
+++ b/bolt/test/ARM/arm-counter-smp.test
@@ -0,0 +1,10 @@
+## SMP-safe counters: with --arm-instrumentation-contract=privileged-smp-no-fiq
+## every probe calls one injected A32 LDREXD/STREXD helper (T2b).
+RUN: llvm-mc -triple=armv7-none-eabi -arm-add-build-attributes -filetype=obj %p/Inputs/arm-counter-probes.s -o %t.o
+RUN: ld.lld --emit-relocs -T %p/Inputs/arm32.ld %t.o -o %t.exe
+RUN: llvm-mc -arm-add-build-attributes -triple=armv7-none-eabi -filetype=obj %p/Inputs/arm-counter-runtime.s -o %t.rt.o
+RUN: llvm-ar rcs %t.rt.a %t.rt.o
+RUN: llvm-bolt %t.exe -o %t.bolt --no-huge-pages -lite=0 --instrument --instrument-calls=false --arm-instrumentation-contract=privileged-smp-no-fiq \
+RUN:   --instrumentation-sleep-time=1 --runtime-instrumentation-lib=%t.rt.a \
+RUN:   --funcs=counter_arm,counter_thumb --emit-function-map=%t.map
+RUN: %python %p/Inputs/check-arm-counter-smp.py %t.bolt %t.map %t.check
