+// Generated AArch32 pointers use fixed virtual addresses. Do not infer this
+// contract from IsStaticExecutable: static PIE may set that flag as well.
+Error validateARMFixedLoadContract(const ELFObjectFileBase &File) {
+  auto fail = [](StringRef Reason) {
+    return createFatalBOLTError("AArch32 fixed-load contract: " + Reason);
+  };
+  if (File.getEType() != ELF::ET_EXEC)
+    return fail("requires ET_EXEC; PIE/shared/relocatable inputs are unsupported");
+  const auto &Obj = cast<ELF32LEObjectFile>(File).getELFFile();
+  auto Headers = Obj.program_headers();
+  if (!Headers)
+    return Headers.takeError();
+  bool HaveLoad = false;
+  for (const auto &Phdr : *Headers) {
+    if (Phdr.p_type == ELF::PT_INTERP || Phdr.p_type == ELF::PT_DYNAMIC ||
+        Phdr.p_type == ELF::PT_TLS)
+      return fail("INTERP, DYNAMIC and TLS segments are unsupported");
+    if (Phdr.p_type == ELF::PT_LOAD) {
+      HaveLoad = true;
+      const uint64_t Offset = Phdr.p_offset;
+      const uint64_t FileSize = Phdr.p_filesz;
+      if (FileSize > Phdr.p_memsz ||
+          Offset > File.getMemoryBufferRef().getBufferSize() ||
+          FileSize > File.getMemoryBufferRef().getBufferSize() - Offset ||
+          uint64_t(Phdr.p_vaddr) + Phdr.p_memsz > (uint64_t(1) << 32))
+        return fail("invalid LOAD segment extent");
+    }
+  }
+  if (!HaveLoad)
+    return fail("requires a LOAD segment at its declared virtual address");
+  for (const SectionRef &Sec : File.sections()) {
+    auto Name = Sec.getName();
+    if (!Name)
+      return Name.takeError();
+    const ELFSectionRef ELFSection(Sec);
+    const unsigned Type = ELFSection.getType();
+    const uint64_t Flags = ELFSection.getFlags();
+    // Zero-address sections are omitted from BOLT's section address map.
+    // Reject them before relocation analysis rather than treating code/data
+    // references as absolute or dereferencing an absent containing section.
+    if ((Flags & ELF::SHF_ALLOC) && Sec.getSize() && !Sec.getAddress())
+      return fail("nonempty loaded sections at address zero are unsupported");
+    if ((Flags & ELF::SHF_ALLOC) && Sec.getSize()) {
+      const uint64_t Address = Sec.getAddress();
+      const uint64_t Size = Sec.getSize();
+      const uint64_t Offset = ELFSection.getOffset();
+      const bool Covered = llvm::any_of(*Headers, [&](const auto &Phdr) {
+        if (Phdr.p_type != ELF::PT_LOAD || Address < Phdr.p_vaddr)
+          return false;
+        const uint64_t Delta = Address - Phdr.p_vaddr;
+        if (Delta > Phdr.p_memsz || Size > Phdr.p_memsz - Delta)
+          return false;
+        return Type == ELF::SHT_NOBITS ||
+               (Delta <= Phdr.p_filesz && Size <= Phdr.p_filesz - Delta &&
+                Offset == uint64_t(Phdr.p_offset) + Delta);
+      });
+      if (!Covered)
+        return fail("loaded section is not covered by a consistent LOAD mapping");
+    }
+    if (Type == ELF::SHT_DYNAMIC || Type == ELF::SHT_DYNSYM ||
+        (Flags & ELF::SHF_TLS) ||
+        ((Flags & ELF::SHF_ALLOC) &&
+         (Type == ELF::SHT_REL || Type == ELF::SHT_RELA ||
+          Type == ELF::SHT_RELR)) ||
+        *Name == ".dynamic" || *Name == ".dynsym" ||
+        *Name == ".rel.dyn" || *Name == ".rela.dyn" ||
+        *Name == ".rel.plt" || *Name == ".rela.plt" ||
+        *Name == ".relr.dyn" ||
+        ((Flags & ELF::SHF_ALLOC) &&
+         (*Name == ".got" || *Name == ".got.plt" || *Name == ".igot.plt" ||
+          *Name == ".plt" || *Name == ".iplt")))
+      return fail("dynamic linking, TLS, GOT/PLT or loaded relocation sections "
+                  "are unsupported");
+  }
+  return Error::success();
+}
