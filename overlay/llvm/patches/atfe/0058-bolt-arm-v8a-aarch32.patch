--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-arm-v8-aarch32.py
@@ -0,0 +1,108 @@
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+# ARMv8-A AArch32 input (Cortex-A55 build attributes, no FP/NEON): BOLT admits
+# it, decodes the v8 integer instructions (acquire/release, exclusive
+# acquire/release, sevl, dmb ishld) in A32 and T32, and re-emits each function
+# at a new address with the same instruction sequence.
+tc = Path(shutil.which('llvm-bolt')).resolve().parent
+evidence = Path(sys.argv[1])
+evidence.mkdir(parents=True, exist_ok=True)
+out = Path(tempfile.mkdtemp(prefix='run-', dir=evidence))
+print('Evidence:', out)
+
+V8 = ['lda r0, [r1]', 'stl r0, [r1]', 'ldab r2, [r1]', 'stlh r2, [r1]',
+      'ldaex r0, [r1]', 'stlex r2, r0, [r1]', 'sevl', 'dmb ishld']
+SRC = ''' .syntax unified
+ .text
+ .arm
+ .global _start
+ .type _start,%function
+_start:
+ bl v8_arm
+ blx v8_thumb
+ b _start
+ .size _start,.-_start
+
+ .p2align 2
+ .global v8_arm
+ .type v8_arm,%function
+v8_arm:
+''' + ''.join(f' {i}\n' for i in V8) + ''' cmp r0, #0
+ beq 1f
+ add r0, r0, #1
+1:
+ bx lr
+ .size v8_arm,.-v8_arm
+
+ .p2align 2
+ .thumb
+ .global v8_thumb
+ .type v8_thumb,%function
+ .thumb_func
+v8_thumb:
+''' + ''.join(f' {i}\n' for i in V8) + ''' cmp r0, #0
+ beq 1f
+ adds r0, r0, #1
+1:
+ bx lr
+ .size v8_thumb,.-v8_thumb
+'''
+LD = 'ENTRY(_start)\nSECTIONS {\n  . = 0x8000;\n  .text : { *(.text*) }\n}\n'
+
+
+def run(cmd, check=True):
+    p = subprocess.run([str(x) for x in cmd], cwd=out, capture_output=True, text=True)
+    if check and p.returncode:
+        sys.exit(f'FAIL: {Path(str(cmd[0])).name} exited {p.returncode}\n{p.stdout}{p.stderr}')
+    return p.returncode, p.stdout + p.stderr
+
+
+(out / 'v8.s').write_text(SRC)
+(out / 'in.ld').write_text(LD)
+run([tc / 'llvm-mc', '-triple=armv8.2a-none-eabi', '-mcpu=cortex-a55',
+     '-mattr=-neon,-fp-armv8,-fullfp16,-vfp2sp,-dotprod,-crypto',
+     '-arm-add-build-attributes', '-filetype=obj', 'v8.s', '-o', 'v8.o'])
+run([tc / 'ld.lld', '--emit-relocs', '-T', 'in.ld', 'v8.o', '-o', 'v8.exe'])
+_, attrs = run([tc / 'llvm-readelf', '-A', 'v8.exe'])
+assert 'ARM v8-A' in attrs and 'NEON' not in attrs and 'VFP' not in attrs, attrs
+
+
+def body(dis, name):
+    m = re.search(r'^([0-9a-f]+) <' + name + r'>:\n(.*?)(?:\n\n|\Z)', dis, re.S | re.M)
+    if not m:
+        return None, []
+    ops = []
+    for line in m.group(2).splitlines():
+        r = re.match(r'\s*[0-9a-f]+:\s+(\S+)\s*([^@<]*)', line)
+        if r:
+            ops.append((r.group(1) + ' ' + re.sub(r'\s+', ' ', r.group(2)).strip()).strip())
+    return int(m.group(1), 16), ops
+
+
+_, before = run([tc / 'llvm-objdump', '-d', '--no-show-raw-insn', 'v8.exe'])
+bad = 0
+for mode, extra in (('default', []), ('reverse', ['--reorder-blocks=reverse'])):
+    rc, log = run([tc / 'llvm-bolt', 'v8.exe', '-o', f'v8.{mode}.bolt', '-lite=0',
+                   '--funcs=v8_arm,v8_thumb', *extra], check=False)
+    (out / f'{mode}.log').write_text(log)
+    if rc:
+        print(f'FAIL: {mode}: llvm-bolt exited {rc}\n{log[-1500:]}')
+        bad += 1
+        continue
+    _, after = run([tc / 'llvm-objdump', '-d', '--no-show-raw-insn', f'v8.{mode}.bolt'])
+    for name in ('v8_arm', 'v8_thumb'):
+        old_addr, old_ops = body(before, name)
+        new_addr, new_ops = body(after, name)
+        v8_old = [o for o in old_ops if o.split()[0] in ('lda', 'stl', 'ldab', 'stlh', 'ldaex', 'stlex', 'sevl', 'dmb')]
+        v8_new = [o for o in new_ops if o.split()[0] in ('lda', 'stl', 'ldab', 'stlh', 'ldaex', 'stlex', 'sevl', 'dmb')]
+        ok = (new_addr is not None and new_addr >= 0x400000 and len(v8_old) == len(V8)
+              and v8_new == v8_old and not any('unknown' in o for o in new_ops))
+        print(f"{'PASS' if ok else 'FAIL'}: {mode}/{name}: moved to {new_addr and hex(new_addr)}, "
+              f'{len(v8_new)}/{len(V8)} v8 instructions preserved')
+        bad += not ok
+sys.exit(1 if bad else 0)
--- /dev/null
+++ b/bolt/test/ARM/arm-v8-aarch32.test
@@ -0,0 +1,5 @@
+## ARMv8-A AArch32 input (Cortex-A55 attributes, no FP/NEON): admitted, v8 integer
+## instructions decoded and preserved in A32 and T32 functions that BOLT moves.
+
+RUN: rm -rf %t.dir
+RUN: %python %p/Inputs/check-arm-v8-aarch32.py %t.dir
