+def sections(blob):
+    off=struct.unpack_from('<I',blob,32)[0]
+    size,count,names=struct.unpack_from('<HHH',blob,46)
+    headers=[struct.unpack_from('<10I',blob,off+i*size) for i in range(count)]
+    strings=blob[headers[names][4]:headers[names][4]+headers[names][5]]
+    return {strings[h[0]:strings.index(b'\0',h[0])].decode():h for h in headers}
+
+def at(blob,address,size):
+    matching=[h for h in sections(blob).values() if h[1]!=8 and h[2]&2 and h[3]<=address and address+size<=h[3]+h[5]]
+    assert len(matching)==1,(hex(address),size,len(matching))
+    h=matching[0];pos=h[4]+address-h[3]
+    return blob[pos:pos+size]
+
+def a32_target(blob,address):
+    word=struct.unpack('<I',at(blob,address,4))[0]
+    displacement=(word&0xffffff)<<2
+    if displacement&(1<<25):displacement-=1<<26
+    if word>>28==15:displacement+=((word>>24)&1)<<1
+    return address+8+displacement,word
+
+def mappings(path):
+    result={}
+    for line in path.read_text().splitlines():
+        p=line.split()
+        if len(p)==4 and not p[0].startswith('#'):
+            try:result[p[0]]=tuple(int(x,16) for x in p[1:])
+            except ValueError:pass
+    return result
