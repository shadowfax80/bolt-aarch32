+Error RewriteInstance::validateKeptARMCodeReferences() {
+  for (const SectionRef &RelSec : InputFile->sections()) {
+    Expected<section_iterator> Target = RelSec.getRelocatedSection();
+    if (!Target)
+      return Target.takeError();
+    if (*Target == InputFile->section_end() ||
+        (*Target)->getAddress() != BC->OldTextSectionAddress)
+      continue;
+    for (const RelocationRef &Rel : RelSec.relocations()) {
+      const uint32_t Type = Rel.getType();
+      if (Type != ELF::R_ARM_CALL && Type != ELF::R_ARM_JUMP24 &&
+          Type != ELF::R_ARM_PC24 && Type != ELF::R_ARM_PLT32)
+        continue;
+      const uint64_t P = Rel.getOffset();
+      const BinaryFunction *Src = BC->getBinaryFunctionContainingAddress(
+          P, /*CheckPastEnd=*/false, /*UseMaxSize=*/true);
+      if (!Src || !Src->isIgnored())
+        continue;
+      ErrorOr<uint64_t> Word = BC->getUnsignedValueAtAddress(P, 4);
+      const bool IsBLX = Word && (*Word & 0xfe000000u) == 0xfa000000u;
+      const bool IsBranch = Word && (*Word & 0x0e000000u) == 0x0a000000u &&
+                            (*Word >> 28) != 0xf;
+      if (Src->isARMThumb() || P % 4 ||
+          P < BC->OldTextSectionAddress ||
+          P + 4 > BC->OldTextSectionAddress + BC->OldTextSectionSize ||
+          (!IsBLX && !IsBranch) ||
+          (IsBLX && Type != ELF::R_ARM_CALL) ||
+          (Type == ELF::R_ARM_CALL && !IsBLX && !(*Word & 0x01000000u)))
+        return createFatalBOLTError(
+            "invalid kept A32 branch relocation at 0x" + Twine::utohexstr(P));
+      uint64_t Dest = P + 8 + SignExtend64<26>((*Word & 0x00ffffff) << 2);
+      if (IsBLX)
+        Dest += ((*Word >> 24) & 1) << 1;
+      const BinaryFunction *Dst = BC->getBinaryFunctionContainingAddress(Dest);
+      if (Dst && IsBLX != Dst->isARMThumb())
+        return createFatalBOLTError(
+            "kept A32 branch has incompatible target ISA at 0x" +
+            Twine::utohexstr(P));
+    }
+  }
+  return Error::success();
+}
