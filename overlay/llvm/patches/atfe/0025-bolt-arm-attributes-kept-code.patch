+void RewriteInstance::patchKeptARMCodeReferences(raw_fd_ostream &OS) {
+  // pwrite validates against the stream position, not the existing file size.
+  // Pending relocation writes may have left that position below kept code.
+  const uint64_t SavedPos = OS.tell();
+  OS.seek(std::max(SavedPos, FirstNonAllocatableOffset));
+  uint64_t NumPatched = 0;
+  for (const SectionRef &RelSec : InputFile->sections()) {
+    Expected<section_iterator> Target = RelSec.getRelocatedSection();
+    if (!Target) {
+      consumeError(Target.takeError());
+      continue;
+    }
+    if (*Target == InputFile->section_end())
+      continue;
+    const uint64_t SecAddr = (*Target)->getAddress();
+    if (BC->OldTextSectionAddress < SecAddr ||
+        BC->OldTextSectionAddress >= SecAddr + (*Target)->getSize())
+      continue;
+    for (const RelocationRef &Rel : RelSec.relocations()) {
+      const uint32_t Type = Rel.getType();
+      if (Type != ELF::R_ARM_CALL && Type != ELF::R_ARM_JUMP24 &&
+          Type != ELF::R_ARM_PC24 && Type != ELF::R_ARM_PLT32)
+        continue;
+      const uint64_t P = Rel.getOffset();
+      const BinaryFunction *Src = BC->getBinaryFunctionContainingAddress(
+          P, /*CheckPastEnd=*/false, /*UseMaxSize=*/true);
+      if (!Src || !Src->isIgnored())
+        continue;
+      ErrorOr<uint64_t> Word = BC->getUnsignedValueAtAddress(P, 4);
+      if (!Word)
+        continue;
+      const bool IsBLX = (*Word & 0xfe000000u) == 0xfa000000u;
+      uint64_t Dest = P + 8 + SignExtend64<26>((*Word & 0x00ffffff) << 2);
+      if (IsBLX)
+        Dest += ((*Word >> 24) & 1) << 1;
+      const BinaryFunction *Dst = BC->getBinaryFunctionContainingAddress(Dest);
+      if (!Dst || Dst->isIgnored() || !Dst->getOutputAddress())
+        continue;
+      uint64_t NewDest = Dest == Dst->getAddress()
+                             ? Dst->getOutputAddress()
+                             : Dst->translateInputToOutputAddress(Dest);
+      if (!NewDest) {
+        BC->errs() << "BOLT-ERROR: cannot redirect the reference at 0x"
+                   << Twine::utohexstr(P) << " in kept function " << *Src
+                   << " into " << *Dst << "\n";
+        Out.reset();
+        exit(1);
+      }
+      const int64_t Offset = int64_t(NewDest) - int64_t(P + 8);
+      if (NewDest > UINT32_MAX || !isInt<26>(Offset) ||
+          (Offset & (IsBLX ? 1 : 3)) || IsBLX != Dst->isARMThumb()) {
+        BC->errs() << "BOLT-ERROR: kept branch at 0x" << Twine::utohexstr(P)
+                   << " cannot reach " << *Dst << " at its new address\n";
+        Out.reset();
+        exit(1);
+      }
+      uint32_t NewWord;
+      if (IsBLX)
+        NewWord = 0xfa000000u | ((uint32_t(Offset >> 1) & 1u) << 24) |
+                  (uint32_t(Offset >> 2) & 0x00ffffffu);
+      else
+        NewWord = (uint32_t(*Word) & 0xff000000u) |
+                  (uint32_t(Offset >> 2) & 0x00ffffffu);
+      const uint64_t FileOffset =
+          BC->OldTextSectionOffset + P - BC->OldTextSectionAddress;
+      if (FileOffset + 4 > FirstNonAllocatableOffset) {
+        BC->errs() << "BOLT-ERROR: kept branch write is outside input text\n";
+        Out.reset();
+        exit(1);
+      }
+      char Bytes[4];
+      support::endian::write32le(Bytes, NewWord);
+      OS.pwrite(Bytes, sizeof(Bytes), FileOffset);
+      ++NumPatched;
+    }
+  }
+  OS.seek(SavedPos);
+  if (NumPatched)
+    BC->outs() << "BOLT-INFO: redirected " << NumPatched
+               << " branch(es) in kept (ignored) code to moved functions\n";
+}
