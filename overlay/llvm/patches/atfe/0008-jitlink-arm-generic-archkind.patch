+/// LDR (literal) T2 (32-bit): Hi = 1111100:U:101 1111, Lo = Rt(4):imm12(12).
+/// Byte-granular (not word-scaled like T1) with an explicit sign (U) bit:
+/// U=1 adds imm12 to the PC-aligned base, U=0 subtracts it. The U bit lives
+/// in Hi but is excluded from OpcodeMask (its value is data, not opcode) and
+/// included in ImmMask so writeImmediate() updates it.
+struct FixupInfoThumbLdrPcRel : public FixupInfoThumb {
+  static constexpr HalfWords OpcodeMask{0xff7f, 0x0000};
+  static constexpr HalfWords ImmMask{0x0080, 0x0fff};
+  static constexpr HalfWords RegMask{0x0000, 0xf000};
+};
+
+template <> struct FixupInfo<Thumb_LdrPcRel> : public FixupInfoThumbLdrPcRel {
+  static constexpr HalfWords Opcode{0xf85f, 0x0000};
+};
