+/// Encode signed byte offset [-4095, 4095] as U-bit + imm12 for the
+/// Thumb32 LDR (literal) T2 instruction format.
+HalfWords encodeImmLdrLiteralT2(int64_t Value) {
+  assert(Value >= -4095 && Value <= 4095 &&
+         "LDR (literal) T2 offset out of representable range");
+  bool U = Value >= 0;
+  uint32_t Imm12 = static_cast<uint32_t>(U ? Value : -Value);
+  return HalfWords{U ? 0x0080u : 0x0000u, Imm12};
+}
+
+/// Decode U-bit + imm12 from the Thumb32 LDR (literal) T2 instruction format
+/// back into a signed byte offset.
+int64_t decodeImmLdrLiteralT2(uint32_t Hi, uint32_t Lo) {
+  bool U = (Hi & 0x0080) != 0;
+  uint32_t Imm12 = Lo & 0x0fff;
+  return U ? static_cast<int64_t>(Imm12) : -static_cast<int64_t>(Imm12);
+}
