diff --git a/bolt/test/ARM/Inputs/check-arm-admission-report.py b/bolt/test/ARM/Inputs/check-arm-admission-report.py
new file mode 100644
index 0000000..94f6f6b
--- /dev/null
+++ b/bolt/test/ARM/Inputs/check-arm-admission-report.py
@@ -0,0 +1,81 @@
+from pathlib import Path
+import hashlib,json,subprocess,sys,tempfile
+parent=Path(sys.argv[1]);parent.mkdir(parents=True,exist_ok=True)
+out=Path(tempfile.mkdtemp(prefix='admission-',dir=parent));checks=[]
+def run(label,cmd):
+    p=subprocess.run(list(map(str,cmd)),capture_output=True,text=True,timeout=30)
+    (out/(label+'.log')).write_text(p.stdout+p.stderr)
+    return p
+def require(ok,label):
+    checks.append(dict(check=label,passed=bool(ok)))
+    if not ok:raise RuntimeError(label+' failed; see '+str(out))
+asm='''.syntax unified
+.arch armv7-a
+.text
+.arm
+.global _start,entry_alias
+.type _start,%function
+.type entry_alias,%function
+_start:
+entry_alias:
+push {r4,lr}
+bl good_arm
+bl good_thumb
+pop {r4,pc}
+.size _start,.-_start
+.size entry_alias,.-entry_alias
+'''
+bodies=[('arm','good_arm','mov r0,#7\nbx lr'),
+        ('arm','bad_read_arm','mov r0,pc\nbx lr'),
+        ('arm','bad_write_arm','mov pc,r0'),
+        ('arm','bad_fall_arm','mov r0,#1'),
+        ('thumb','good_thumb','movs r0,#7\nbx lr'),
+        ('thumb','bad_read_thumb','mov r0,pc\nbx lr'),
+        ('thumb','bad_write_thumb','mov pc,r0'),
+        ('thumb','bad_fall_thumb','movw r0,#1'),
+        ('thumb','bad_truncated_it','.hword 0xbf04\n.hword 0x2001'),
+        ('thumb','bad_entry_it','b.n .Linside\nit eq\n.Linside: moveq r0,#1\nbx lr'),
+        ('arm','last_good','bx lr')]
+for isa,name,body in bodies:
+    asm+=f'.balign 4\n.{isa}\n.global {name}\n.type {name},%function\n'+('.thumb_func\n' if isa=='thumb' else '')+f'{name}:\n{body}\n.size {name},.-{name}\n'
+(out/'input.s').write_text(asm)
+(out/'layout.ld').write_text('ENTRY(_start)\nSECTIONS { . = 0x8000; .text : { *(.text*) } }\n')
+for label,cmd in [('mc',['llvm-mc','-triple=armv7-none-eabi','-arm-add-build-attributes','-filetype=obj',out/'input.s','-o',out/'input.o']),('link',['ld.lld','--emit-relocs','-T',out/'layout.ld',out/'input.o','-o',out/'input.elf'])]:
+    require(run(label,cmd).returncode==0,label)
+elf=out/'input.elf';original=elf.read_bytes();digest=hashlib.sha256(original).hexdigest()
+bad={name for _,name,_ in bodies if name.startswith('bad_')};admissions=[]
+for label,opts in [('normal',[]),('reverse',['--reorder-blocks=reverse']),('old-text',['--use-old-text'])]:
+    report=out/(label+'.json');mapping=out/(label+'.map');mapping.write_bytes(b'old map')
+    p=run(label,['llvm-bolt',elf,'-o','/dev/null','--no-huge-pages','-lite=0','--arm-admission-report='+str(report),'--emit-function-map='+str(mapping),*opts])
+    require(p.returncode==0 and report.exists(),label+'-report')
+    r=json.loads(report.read_text());rows=r['functions']
+    require(r['kind']=='aarch32-admission-diagnostic' and r['complete'] is True and r['execution_verified'] is False and r['input_sha256']==digest,label+'-identity')
+    require({row['name'] for row in rows if row['status']=='rejected'}==bad,label+'-all-rejections')
+    require(r['rejected']==len(bad) and r['admitted']==4 and r['not_analyzed']==0,label+'-totals')
+    require(len({row['address'] for row in rows})==len(rows) and all('(*' not in row['name'] for row in rows),label+'-alias-identity')
+    require(mapping.read_bytes()==b'old map' and elf.read_bytes()==original,label+'-no-outputs')
+    require(not list(out.glob(label+'.json.tmp-*')),label+'-atomic-publish');admissions.append(rows)
+require(admissions[0]==admissions[1]==admissions[2],'deterministic-options')
+for name in sorted(bad):
+    candidate=out/(name+'.elf');mapping=out/(name+'.map');candidate.write_bytes(b'old elf');mapping.write_bytes(b'old map')
+    p=run(name,['llvm-bolt',elf,'-o',candidate,'--funcs='+name,'--emit-function-map='+str(mapping)])
+    require(p.returncode==1 and candidate.read_bytes()==b'old elf' and mapping.read_bytes()==b'old map',name+'-fatal-default')
+candidate=out/'explicit.elf';mapping=out/'explicit.map'
+p=run('explicit',['llvm-bolt',elf,'-o',candidate,'--no-huge-pages','-lite=0','--skip-funcs='+','.join(sorted(bad)),'--emit-function-map='+str(mapping)])
+require(p.returncode==0 and candidate.exists() and mapping.exists(),'explicit-strict-output')
+require(not any(row.split()[0] in bad for row in mapping.read_text().splitlines()),'excluded-not-emitted')
+for label,extra in [('output',['-o',out/'refused.elf']),('instrument',['--instrument']),('aggregate',['--aggregate-only'])]:
+    report=out/(label+'-existing.json');report.write_bytes(b'old report')
+    p=run(label,['llvm-bolt',elf,'-o','/dev/null','--arm-admission-report='+str(report),*extra])
+    require(p.returncode!=0 and report.read_bytes()==b'old report' and not (out/'refused.elf').exists(),label+'-boundary')
+for label,offset,data in [('pie',16,(3).to_bytes(2,'little')),('abi',36,bytes(4))]:
+    mutated=bytearray(original);mutated[offset:offset+len(data)]=data;image=out/(label+'.elf');image.write_bytes(mutated)
+    report=out/(label+'.json');report.write_bytes(b'old report')
+    p=run(label,['llvm-bolt',image,'-o','/dev/null','--arm-admission-report='+str(report)])
+    require(p.returncode!=0 and report.read_bytes()==b'old report',label+'-global-fatal')
+p=run('replace-input',['llvm-bolt',elf,'-o','/dev/null','--arm-admission-report='+str(elf)])
+require(p.returncode!=0 and elf.read_bytes()==original,'cannot-replace-input')
+p=run('bad-directory',['llvm-bolt',elf,'-o','/dev/null','--arm-admission-report='+str(out/'missing/report.json')])
+require(p.returncode!=0 and not (out/'missing').exists(),'failed-publication')
+(out/'results.json').write_text(json.dumps(checks,indent=2)+'\n')
+print('Admission report:',len(checks),'checks;',len(bad),'local rejections per scan;',out)
