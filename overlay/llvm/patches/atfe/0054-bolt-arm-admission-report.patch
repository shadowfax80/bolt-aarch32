+bool RewriteInstance::recordARMAdmissionError(BinaryFunction &BF,
+                                                const BOLTError &E,
+                                                StringRef Stage) {
+  if (opts::ARMAdmissionReport.empty() || !BC->isARM())
+    return false;
+  // Only explicit local target-admission boundaries are recoverable. Generic
+  // CFG consistency errors, unknown failures and global guards stay fatal.
+  const StringRef Message = E.getMessage();
+  const StringRef Prefixes[] = {
+      "unsupported AArch32 PC-writing control transfer in ",
+      "unsupported AArch32 position-dependent PC read in ",
+      "data inside Thumb IT group in ", "nested Thumb IT group in ",
+      "invalid Thumb IT group in ", "truncated Thumb IT group in ",
+      "branch into Thumb IT body in ",
+      "unsupported control transfer in Thumb IT group in ",
+      "unmodeled AArch32 function fallthrough in "};
+  if (!llvm::any_of(Prefixes, [&](StringRef P) { return Message.starts_with(P); }))
+    return false;
+  ARMAdmissionRejections.emplace(
+      BF.getAddress(), ARMAdmissionRejection{Stage.str(), Message.str()});
+  BC->errs() << "BOLT-WARNING: diagnostic admission rejection: " << Message
+             << "\n";
+  BF.setIgnored();
+  BF.clearDisasmState();
+  return true;
+}
+
+Error RewriteInstance::writeARMAdmissionReport() {
+  json::Array Functions;
+  unsigned Rejected = 0, Admitted = 0, NotAnalyzed = 0;
+  for (const auto &Entry : BC->getBinaryFunctions()) {
+    const BinaryFunction &BF = Entry.second;
+    if (BF.isPseudo())
+      continue;
+    json::Object Row{{"name", BF.getOneName().str()},
+                     {"address", static_cast<int64_t>(BF.getAddress())},
+                     {"size", static_cast<int64_t>(BF.getSize())},
+                     {"isa", BF.isARMThumb() ? "T32" : "A32"}};
+    auto It = ARMAdmissionRejections.find(BF.getAddress());
+    if (It != ARMAdmissionRejections.end()) {
+      Row["status"] = "rejected";
+      Row["stage"] = It->second.Stage;
+      Row["reason"] = It->second.Reason;
+      ++Rejected;
+    } else if (BF.hasCFG() && BF.isSimple() && !BF.isIgnored()) {
+      Row["status"] = "admitted";
+      ++Admitted;
+    } else {
+      Row["status"] = "not-analyzed";
+      ++NotAnalyzed;
+    }
+    Functions.push_back(std::move(Row));
+  }
+  StringRef Input = InputFile->getData();
+  const auto Hash = SHA256::hash(ArrayRef<uint8_t>(
+      reinterpret_cast<const uint8_t *>(Input.data()), Input.size()));
+  json::Object Report{
+      {"schema", 1}, {"kind", "aarch32-admission-diagnostic"},
+      {"complete", true}, {"execution_verified", false},
+      {"scope", "local disassembly/CFG admission only; not emission, passes, "
+                "reference correctness, instrumentation or execution proof"},
+      {"input_sha256", toHex(Hash, true)},
+      {"admitted", Admitted}, {"rejected", Rejected},
+      {"not_analyzed", NotAnalyzed}, {"functions", std::move(Functions)}};
+  // Preserve an existing report on any failed scan or write, and publish only
+  // a complete result through a sibling temporary file.
+  SmallString<256> Temp;
+  int FD;
+  if (std::error_code EC = sys::fs::createUniqueFile(
+          opts::ARMAdmissionReport + ".tmp-%%%%%%", FD, Temp))
+    return createStringError(EC, "cannot create AArch32 admission report");
+  raw_fd_ostream OS(FD, true);
+  OS << formatv("{0:2}", json::Value(std::move(Report))) << '\n';
+  OS.close();
+  if (OS.has_error()) {
+    std::error_code EC = OS.error();
+    OS.clear_error();
+    sys::fs::remove(Temp);
+    return createStringError(EC, "cannot write AArch32 admission report");
+  }
+  if (std::error_code EC = sys::fs::rename(Temp, opts::ARMAdmissionReport)) {
+    sys::fs::remove(Temp);
+    return createStringError(EC, "cannot publish AArch32 admission report");
+  }
+  BC->outs() << "BOLT-INFO: diagnostic admission report: " << Admitted
+             << " admitted, " << Rejected << " rejected, " << NotAnalyzed
+             << " not analyzed; no output ELF\n";
+  return Error::success();
+}
