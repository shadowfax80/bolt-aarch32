+#ifndef BOLT_TARGET_ARM_ARMMCSYMBOLIZER_H
+#define BOLT_TARGET_ARM_ARMMCSYMBOLIZER_H
+
+#include "bolt/Core/BinaryFunction.h"
+#include "llvm/MC/MCDisassembler/MCSymbolizer.h"
+#include <optional>
+
+namespace llvm {
+namespace bolt {
+
+class ARMMCSymbolizer : public MCSymbolizer {
+protected:
+  BinaryFunction &Function;
+  bool CreateNewSymbols{true};
+
+  std::optional<Relocation> adjustRelocation(const Relocation &Rel,
+                                             const MCInst &Inst) const;
+
+public:
+  ARMMCSymbolizer(BinaryFunction &Function, bool CreateNewSymbols = true)
+      : MCSymbolizer(*Function.getBinaryContext().Ctx, nullptr),
+        Function(Function), CreateNewSymbols(CreateNewSymbols) {}
+
+  ARMMCSymbolizer(const ARMMCSymbolizer &) = delete;
+  ARMMCSymbolizer &operator=(const ARMMCSymbolizer &) = delete;
+  virtual ~ARMMCSymbolizer();
+
+  bool tryAddingSymbolicOperand(MCInst &Inst, raw_ostream &CStream,
+                                int64_t Value, uint64_t Address, bool IsBranch,
+                                uint64_t Offset, uint64_t OpSize,
+                                uint64_t InstSize) override;
+
+  void tryAddingPcLoadReferenceComment(raw_ostream &CStream, int64_t Value,
+                                       uint64_t Address) override;
+};
+
+} // namespace bolt
+} // namespace llvm
+
+#endif
