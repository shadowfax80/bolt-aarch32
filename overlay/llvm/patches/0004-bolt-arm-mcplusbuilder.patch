index 000000000000..e7bda301bad8
--- /dev/null
+++ b/bolt/lib/Target/ARM/CMakeLists.txt
@@ -0,0 +1,35 @@
+set(LLVM_LINK_COMPONENTS
+  MC
+  MCDisassembler
+  Support
+  ARMDesc
+  )
