+
+#include "ARMMCSymbolizer.h"
+#include "MCTargetDesc/ARMMCTargetDesc.h"
+#include "bolt/Core/BinaryContext.h"
+#include "bolt/Core/BinaryFunction.h"
+#include "bolt/Core/MCPlusBuilder.h"
+#include "bolt/Core/Relocation.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/Support/Debug.h"
+
+#define DEBUG_TYPE "bolt-symbolizer"
+
+namespace llvm {
+namespace bolt {
+
+ARMMCSymbolizer::~ARMMCSymbolizer() {}
+
+bool ARMMCSymbolizer::tryAddingSymbolicOperand(
+    MCInst &Inst, raw_ostream &CStream, int64_t Value, uint64_t InstAddress,
+    bool IsBranch, uint64_t ImmOffset, uint64_t ImmSize, uint64_t InstSize) {
+  BinaryContext &BC = Function.getBinaryContext();
+  MCContext *Ctx = BC.Ctx.get();
+
+  const uint64_t InstOffset = InstAddress - Function.getAddress();
+  const Relocation *Relocation = Function.getRelocationAt(InstOffset);
+
+  // Linker veneers rewrite the BL immediate to a nearby thunk while keeping
+  // R_ARM_CALL/JUMP against the real callee. Replace the encoded immediate
+  // (do not append) so getTargetSymbol() sees the real callee.
+  if (BC.MIB->isBranch(Inst) || BC.MIB->isCall(Inst)) {
+    if (Relocation && Relocation->Symbol) {
+      const MCExpr *Expr =
+          MCSymbolRefExpr::create(Relocation->Symbol, *Ctx);
+      if (Relocation->Addend)
+        Expr = MCBinaryExpr::createAdd(
+            Expr, MCConstantExpr::create(Relocation->Addend, *Ctx), *Ctx);
+      const MCOperand SymOp = MCOperand::createExpr(
+          BC.MIB->getTargetExprFor(Inst, Expr, *Ctx, Relocation->Type));
+      unsigned OpNum = 0;
+      switch (Inst.getOpcode()) {
+      case ARM::Bcc:
+        OpNum = 2;
+        break;
+      case ARM::tB:
+      case ARM::tBcc:
+      case ARM::t2B:
+      case ARM::t2Bcc:
+        OpNum = 0;
+        break;
+      case ARM::tBL:
+      case ARM::tBLXi:
+      case ARM::tBLXr:
+        // pred expands to (CC, CCR); target/Rm is operand 2.
+        OpNum = 2;
+        break;
+      case ARM::tCBZ:
+      case ARM::tCBNZ:
+        OpNum = 1;
+        break;
+      default:
+        OpNum = 0;
+        break;
+      }
+      if (Inst.getNumOperands() > OpNum)
+        Inst.getOperand(OpNum) = SymOp;
+      else
+        Inst.addOperand(SymOp);
+      return true;
+    }
+    return false;
+  }
+
+  auto addOperand = [&](const MCSymbol *Symbol, uint64_t Addend,
+                        uint64_t RelType) {
+    const MCExpr *Expr = MCSymbolRefExpr::create(Symbol, *Ctx);
+    if (Addend)
+      Expr = MCBinaryExpr::createAdd(Expr, MCConstantExpr::create(Addend, *Ctx),
+                                     *Ctx);
+    Inst.addOperand(MCOperand::createExpr(
+        BC.MIB->getTargetExprFor(Inst, Expr, *Ctx, RelType)));
+  };
+
+  if (Relocation) {
+    auto AdjustedRel = adjustRelocation(*Relocation, Inst);
+    if (AdjustedRel) {
+      addOperand(AdjustedRel->Symbol, AdjustedRel->Addend, AdjustedRel->Type);
+      return true;
+    }
+
+    LLVM_DEBUG(dbgs() << "BOLT-DEBUG: ignoring relocation at 0x"
+                      << Twine::utohexstr(InstAddress) << '\n');
+  }
+
+  if (!BC.MIB->hasPCRelOperand(Inst))
+    return false;
+
+  Value += InstAddress;
+  const MCSymbol *TargetSymbol;
+  uint64_t TargetOffset;
+  if (!CreateNewSymbols) {
+    if (BinaryData *BD = BC.getBinaryDataContainingAddress(Value & ~1ULL)) {
+      TargetSymbol = BD->getSymbol();
+      TargetOffset = (Value & ~1ULL) - BD->getAddress();
+    } else {
+      return false;
+    }
+  } else {
+    std::tie(TargetSymbol, TargetOffset) =
+        BC.handleAddressRef(Value & ~1ULL, Function, /*IsPCRel*/ true);
+  }
+
+  addOperand(TargetSymbol, TargetOffset, 0);
+  return true;
+}
+
+std::optional<Relocation>
+ARMMCSymbolizer::adjustRelocation(const Relocation &Rel,
+                                  const MCInst &Inst) const {
+  (void)Inst;
+  return Rel;
+}
+
+void ARMMCSymbolizer::tryAddingPcLoadReferenceComment(raw_ostream &CStream,
+                                                      int64_t Value,
+                                                      uint64_t Address) {}
+
+} // namespace bolt
+} // namespace llvm
